sub garagentor_pos_event {
  my $DEV = "Garagentor_gross";
  my $P   = "Garagentor_Position";
  my $s   = ReadingsVal($DEV,"state","");
  my $now = time();
  my $min = 3;
  my $max = 60;
  if($s eq "wird_geoeffnet") {
    fhem("setreading $P fahrt_start $now");
    fhem("setreading $P richtung auf");
    garagentor_pos_tick();
  }
  elsif($s eq "wird_geschlossen") {
    fhem("setreading $P fahrt_start $now");
    fhem("setreading $P richtung zu");
    garagentor_pos_tick();
  }
  elsif($s eq "geoeffnet") {
    RemoveInternalTimer("grg_pos_tick");
    my $r  = ReadingsVal($P,"richtung","");
    my $st = ReadingsNum($P,"fahrt_start",0);
    if($r eq "auf" and $st > 0) {
      my $d = $now - $st;
      if($d >= $min and $d <= $max) {
        my $a = ReadingsNum($P,"zeit_auf",$d);
        $a = ($a <= 0) ? $d : ($a*0.7 + $d*0.3);
        fhem("setreading $P zeit_auf ".sprintf("%.1f",$a));
        fhem("setreading $P letzte_auf ".sprintf("%.1f",$d));
      }
    }
    fhem("setreading $P prozent 100");
    fhem("setreading $P richtung -");
  }
  elsif($s eq "geschlossen") {
    RemoveInternalTimer("grg_pos_tick");
    my $r  = ReadingsVal($P,"richtung","");
    my $st = ReadingsNum($P,"fahrt_start",0);
    if($r eq "zu" and $st > 0) {
      my $d = $now - $st;
      if($d >= $min and $d <= $max) {
        my $a = ReadingsNum($P,"zeit_zu",$d);
        $a = ($a <= 0) ? $d : ($a*0.7 + $d*0.3);
        fhem("setreading $P zeit_zu ".sprintf("%.1f",$a));
        fhem("setreading $P letzte_zu ".sprintf("%.1f",$d));
      }
    }
    fhem("setreading $P prozent 0");
    fhem("setreading $P richtung -");
  }
  else {
    RemoveInternalTimer("grg_pos_tick");
    fhem("setreading $P richtung -");
  }
}
sub garagentor_pos_tick {
my $P = "Garagentor_Position";
my $r = ReadingsVal($P,"richtung","");
return if($r ne "auf" and $r ne "zu");
my $st = ReadingsNum($P,"fahrt_start",0);
return if($st <= 0);
my $el  = time() - $st;
my $def = 20;
if($r eq "auf") {
my $a = ReadingsNum($P,"zeit_auf",$def);
$a = $def if($a <= 0);
my $p = int($el/$a*100 + 0.5);
$p = 1  if($p < 1);
$p = 99 if($p > 99);
fhem("setreading $P prozent $p");
}
else {
my $a = ReadingsNum($P,"zeit_zu",$def);
$a = $def if($a <= 0);
my $p = 100 - int($el/$a*100 + 0.5);
$p = 1  if($p < 1);
$p = 99 if($p > 99);
fhem("setreading $P prozent $p");
}
InternalTimer(gettimeofday()+1,"garagentor_pos_tick","grg_pos_tick");
}

sub BackupCheck {
  my $dir = "/opt/fhem-backup";
  my $last = 0;
  for my $f (glob("$dir/FHEM-*.tar.gz")) {
    my $m = (stat($f))[9] // 0;
    $last = $m if $m > $last;
  }
  my $changed = 0;
  for my $f ("/opt/fhem/fhem.cfg",
             glob("/opt/fhem/FHEM/*.pm")) {
    my $m = (stat($f))[9] // 0;
    $changed = 1 if $m > $last;
  }
  my $old = (time() - $last) > 7*86400;

  system("cp /opt/fhem/fhem.cfg /opt/fhem-cfg-history/ && "
    . "cd /opt/fhem-cfg-history && "
    . "git add fhem.cfg && "
    . "git diff --cached --quiet fhem.cfg || "
    . "git commit -q -m 'Auto-Save " . localtime() . "'");

  if ($changed || $old) {
    system("mkdir -p /opt/fhem/restore-info && "
      . "cp /etc/fstab "
      . "/usr/local/bin/fhem-backup-sync.sh "
      . "/usr/local/bin/fhem-backup-notify.sh "
      . "/opt/fhem/restore-info/ 2>/dev/null");
    main::Log(1, "BackupCheck: Backup gestartet"
      . ($changed ? " (Aenderung)" : " (7 Tage)"));
    my $ts = strftime("%Y%m%d_%H%M%S", localtime());
    system("nohup nice -n 10 tar czf /opt/fhem-backup/FHEM-$ts.tar.gz -C /opt/fhem --exclude=./log/*.log --exclude=./log/*.gz --exclude=./opt --exclude=./demolog . >/dev/null 2>&1 &");
  } else {
    main::Log(1, "BackupCheck: keine Aenderung");
  }
}

sub AktienUniversumNamen {
  my $list = ReadingsVal("Aktien_Universum",
    "universe_list","");
  return if ($list eq "");
  foreach my $isin (split /,/, $list) {
    $isin =~ s/\s+//g;
    next if ($isin eq "");
    next if (ReadingsVal("Aktien_Universum",
      "n_$isin","") ne "");
    next if (ReadingsVal("Aktie_$isin",
      "name","") ne "");
    my $url = "https://www.tradegatebsx.com/"
      . "orderbuch.php?isin=$isin";
    HttpUtils_NonblockingGet({
      url      => $url,
      timeout  => 15,
      isin     => $isin,
      header   => "User-Agent: Mozilla/5.0"
        . " (X11; Linux x86_64)",
      callback => \&AktienUniName_Callback
    });
  }
}

sub AktienUniName_Callback {
  my ($param, $err, $data) = @_;
  my $isin = $param->{isin};
  return if ($err ne "");
  my ($name) = $data =~ /<h2>([^<]+)<\/h2>/;
  return if (!$name);
  readingsSingleUpdate(
    $defs{"Aktien_Universum"},
    "n_$isin", $name, 1);
}



sub AktienStateIcon {
  my ($name) = @_;
  my $s = ReadingsVal($name,
    "signal","neutral");
  my %m = (
    "verkauf" => "rc_GREEN\@lightgreen",
    "kauf"    => "rc_GREEN\@green",
    "neutral" => "rc_STOP\@grey"
  );
return "<div>"
    . FW_makeImage($m{$s}
      // "rc_STOP\@grey", $s, "icon")
    . " " . InternalVal($name,"STATE","")
    . "</div>";
}


sub AktienSignalCheck {
  my ($dev) = @_;
  return if (!defined $defs{$dev});
  my $last = ReadingsVal($dev,"last",0);
  my $kauf = ReadingsVal($dev,
    "kaufschwelle",0);
  my $verk = ReadingsVal($dev,
    "verkaufsschwelle",0);
  return if ($last <= 0 || $kauf <= 0);
  my $name = ReadingsVal($dev,"name",$dev);
  my $today = POSIX::strftime("%Y-%m-%d",
    localtime(time()));
  my $neu = "neutral";
  $neu = "kauf" if ($last < $kauf);
  $neu = "verkauf"
    if ($verk > 0 && $last > $verk);
  my $alt = ReadingsVal($dev,
    "signal","neutral");
  return if ($neu eq $alt);
  readingsSingleUpdate($defs{$dev},
    "signal", $neu, 1);
  return if ($neu eq "neutral");
  my $rd = "signal_${neu}_datum";
  return if (ReadingsVal($dev,$rd,"")
    eq $today);
  my $sig = sprintf("%s-Signal %s: %.3f"
    . " (Kauf %.3f / Verkauf %.3f)",
    uc($neu), $name, $last, $kauf, $verk);
  readingsSingleUpdate($defs{$dev},
    $rd, $today, 1);
  readingsSingleUpdate($defs{$dev},
    "signal_letztes", $sig, 1);
  Log 2, "AktienSignal: $sig";
}


sub AktienVolaCalc {
  my $year = POSIX::strftime("%Y",
    localtime(time()));
  my $file = "/opt/fhem/log/"
    . "aktieneod-$year.log";
  my %hist;
  if (open(my $fh, "<", $file)) {
    while (my $z = <$fh>) {
      if ($z =~ /^(\S+)\s+Aktie_(\S+)\s+eod:
        \s+\S+\s+\S+\s+\S+\s+(\S+)/x) {
        push @{$hist{$2}}, $3;
      }
    }
    close $fh;
  } else {
    Log 3, "AktienVola: $file fehlt";
    return;
  }
  foreach my $isin (keys %hist) {
    my $dev = "Aktie_$isin";
    next if (!defined $defs{$dev});
    my @c = @{$hist{$isin}};
    @c = @c[-63..-1] if (@c > 63);
    next if (@c < 6);
    my @r;
    for (my $i = 1; $i < @c; $i++) {
      next if ($c[$i-1] <= 0 || $c[$i] <= 0);
      push @r, log($c[$i]/$c[$i-1]);
    }
    next if (@r < 5);
    my $m = 0;
    $m += $_ for @r;
    $m /= @r;
    my $s = 0;
    $s += ($_-$m)**2 for @r;
    my $vola = sqrt($s/(@r-1));
    my @s20 = @c > 20 ? @c[-20..-1] : @c;
    my $sma = 0;
    $sma += $_ for @s20;
    $sma /= @s20;
    my $k = ReadingsVal($dev,"vola_k",1.0);
    my $kauf = $sma*(1 - $k*$vola);
    my $spr = ReadingsVal($dev,
      "spread_pct",0.1)/100;
    my $geb = 0.002;
    my $marge = ReadingsVal($dev,
      "zielmarge_pct",0.5)/100;
    my $verk = $kauf*(1+$spr+2*$geb+$marge);
    readingsBeginUpdate($defs{$dev});
    readingsBulkUpdate($defs{$dev},
      "vola_tag_pct",
      sprintf("%.3f",100*$vola));
    readingsBulkUpdate($defs{$dev},
      "sma20", sprintf("%.3f",$sma));
    readingsBulkUpdate($defs{$dev},
      "kaufschwelle",
      sprintf("%.3f",$kauf));
    readingsBulkUpdate($defs{$dev},
      "verkaufsschwelle",
      sprintf("%.3f",$verk));
    readingsBulkUpdate($defs{$dev},
      "vola_basis_tage", scalar @c);
    readingsEndUpdate($defs{$dev}, 1);
  }
}
sub AktienTagesabschluss {
  my $list = ReadingsVal("Aktien_Config",
    "isin_list","");
  return if ($list eq "");
  foreach my $isin (split /,/, $list) {
    $isin =~ s/\s+//g;
    my $dev = "Aktie_$isin";
    next if (!defined $defs{$dev});
    my $o = ReadingsVal($dev,"day_open",0);
    my $h = ReadingsVal($dev,"high",0);
    my $l = ReadingsVal($dev,"low",0);
    my $c = ReadingsVal($dev,"last",0);
    next if ($c == 0);
    my $eod = sprintf("%.3f %.3f %.3f %.3f",
      $o, $h, $l, $c);
    readingsSingleUpdate($defs{$dev},
      "eod", $eod, 1);
  }
}
sub AktienUniversumScan {
  my $list = ReadingsVal("Aktien_Universum",
    "universe_list","");
  return if ($list eq "");
  my @isins = grep {$_ ne ""}
    map {s/\s+//g;; $_} split /,/, $list;
  %main::AktienScanData = ();
  $main::AktienScanOpen = scalar @isins;
  foreach my $isin (@isins) {
    my $url = "https://www.tradegatebsx.com/"
      . "refresh.php?isin=$isin";
    HttpUtils_NonblockingGet({
      url      => $url,
      timeout  => 15,
      isin     => $isin,
      header   => "User-Agent: Mozilla/5.0"
        . " (X11; Linux x86_64)",
      callback => \&AktienScan_Callback
    });
  }
}

sub AktienScan_Callback {
  my ($param, $err, $data) = @_;
  my $isin = $param->{isin};
  $main::AktienScanOpen--;
  if ($err eq "" && $data =~ /^\s*\{/) {
    my %v;
    foreach my $k ("bid","ask","high",
      "low","close") {
      ($v{$k}) = $data =~
        /"$k":\s*"?([\d.,]+)"?/;
      $v{$k} //= 0;
      if ($v{$k} =~ /,/) {
        $v{$k} =~ s/\.//g;
        $v{$k} =~ s/,/./;
      }
      $v{$k} = 0
        unless ($v{$k} =~ /^-?\d+(\.\d+)?$/);
      $v{$k} += 0;
    }
    if ($v{close} > 0 && $v{high} > 0
      && $v{low} > 0) {
      my $vola = 100*($v{high}-$v{low})
        / $v{close};
      my $spr = ($v{bid} > 0 && $v{ask} > 0)
        ? 100*($v{ask}-$v{bid})/$v{bid} : 0;
      $main::AktienScanData{$isin} = {
        vola => $vola, spread => $spr };
    }
  }
  AktienScanFinish()
    if ($main::AktienScanOpen <= 0);
}

sub AktienScanFinish {
  my $d = \%main::AktienScanData;
  my @top = (sort {
    $d->{$b}{vola} <=> $d->{$a}{vola}
  } keys %$d)[0..4];
  my @out;
  foreach my $isin (@top) {
    next if (!defined $isin);
    my $name = ReadingsVal("Aktie_$isin",
      "name", "");
    $name = ReadingsVal("Aktien_Universum",
      "n_$isin", $isin) if ($name eq "");
    push @out, sprintf("%s %.2f%% (Spread"
      . " %.2f%%)", $name, $d->{$isin}{vola},
      $d->{$isin}{spread});
  }
  my $hms = POSIX::strftime("%d.%m. %H:%M:%S",
    localtime(time()));
  readingsBeginUpdate($defs{"Aktien_Universum"});
  readingsBulkUpdate($defs{"Aktien_Universum"},
    "top_volatil", join(" | ", @out));
  readingsBulkUpdate($defs{"Aktien_Universum"},
    "scan_hms", $hms);
  readingsEndUpdate($defs{"Aktien_Universum"}, 1);
}




