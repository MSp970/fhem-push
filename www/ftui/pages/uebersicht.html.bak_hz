<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes"/>
<title>Energie-Uebersicht</title>
<script src="../ftui.js"></script>
<link href="../ftui.css" rel="stylesheet"/>
<link href="../themes/ftui-theme.css" rel="stylesheet"/>
<style>
:root{
  --bg:#0b0f1a; --card:#121826; --card2:#1a1f2e;
  --line:#1d2638; --txt:#e0e0e0; --dim:#8496ab;
  --cyan:#00ffff; --pv:#ffb300; --haus:#2196f3;
  --bat:#4caf50; --warm:#ff7043;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--bg);
  color:var(--txt);font-family:"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased}
body{min-height:100vh}
.sidenav{width:230px;background:#0a0e18;
  border-right:1px solid var(--line);padding:18px 0;
  position:fixed;top:0;left:0;height:100vh;z-index:20;
  transform:translateX(-100%);
  transition:transform .25s ease;
  box-shadow:0 0 30px rgba(0,0,0,.6)}
.sidenav.open{transform:translateX(0)}
.navshade{position:fixed;inset:0;background:rgba(0,0,0,.5);
  z-index:15;display:none}
.navshade.open{display:block}
.burger{background:none;border:none;color:var(--txt);
  font-size:22px;cursor:pointer;padding:4px 8px;
  line-height:1}
.sidenav .brand{color:var(--cyan);font-weight:800;
  font-size:17px;letter-spacing:1px;padding:0 20px 16px;
  border-bottom:1px solid var(--line);margin-bottom:10px}
.sidenav a{display:flex;align-items:center;gap:10px;
  padding:12px 20px;color:var(--dim);font-weight:600;
  font-size:15px;text-decoration:none;
  border-left:3px solid transparent}
.sidenav a.active{color:var(--txt);background:#0e1524;
  border-left-color:var(--cyan)}
.sidenav a:hover{color:var(--txt)}
.main{flex:1;min-width:0;padding-bottom:30px}
.headbar{display:flex;align-items:center;gap:18px;
  flex-wrap:wrap;padding:10px 20px;background:#0a0e18;
  border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:5}
.headbar .hi{display:flex;align-items:center;gap:6px;
  font-weight:700;font-size:14px}
.headbar .hi .u{color:var(--dim);font-weight:600;
  font-size:12px}
.headbar .spacer{flex:1}
.headbar .clock{font-size:18px;font-weight:800;
  color:var(--cyan)}
.wide-card{margin:24px auto;width:92%;max-width:1000px;
  background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.2);padding:20px}
.wide-card h2{margin:0 0 12px;font-size:16px;
  font-weight:700;color:var(--cyan)}
.wr-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:16px}
.wr{background:var(--card2);border-radius:10px;
  padding:14px 16px;
  box-shadow:0 0 10px rgba(255,255,255,.08)}
.wr h3{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--pv);text-transform:uppercase;
  letter-spacing:1px}
.wr.gruen h3{color:var(--bat)}
.wr.blau h3{color:var(--haus)}
.wr.warm h3{color:var(--warm)}
.kv{display:flex;align-items:baseline;gap:8px;
  padding:5px 0;border-bottom:1px solid #131c2a;
  font-size:14px}
.kv:last-child{border-bottom:none}
.kv .k{flex:1;color:var(--dim)}
.kv .v{font-weight:700;font-size:16px}
.kv .u{color:var(--dim);font-size:12px}
.stats-row{display:flex;justify-content:space-around;
  flex-wrap:wrap;gap:12px;margin-top:8px}
.stat{background:var(--card2);border-radius:8px;
  padding:10px 20px;min-width:150px;flex:1;
  box-shadow:0 0 10px rgba(255,255,255,.1);
  text-align:center}
.stat .sl{color:var(--dim);font-size:13px}
.stat .sv{font-size:20px;font-weight:800}
.stat .sv small{font-size:12px;font-weight:600;
  color:var(--dim)}
.circle-row{display:flex;justify-content:space-around;
  align-items:flex-start;flex-wrap:wrap;gap:20px;
  margin-top:26px;padding:0 12px}
.circle-card{position:relative;width:200px;height:200px;
  border-radius:50%;padding:20px;text-align:center;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:2px;
  background:radial-gradient(circle at center,
    var(--card2) 0%,var(--bg) 100%);
  box-shadow:0 0 20px rgba(0,255,255,.3)}
.circle-card.haus{margin-top:60px}
.circle-card h3{margin:0 0 4px;font-size:14px;
  font-weight:700;color:var(--cyan);
  text-transform:uppercase;letter-spacing:1px}
.circle-card .ico{font-size:38px;line-height:1}
.circle-card .val{font-size:34px;font-weight:800;
  letter-spacing:-1px}
.circle-card .val small{font-size:17px;font-weight:600;
  color:var(--dim)}
.circle-card .sub{font-size:12px;color:var(--dim)}
.circle-card.pv{border:2px solid var(--pv);
  box-shadow:0 0 20px rgba(255,179,0,.35)}
.circle-card.pv .ico{filter:drop-shadow(0 0 8px var(--pv))}
.circle-card.haus{border:2px solid var(--haus);
  box-shadow:0 0 20px rgba(33,150,243,.35)}
.circle-card.haus .ico{
  filter:drop-shadow(0 0 8px var(--haus))}
.circle-card.bat{border:2px solid #12324a}
.circle-card.bat .ico{
  filter:drop-shadow(0 0 8px var(--bat))}
.circle-card.bat .arc{position:absolute;inset:-2px;
  border-radius:50%;
  background:conic-gradient(from -90deg,
    var(--bat) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1% + 4%),
    transparent 0);
  -webkit-mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px));
  mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px))}
.wirebox{position:relative;max-width:960px;margin:0 auto}
.wires{position:absolute;inset:0;width:100%;height:300px;
  pointer-events:none;z-index:-1}
.wires path{fill:none;stroke-width:3;
  stroke-linecap:round;stroke-dasharray:10 14;
  animation:dash 1.2s linear infinite}
@keyframes dash{to{stroke-dashoffset:-24}}
@media (prefers-reduced-motion:reduce){
  .wires path{animation:none}}
.w-pv{stroke:var(--pv);
  filter:drop-shadow(0 0 4px var(--pv))}
.w-bat{stroke:var(--cyan);
  filter:drop-shadow(0 0 4px var(--cyan))}
@media (max-width:820px){
  .circle-card.haus{margin-top:0}
}
.tile-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:16px;width:94%;max-width:1100px;margin:20px auto}
.tile{background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.15);padding:16px}
.tile h2{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--cyan);text-transform:uppercase;
  letter-spacing:1px}
.tile.span2{grid-column:1/-1}
.bigval{font-size:40px;font-weight:800;
  letter-spacing:-1px;line-height:1.1}
.bigval{display:flex;justify-content:center;align-items:baseline;column-gap:9px}
.bigval ftui-label{display:inline-flex}
.bigval small{font-size:18px;color:var(--dim);
  font-weight:600}
.minirow{display:flex;justify-content:space-around;
  text-align:center;margin:6px 0}
.minirow .mi .ic{font-size:26px}
.minirow .mi .mv{font-size:20px;font-weight:800}
.minirow .mi .mv small{font-size:12px;color:var(--dim)}
.minirow .mi .ml{font-size:11px;color:var(--dim)}
.kv .v{white-space:nowrap}
.kv .v ftui-label{display:inline}
.wrled-row{display:flex;justify-content:space-around;flex-wrap:wrap;gap:12px}
.wrled{flex:1;min-width:180px;max-width:260px}
.wrsvg{width:100%;height:auto;display:block}
.wrsvg .fin{fill:#222a3b;stroke:#303b52}
.wrsvg .panel{fill:#0b0f1a;stroke:#27324a}
.wrsvg .wrt{fill:#00ffff;font-weight:800;font-size:15px;letter-spacing:1px}
.wrsvg .wrs{fill:#8496ab;font-size:9px;letter-spacing:.5px}
.wrsvg .wri{fill:#e0e0e0;font-size:10px;font-weight:600}
.wrsvg .ledt{fill:#8496ab;font-size:10px;font-weight:700;letter-spacing:1px}
.wrsvg .led{fill:#262e3f;stroke:#39455f;stroke-width:1}
.wrsvg .led.on,.wrsvg .led.b1,.wrsvg .led.b2{fill:var(--lc,#4caf50);filter:drop-shadow(0 0 5px var(--lc,#4caf50))}
.wrsvg .led.b1{animation:ledbl 1.6s steps(1) infinite}
.wrsvg .led.b2{animation:ledbl .5s steps(1) infinite}
@keyframes ledbl{50%{fill:#262e3f;filter:none}}
@media (prefers-reduced-motion:reduce){.wrsvg .led.b1,.wrsvg .led.b2{animation:none;opacity:.6}}
.wrled-leg{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-top:8px;font-size:11px;color:var(--dim)}
.wrled-leg span{display:flex;align-items:center;gap:5px}
.wrled-leg .lg{display:inline-block;width:9px;height:9px;border-radius:50%;background:#262e3f;border:1px solid #39455f}
.wrled-leg .lg.on,.wrled-leg .lg.b1,.wrled-leg .lg.b2{background:#4caf50;box-shadow:0 0 5px #4caf50}
.wrled-leg .lg.b1{animation:lgbl 1.6s steps(1) infinite}
.wrled-leg .lg.b2{animation:lgbl .5s steps(1) infinite}
@keyframes lgbl{50%{background:#262e3f;box-shadow:none}}
</style>
</head>
<body>

<div class="navshade" id="navshade"></div>
<nav class="sidenav" id="sidenav">
  <div class="brand">SMART HOME</div>
    <a href="uebersicht.html" class="active">⚡ Übersicht</a>
    <a href="energy.html">🏠 Übersicht klassisch</a>
    <a href="energie2.html">🔆 PV-Anlage</a>
    <a href="klima.html">🔥 Heizung</a>
    <a href="auto.html">🚗 E-Autos</a>
  <a href="tobi.html">👤 Tobi</a>
    <a href="geraete.html">🛠️ Geräte</a>
    <a href="monitor.html">🛡️ Monitoring</a>
    <a href="/fhem" style="border-top:1px solid rgba(255,255,255,.1)">⚙️ FHEM</a>
</nav>

<div class="main">
  <div class="headbar">

  <button class="burger" id="burger">☰</button>
  <div class="hi">🚗 <ftui-label
    [text]="OpenWB_Garage_links:Ladeleistung_gesamt_kW"></ftui-label>
    / <ftui-label
    [text]="OpenWB_Garage_rechts:Ladeleistung_gesamt_kW"></ftui-label>
    <span class="u">kW</span></div>
  <div class="hi">🔆 <ftui-label
    [text]="di_DashWerte:PV_gesamt"></ftui-label>
    <span class="u">W</span></div>
  <div class="hi">🔋 <ftui-label
    [text]="di_DashWerte:SOC_gew"></ftui-label>
    <span class="u">%</span></div>
  <div class="spacer"></div>
  <div class="hi">🌡️ <ftui-label
    [text]="BresserWetter:temperatur_aussen"></ftui-label>
    <span class="u">°C</span></div>
  <div class="clock" id="clock"></div>

  </div>

<style>
.ue-bar0{width:94%;max-width:1400px;margin:14px auto 0;display:flex;justify-content:flex-end;gap:8px}
.ue-btn{background:#161e2e;border:1px solid #1f2a3e;color:#9fb0c5;font-size:12px;padding:6px 12px;border-radius:99px;cursor:pointer;font-family:inherit}
.ue-btn:hover{color:#e8eef6;border-color:#2b3a55}.ue-btn.pri{color:#22d3ee;border-color:rgba(34,211,238,.4)}
.ue-wrap{width:94%;max-width:1400px;margin:12px auto 18px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,560px),1fr));gap:18px;align-items:stretch}
.ue-card{display:flex;flex-direction:column}.ue-card .ue-chips{margin-top:auto;padding-top:10px}.ue-card .ue-flow{flex:1}
.ue-card.wide{grid-column:1/-1}
.ue-ctl{display:none;gap:4px;margin-left:8px}
.ue-edit .ue-ctl{display:flex}
.ue-edit .ue-card{outline:1px dashed rgba(34,211,238,.35);outline-offset:3px}
.ue-ctl button{background:#1a2336;border:1px solid #26324a;color:#cfd8e3;width:30px;height:28px;border-radius:8px;cursor:pointer;font-size:14px;line-height:1;padding:0}
.ue-ctl .hd{cursor:grab;touch-action:none}
.ue-card.drag{opacity:.35}
.ue-ghost{position:fixed;pointer-events:none;z-index:50;opacity:.85;transform:rotate(1deg);box-shadow:0 20px 50px rgba(0,0,0,.6);border-radius:18px}
.ue-card{background:linear-gradient(160deg,#141b2b 0%,#0f1522 100%);border:1px solid #1d2638;border-radius:18px;padding:16px 18px;box-shadow:0 8px 30px rgba(0,0,0,.35)}
.ue-h{display:flex;align-items:center;gap:10px;margin:0 0 10px}
.ue-h h2{margin:0;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:var(--cyan,#0ff);font-weight:700}
.ue-h .ue-sub{color:var(--dim,#8496ab);font-size:12px}
.ue-h .ue-st{margin-left:auto;font-size:11px;padding:3px 9px;border-radius:99px;background:#1a2336;color:#8496ab}
.ue-st.on{color:#4ade80;background:rgba(74,222,128,.1)}.ue-st.off{color:#f87171;background:rgba(248,113,113,.12)}
.ue-flow{display:grid;grid-template-columns:minmax(180px,260px) 1fr;gap:16px;align-items:center}
@media(max-width:560px){.ue-flow{grid-template-columns:1fr}.ue-ring{max-width:260px;margin:0 auto}}
.ue-ring svg{width:100%;height:auto;display:block}
.ue-leg{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px}
.ue-leg .col h3{margin:0 0 6px;font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:#6b7c93;font-weight:600}
.ue-li{display:flex;align-items:center;gap:8px;font-size:13px;padding:4px 0;border-bottom:1px solid rgba(255,255,255,.04)}
.ue-li i{width:9px;height:9px;border-radius:3px;flex:none}
.ue-li span{color:#b7c3d3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ue-li b{margin-left:auto;white-space:nowrap;font-weight:600;font-variant-numeric:tabular-nums;color:#e8eef6}
.ue-li.z{opacity:.35}
.ue-top{display:flex;align-items:flex-end;gap:18px;flex-wrap:wrap;margin-bottom:10px}
.ue-soc{font-size:44px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
.ue-soc small{font-size:18px;color:#8496ab;font-weight:600;margin-left:2px}
.ue-eta{display:flex;flex-direction:column;gap:3px}
.ue-eta .l{font-size:11px;color:#6b7c93;text-transform:uppercase;letter-spacing:1px}
.ue-eta .v{font-size:20px;font-weight:700}
.ue-pill{margin-left:auto;align-self:center;font-size:12px;font-weight:600;padding:6px 12px;border-radius:99px}
.ue-pill.ok{background:rgba(74,222,128,.12);color:#4ade80}.ue-pill.run{background:rgba(0,229,255,.1);color:#22d3ee}.ue-pill.warn{background:rgba(251,191,36,.12);color:#fbbf24}
.ue-bats{display:flex;flex-direction:column;gap:7px;margin:4px 0 10px}
.ue-bat{display:grid;grid-template-columns:96px 1fr 84px;align-items:center;gap:10px;font-size:12px;color:#b7c3d3}
.ue-bar{position:relative;height:9px;border-radius:9px;background:#1b2437;overflow:visible}
.ue-bar .f{position:absolute;left:0;top:0;bottom:0;border-radius:9px;background:linear-gradient(90deg,#16a34a,#4ade80);transition:width .6s}
.ue-bar .t{position:absolute;top:-4px;bottom:-4px;width:2px;background:#e8eef6;border-radius:2px;box-shadow:0 0 6px rgba(255,255,255,.6)}
.ue-bat b{text-align:right;font-variant-numeric:tabular-nums;color:#e8eef6;font-weight:600}
.ue-chart svg{width:100%;height:auto;display:block}
.ue-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.ue-chip{font-size:11px;color:#9fb0c5;background:#161e2e;border:1px solid #1f2a3e;padding:4px 9px;border-radius:99px}
.ue-chip b{color:#e8eef6;font-weight:600}
.ue-leg2{display:flex;gap:14px;font-size:11px;color:#8496ab;margin:2px 0 4px;flex-wrap:wrap}
.ue-leg2 i{display:inline-block;width:14px;height:3px;border-radius:2px;vertical-align:middle;margin-right:5px}

.ue-embed{background:transparent!important}.ue-embed .headbar,.ue-embed .sidenav,.ue-embed .navshade,.ue-embed .ue-bar0{display:none!important}
.ue-embed .main{margin:0!important;padding:0!important}.ue-embed .ue-wrap{width:100%;max-width:none;margin:0;grid-template-columns:1fr;gap:10px}.ue-embed .ue-ctl{display:none!important}
</style>
<div class="ue-bar0"><button class="ue-btn" id="ue_rst" style="display:none">Zurücksetzen</button><button class="ue-btn" id="ue_edit">⇅ Anordnen</button></div>
<div class="ue-wrap" id="ue"></div>
<script>
(function(){
var SITES=[
 {id:'g',name:'Große Anlage',base:'http://192.168.176.205:8084',
  pv:[['GoodWe_Garage_Haus_West_5877','PV_Total_Power','PV West'],['GoodWe_Haus_Ost_Mitte_5876','PV_Total_Power','PV Ost'],['myShelly_Technikraum_Deye_PM_L1','Total_Power_i','Deye']],
  bat:[{n:'Akku West',chg:['GoodWe_Garage_Haus_West_5877','Ladeleistung'],dis:['GoodWe_Garage_Haus_West_5877','Entladeleistung']},
       {n:'Akku Ost',chg:['GoodWe_Haus_Ost_Mitte_5876','Ladeleistung'],dis:['GoodWe_Haus_Ost_Mitte_5876','Entladeleistung']}],
  meter:'HA_SDM630M_Nergie',
  cons:[['HA_SDM630M_Wohnung_EG','Power_Sum__W','Wohnung EG','#60a5fa'],['HA_SDM630M_Wohnung_OG','Power_Sum__W','Wohnung OG','#818cf8'],['HA_SDM630M_Allgemein','Power_Sum__W','Allgemein','#38bdf8'],['HA_SDM630M_Heatpump','Power_Sum__W','Wärmepumpe','#f472b6'],['OpenWB_Garage_links','Ladeleistung_gesamt','Wallbox links','#a78bfa',1],['OpenWB_Garage_rechts','Ladeleistung_gesamt','Wallbox rechts','#c084fc',1]],
  fc:'DOIF_PV_forecast_Batterie_laden',em:'DOIF_GoodWe_simple',ctrl:'EMS_Control',
  v2:'DOIF_GoodWe_v2',
  pb:[{n:'West',wr:'GoodWe_Garage_Haus_West_5877',id:'5877',i:1},{n:'Ost',wr:'GoodWe_Haus_Ost_Mitte_5876',id:'5876',i:2}]},
 {id:'k',name:'Kleine Anlage',base:'http://192.168.178.21:8084',
  pv:[['GoodWe','PV_Total_Power','PV GoodWe'],['smart_meter_PV_Deye','Power_Deye_gesamt_Huette','Deye Hütte'],['myShelly_Garage_Deye','Total_Power','Deye Garage']],
  bat:[{n:'Akku',sgn:['GoodWe','Power_Battery']}],
  meter:'HA_SDM630M_Nergie',
  cons:[['HA_SDM630M_Haus','Power_Sum__W','Haus','#60a5fa'],['HA_SDM630M_Heatpump','Power_Sum__W','Wärmepumpe','#f472b6'],['OpenWB','Ladeleistung_gesamt','Wallbox','#a78bfa',1]],
  fc:'DOIF_PV_forecast_Batterie_laden',em:'DOIF_GoodWe_simple',ctrl:'EMS_Control',
  v2:'DOIF_GoodWe_v2',
  pb:[{n:'Akku',wr:'GoodWe',id:'',i:1}]}
];
var C={pv:['#2e8b2e','#4caf50','#8bc34a'],bat:'#e8a317',grid:'#e05252',haus:'#60a5fa',wb:'#a78bfa',chg:'#f5c451',exp:'#94a3b8'};
var NS='http://www.w3.org/2000/svg';
function E(t,a,p){var e=document.createElementNS(NS,t);for(var k in a)e.setAttribute(k,a[k]);if(p)p.appendChild(e);return e;}
function fW(v){v=Math.abs(v);return v>=1000?(v/1000).toFixed(1).replace('.',',')+' kW':Math.round(v)+' W';}
function fK(v){return (Math.round(v*10)/10).toFixed(1).replace('.',',');}
function hm(t){var h=Math.floor(t),m=Math.round((t-h)*60);if(m>=60){h++;m-=60;}return ('0'+h).slice(-2)+':'+('0'+m).slice(-2);}
function jl(s,devs,rds){
  var go=function(){return fetch(s.base+'/fhem?cmd='+encodeURIComponent('jsonlist2 '+devs.join(',')+(rds?' '+rds.join(' '):''))+'&XHR=1&fwcsrf='+encodeURIComponent(s.tok||''),{cache:'no-store'}).then(function(r){if(!r.ok)throw r.status;return r.json();});};
  var tk=function(){return fetch(s.base+'/fhem?XHR=1',{cache:'no-store'}).then(function(r){s.tok=r.headers.get('X-FHEM-csrfToken')||'';});};
  return (s.tok===undefined?tk().then(go):go()).catch(function(e){return tk().then(go);}).then(function(j){var m={};j.Results.forEach(function(x){m[x.Name]=x.Readings||{};});return m;});
}
function N(m,d,r,def){try{var v=parseFloat(m[d][r].Value);return isNaN(v)?(def||0):v;}catch(e){return def||0;}}
function V(m,d,r,def){try{return m[d][r].Value;}catch(e){return def;}}

function card(id,inner){var c=document.createElement('div');c.className='ue-card';c.setAttribute('data-id',id);c.innerHTML=inner;
  var h=c.querySelector('.ue-h');var ctl=document.createElement('span');ctl.className='ue-ctl';
  ctl.innerHTML='<button class="hd" title="Ziehen">⠿</button><button data-a="-1" title="nach vorn">◀</button><button data-a="1" title="nach hinten">▶</button><button data-a="w" title="breit/schmal">⇔</button>';
  h.appendChild(ctl);return c;}
function build(s){
  var st='<span class="ue-st" id="st_'+s.id+'">…</span>';
  CARDS['flow_'+s.id]=card('flow_'+s.id,'<div class="ue-h"><h2>'+s.name+'</h2><span class="ue-sub">Energiefluss</span>'+st+'</div>'+
   '<div class="ue-flow"><div class="ue-ring" id="ring_'+s.id+'"></div><div class="ue-leg"><div class="col"><h3>Quellen</h3><div id="src_'+s.id+'"></div></div><div class="col"><h3>Verbraucher</h3><div id="snk_'+s.id+'"></div></div></div></div>');
  CARDS['plan_'+s.id]=card('plan_'+s.id,'<div class="ue-h"><h2>Speicher-Ladeplan</h2><span class="ue-sub">'+s.name+'</span></div>'+
   '<div class="ue-top"><div class="ue-soc" id="soc_'+s.id+'">–<small>%</small></div><div class="ue-eta"><span class="l" id="etal_'+s.id+'">Ziel</span><span class="v" id="eta_'+s.id+'">–</span></div><span class="ue-pill" id="pill_'+s.id+'"></span></div>'+
   '<div class="ue-bats" id="bats_'+s.id+'"></div>'+
   '<div class="ue-leg2"><span><i style="background:#22d3ee"></i>Plan kW</span><span><i style="background:#fb923c"></i>Ist kW</span><span><i style="background:#e8eef6;height:2px;border-top:1px dashed #e8eef6;background:none"></i>SOC-Prognose</span><span><i style="background:#ef4444;opacity:.7"></i>Limit</span></div>'+
   '<div class="ue-chart" id="ch_'+s.id+'"></div><div class="ue-chips" id="chips_'+s.id+'"></div>');
}
var CARDS={},LKEY='ue_layout_v1';
function defLayout(){var o=[];SITES.forEach(function(s){o.push({id:'flow_'+s.id});});SITES.forEach(function(s){o.push({id:'plan_'+s.id});});return o;}
function loadLayout(){var l=null;try{l=JSON.parse(localStorage.getItem(LKEY)||'null');}catch(e){}
  if(!Array.isArray(l))l=[];l=l.filter(function(x){return x&&CARDS[x.id];});
  defLayout().forEach(function(d){if(!l.some(function(x){return x.id==d.id;}))l.push(d);});return l;}
function saveLayout(){var l=[].map.call(document.querySelectorAll('#ue > .ue-card'),function(c){return {id:c.getAttribute('data-id'),wide:c.classList.contains('wide')};});try{localStorage.setItem(LKEY,JSON.stringify(l));}catch(e){}}
function applyLayout(l){var w=document.getElementById('ue');l.forEach(function(x){var c=CARDS[x.id];c.classList.toggle('wide',!!x.wide);w.appendChild(c);});}
function initEdit(){
  var w=document.getElementById('ue'),be=document.getElementById('ue_edit'),br=document.getElementById('ue_rst');
  be.addEventListener('click',function(){var on=!w.classList.contains('ue-edit');w.classList.toggle('ue-edit',on);be.textContent=on?'✓ Fertig':'⇅ Anordnen';be.classList.toggle('pri',on);br.style.display=on?'':'none';if(!on)saveLayout();});
  br.addEventListener('click',function(){try{localStorage.removeItem(LKEY);}catch(e){}applyLayout(defLayout());saveLayout();refreshAll();});
  w.addEventListener('click',function(e){var b=e.target.closest('.ue-ctl button');if(!b||!b.getAttribute('data-a'))return;var c=b.closest('.ue-card'),a=b.getAttribute('data-a');
    if(a=='w'){c.classList.toggle('wide');}
    else if(a=='-1'){var p=c.previousElementSibling;if(p)w.insertBefore(c,p);}
    else{var n=c.nextElementSibling;if(n)w.insertBefore(n,c);}
    saveLayout();refreshAll();});
  // Ziehen mit Maus/Finger
  var drag=null,ghost=null,ox=0,oy=0;
  w.addEventListener('pointerdown',function(e){var h=e.target.closest('.ue-ctl .hd');if(!h)return;e.preventDefault();drag=h.closest('.ue-card');var r=drag.getBoundingClientRect();ox=e.clientX-r.left;oy=e.clientY-r.top;
    ghost=drag.cloneNode(true);ghost.classList.add('ue-ghost');ghost.style.width=r.width+'px';ghost.style.left=r.left+'px';ghost.style.top=r.top+'px';document.body.appendChild(ghost);drag.classList.add('drag');
    try{h.setPointerCapture(e.pointerId);}catch(x){}});
  document.addEventListener('pointermove',function(e){if(!drag)return;ghost.style.left=(e.clientX-ox)+'px';ghost.style.top=(e.clientY-oy)+'px';
    var el=document.elementFromPoint(e.clientX,e.clientY),t=el&&el.closest?el.closest('#ue > .ue-card'):null;if(!t||t==drag||t==ghost)return;
    var r=t.getBoundingClientRect(),after=(r.width>r.height*1.2&&(t.classList.contains('wide')))?(e.clientY>r.top+r.height/2):(e.clientX>r.left+r.width/2||e.clientY>r.bottom-20);
    w.insertBefore(drag,after?t.nextElementSibling:t);
    if(e.clientY<60)window.scrollBy(0,-15);else if(e.clientY>window.innerHeight-60)window.scrollBy(0,15);});
  function end(){if(!drag)return;drag.classList.remove('drag');if(ghost)ghost.remove();ghost=null;drag=null;saveLayout();refreshAll();}
  document.addEventListener('pointerup',end);document.addEventListener('pointercancel',end);
}
function refreshAll(){}

function ring(el,src,snk,center,sub){
  el.innerHTML='';var svg=E('svg',{viewBox:'0 0 240 240'},el);
  var defs=E('defs',{},svg);var fl=E('filter',{id:'gl'+el.id,x:'-20%',y:'-20%',width:'140%',height:'140%'},defs);E('feGaussianBlur',{stdDeviation:'2.5',result:'b'},fl);var mg=E('feMerge',{},fl);E('feMergeNode',{in:'b'},mg);E('feMergeNode',{in:'SourceGraphic'},mg);
  function arcs(items,r,sw){
    E('circle',{cx:120,cy:120,r:r,fill:'none',stroke:'#1b2437','stroke-width':sw},svg);
    var tot=items.reduce(function(a,b){return a+b.v;},0);if(tot<=0)return;
    var C2=2*Math.PI*r,gap=items.length>1?4:0,off=0;
    items.forEach(function(it){var len=C2*it.v/tot;var dl=Math.max(len-gap,0.5);
      E('circle',{cx:120,cy:120,r:r,fill:'none',stroke:it.c,'stroke-width':sw,'stroke-dasharray':dl+' '+(C2-dl),'stroke-dashoffset':-off,transform:'rotate(-90 120 120)','stroke-linecap':'butt',filter:'url(#gl'+el.id+')'},svg);off+=len;});
  }
  arcs(src,104,14);arcs(snk,82,10);
  var t=E('text',{x:120,y:112,'text-anchor':'middle',fill:'#e8eef6','font-size':'26','font-weight':'800'},svg);t.textContent=center;
  var t2=E('text',{x:120,y:132,'text-anchor':'middle',fill:'#8496ab','font-size':'11','letter-spacing':'1'},svg);t2.textContent='HAUSVERBRAUCH';
  var t3=E('text',{x:120,y:154,'text-anchor':'middle',fill:'#4ade80','font-size':'13','font-weight':'700'},svg);t3.textContent=sub;
}
function legend(el,items){el.innerHTML=items.map(function(it){return '<div class="ue-li'+(it.v>0?'':' z')+'"><i style="background:'+it.c+'"></i><span>'+it.l+'</span><b>'+fW(it.v)+'</b></div>';}).join('');}

function flow(s){
  var devs=[],rds=[];function add(d,r){if(devs.indexOf(d)<0)devs.push(d);if(rds.indexOf(r)<0)rds.push(r);}
  s.pv.forEach(function(p){add(p[0],p[1]);});s.bat.forEach(function(b){if(b.sgn)add(b.sgn[0],b.sgn[1]);else{add(b.chg[0],b.chg[1]);add(b.dis[0],b.dis[1]);}});
  ['Einspeiseleistung','Bezugsleistung','Summe_Leistungsbezug_Haus_gesamt'].forEach(function(r){add(s.meter,r);});s.cons.forEach(function(c){add(c[0],c[1]);});
  return jl(s,devs,rds).then(function(m){
    var src=[],snk=[],dis=0,chgL=[],BC=['#f5c451','#fde68a','#fbbf24'];
    s.pv.forEach(function(p,i){src.push({l:p[2],v:Math.max(0,N(m,p[0],p[1])),c:C.pv[i%3]});});
    s.bat.forEach(function(b,i){var c=0;if(b.sgn){var v=N(m,b.sgn[0],b.sgn[1]);if(v<0)c=-v;else dis+=v;}else{c=Math.max(0,N(m,b.chg[0],b.chg[1]));dis+=Math.max(0,N(m,b.dis[0],b.dis[1]));}
      chgL.push({l:(s.bat.length>1?b.n.replace('Akku ','Laden '):'Akku laden'),v:c,c:BC[i%3]});});
    var bez=Math.max(0,N(m,s.meter,'Bezugsleistung')),exp=Math.max(0,N(m,s.meter,'Einspeiseleistung')),haus=Math.max(0,N(m,s.meter,'Summe_Leistungsbezug_Haus_gesamt'));
    src.push({l:'Akku',v:dis,c:C.bat});src.push({l:'Netz',v:bez,c:C.grid});
    var sum=0;s.cons.forEach(function(c){var v=Math.max(0,N(m,c[0],c[1]));if(c[4]&&v<10)v=0;sum+=v;snk.push({l:c[2],v:v,c:c[3]});});
    var rest=haus-sum;if(rest>30)snk.push({l:'Sonstiges',v:rest,c:'#64748b'});
    chgL.forEach(function(x){snk.push(x);});snk.push({l:'Einspeisung',v:exp,c:C.exp});
    var aut=haus>0?Math.max(0,Math.min(100,Math.round(100*(1-bez/haus)))):100;
    ring(document.getElementById('ring_'+s.id),src.filter(function(x){return x.v>0;}),snk.filter(function(x){return x.v>0;}),fW(haus),'Autarkie '+aut+' %');
    legend(document.getElementById('src_'+s.id),src);legend(document.getElementById('snk_'+s.id),snk.filter(function(x){return x.l!='Sonstiges';}));
    var st=document.getElementById('st_'+s.id);st.className='ue-st on';st.textContent='live';
  }).catch(function(e){var st=document.getElementById('st_'+s.id);st.className='ue-st off';st.textContent='offline';});
}

function plan(s){
  var devs=[s.fc,s.em,s.ctrl,s.v2];s.pb.forEach(function(b){if(devs.indexOf(b.wr)<0)devs.push(b.wr);});
  return jl(s,devs).then(function(m){
    var nowH0=new Date().getHours();
    var curve=[],ist=[],fixd=[];for(var h=0;h<24;h++){var hh=('0'+h).slice(-2);var c=Math.max(0,N(m,s.fc,'charge_curve_'+hh));var f=N(m,s.em,'plan_fix_'+hh,-1);curve.push(c);fixd.push(f);ist.push(N(m,s.em,'ist_kw_'+hh,-1));}
    var now=new Date(),nowH=now.getHours()+now.getMinutes()/60;
    function v2r(pre,id,def){var R=m[s.v2]||{};if(id&&R[pre+id])return parseFloat(R[pre+id].Value);var k=Object.keys(R).filter(function(x){return x.indexOf(pre)==0;}).sort();return k.length?parseFloat(R[k[0]].Value):def;}
    var v2ok=!!m[s.v2],ifc=v2ok&&v2r('i_max_fc','',0)==1;
    var iMax=ifc?N(m,s.ctrl,'iMaxFcA',7):Math.min(10,N(m,s.ctrl,'iMaxA',10));
    var MT={1:'Auto',2:'Laden',3:'Entladen',10:'Netzpunkt',11:'Laden',12:'Entladen fix',255:'offline'};
    var bats=s.pb.map(function(b){var soc=N(m,b.wr,'SOC'),zm=v2ok?v2r('socmax_eff_',b.id,NaN):NaN;if(isNaN(zm))zm=N(m,s.ctrl,'socMax'+b.i,80);
      var cap=N(m,s.ctrl,'capacity'+b.i,b.i==1?10:5),u=N(m,b.wr,'Battery1_Voltage',0),pwr=N(m,b.wr,'Power_Battery');
      var md=v2ok?v2r('ist_mode_',b.id,-1):-1;
      return {n:b.n,soc:soc,zm:zm,cap:cap,thr:Math.max(0,zm-1),ok:soc>=zm-1,pw:pwr,soll:v2ok?v2r('p_soll_',b.id,0):0,lim:u>0?iMax*u:3500,mode:md};});
    var capT=0,En=0,need=0,Zmax=0;bats.forEach(function(b){capT+=b.cap;En+=b.cap*b.soc/100;need+=Math.max(0,b.cap*(b.thr-b.soc)/100);Zmax+=b.cap*b.zm/100;});
    var socW=capT>0?100*En/capT:0,zielW=capT>0?100*Zmax/capT:0,allOk=bats.every(function(b){return b.ok;});
    var modus=bats.map(function(b){return (bats.length>1?b.n+' ':'')+(MT[b.mode]||('Mode '+b.mode));}).join(' · ');
    var sollKw=bats.reduce(function(a,b){return a+Math.max(0,b.soll);},0)/1000;
    var limKw=bats.reduce(function(a,b){return a+b.lim;},0)/1000;
    var st=V(m,s.fc,'charge_start_time','00:00:00').split(':'),startH=(+st[0]||0)+(+st[1]||0)/60;
    var S=Math.max(nowH,startH);
    // ETA + Projektion (kWh ab S nach Plan)
    var tfull=null,acc=0,proj=[[nowH,socW]];
    if(!allOk){for(var h2=Math.floor(S);h2<24;h2++){var a=Math.max(h2,S),b2=h2+1,p=curve[h2];if(b2<=a)continue;
      if(p>0.001&&acc+p*(b2-a)>=need){tfull=a+(need-acc)/p;acc=need;proj.push([tfull,capT>0?100*(En+acc)/capT:0]);break;}
      acc+=p*(b2-a);if(p>0.001)proj.push([b2,capT>0?100*(En+acc)/capT:0]);}}
    // Kopf
    document.getElementById('soc_'+s.id).innerHTML=Math.round(socW)+'<small>%</small>';
    var pill=document.getElementById('pill_'+s.id),eta=document.getElementById('eta_'+s.id),etal=document.getElementById('etal_'+s.id);
    if(allOk){pill.className='ue-pill ok';pill.textContent='✓ Ziel erreicht';etal.textContent='Ziel '+Math.round(zielW)+' %';eta.textContent=fK(En)+' kWh im Speicher';}
    else if(tfull!==null){pill.className='ue-pill run';pill.textContent='lädt nach Plan';etal.textContent='voll (Ziel '+Math.round(zielW)+' %) ca.';eta.textContent=hm(tfull)+' Uhr';}
    else{pill.className='ue-pill warn';pill.textContent='Ziel heute nicht erreichbar';etal.textContent='Ziel '+Math.round(zielW)+' %';eta.textContent='fehlen '+fK(need)+' kWh';}
    document.getElementById('bats_'+s.id).innerHTML=bats.map(function(b){return '<div class="ue-bat"><span>'+b.n+' <small style="color:#6b7c93">'+Math.round(b.cap)+' kWh</small></span><div class="ue-bar"><div class="f" style="width:'+Math.min(100,b.soc)+'%;'+(b.ok?'':'background:linear-gradient(90deg,#0891b2,#22d3ee)')+'"></div><div class="t" style="left:calc('+Math.min(100,b.zm)+'% - 1px)"></div></div><b>'+Math.round(b.soc)+' / '+Math.round(b.zm)+' %'+(b.ok?' ✓':'')+'</b></div>';}).join('');
    // Diagramm
    for(var hp=0;hp<nowH0;hp++){if(fixd[hp]>=0)curve[hp]=fixd[hp];}
    var sw=(V(m,s.fc,'debug_sun_window','6-21')+'').split('-'),h0=Math.max(0,(+sw[0]||6)-1),h1=Math.min(24,(+sw[1]||21)+1);
    for(var k=0;k<24;k++){if(ist[k]>0.1||curve[k]>0.05){h0=Math.min(h0,k);h1=Math.max(h1,k+1);}}
    var ymax=0.5;for(k=h0;k<h1;k++){ymax=Math.max(ymax,curve[k],ist[k]);}ymax=Math.max(ymax,sollKw);if(limKw<=ymax*1.6)ymax=Math.max(ymax,limKw);ymax=Math.ceil(ymax*1.15*2)/2;
    var W=640,H=230,L=34,R=38,T=12,B=26,pw=W-L-R,ph=H-T-B;
    function X(t){return L+(t-h0)/(h1-h0)*pw;}function Y(v){return T+ph-(v/ymax)*ph;}function Ys(v){return T+ph-(v/100)*ph;}
    var el=document.getElementById('ch_'+s.id);el.innerHTML='';var svg=E('svg',{viewBox:'0 0 '+W+' '+H},el);
    var defs=E('defs',{},svg),g=E('linearGradient',{id:'pg'+s.id,x1:0,y1:0,x2:0,y2:1},defs);E('stop',{offset:'0','stop-color':'#22d3ee','stop-opacity':'.45'},g);E('stop',{offset:'1','stop-color':'#22d3ee','stop-opacity':'0'},g);
    var g2=E('linearGradient',{id:'ig'+s.id,x1:0,y1:0,x2:0,y2:1},defs);E('stop',{offset:'0','stop-color':'#fb923c'},g2);E('stop',{offset:'1','stop-color':'#ea580c','stop-opacity':'.55'},g2);
    // Raster
    for(var gy=0;gy<=4;gy++){var vy=ymax*gy/4,yy=Y(vy);E('line',{x1:L,x2:W-R,y1:yy,y2:yy,stroke:'#1b2437','stroke-width':1},svg);var tl=E('text',{x:L-6,y:yy+3,'text-anchor':'end',fill:'#5b6b82','font-size':'10'},svg);tl.textContent=(Math.round(vy*10)/10+'').replace('.',',');
      var tr=E('text',{x:W-R+6,y:Ys(gy*25)+3,fill:'#5b6b82','font-size':'10'},svg);tr.textContent=gy*25+'%';}
    var stp=(h1-h0)>12?2:1;for(var hx=Math.ceil(h0/stp)*stp;hx<=h1;hx+=stp){var tx=E('text',{x:X(hx),y:H-8,'text-anchor':'middle',fill:'#5b6b82','font-size':'10'},svg);tx.textContent=hx+'h';}
        // Vergangenheit abdunkeln
    if(nowH>h0)E('rect',{x:L,y:T,width:Math.max(0,Math.min(X(nowH),W-R)-L),height:ph,fill:'rgba(255,255,255,.025)'},svg);
    // Ist-Balken
    for(k=h0;k<h1;k++){if(ist[k]<0)continue;var bx=X(k)+pw/(h1-h0)*0.18,bw=pw/(h1-h0)*0.64,by=Y(ist[k]);E('rect',{x:bx,y:by,width:bw,height:Math.max(0,T+ph-by),rx:3,fill:'url(#ig'+s.id+')'},svg);}
    // Plan-Fläche (Stufen geglättet über Stundenmitte)
    var pts=[];for(k=h0;k<h1;k++)pts.push([X(k+0.5),Y(curve[k])]);
    if(pts.length){var d='M'+X(h0)+' '+pts[0][1];pts.forEach(function(p,i){if(i==0){d+=' L'+p[0]+' '+p[1];return;}var q=pts[i-1],cx=(q[0]+p[0])/2;d+=' C'+cx+' '+q[1]+' '+cx+' '+p[1]+' '+p[0]+' '+p[1];});d+=' L'+X(h1)+' '+pts[pts.length-1][1];
      E('path',{d:d+' L'+X(h1)+' '+(T+ph)+' L'+X(h0)+' '+(T+ph)+' Z',fill:'url(#pg'+s.id+')'},svg);E('path',{d:d,fill:'none',stroke:'#22d3ee','stroke-width':2.2,'stroke-linejoin':'round'},svg);}
    // Limit
    if(limKw<=ymax)E('line',{x1:L,x2:W-R,y1:Y(limKw),y2:Y(limKw),stroke:'#ef4444','stroke-width':1.2,'stroke-dasharray':'2 4',opacity:.7},svg);
    // Ziel-SOC (rechte Achse)
    E('line',{x1:L,x2:W-R,y1:Ys(zielW-1),y2:Ys(zielW-1),stroke:'#4ade80','stroke-width':1,'stroke-dasharray':'6 4',opacity:.45},svg);
    // SOC-Prognose
    if(!allOk&&proj.length>1){var pd='M'+proj.map(function(p){return X(Math.min(p[0],h1))+' '+Ys(p[1]);}).join(' L');E('path',{d:pd,fill:'none',stroke:'#e8eef6','stroke-width':1.8,'stroke-dasharray':'5 4',opacity:.85},svg);
      if(tfull!==null&&tfull<=h1){E('circle',{cx:X(tfull),cy:Ys(proj[proj.length-1][1]),r:4.5,fill:'#4ade80',stroke:'#0f1522','stroke-width':2},svg);var lt=E('text',{x:Math.min(X(tfull)+8,W-R-40),y:Ys(proj[proj.length-1][1])-8,fill:'#4ade80','font-size':'11','font-weight':'700'},svg);lt.textContent='voll '+hm(tfull);}}
    // Jetzt
    if(nowH>=h0&&nowH<=h1){var nx=X(nowH);E('line',{x1:nx,x2:nx,y1:T,y2:T+ph,stroke:'#e8eef6','stroke-width':1.2,opacity:.55},svg);E('circle',{cx:nx,cy:Ys(socW),r:4.5,fill:'#22d3ee',stroke:'#0f1522','stroke-width':2},svg);
      if(sollKw>0)E('circle',{cx:nx,cy:Y(sollKw),r:3.5,fill:'none',stroke:'#fbbf24','stroke-width':2},svg);
      var jt=E('text',{x:nx,y:T+9,'text-anchor':'middle',fill:'#8496ab','font-size':'9','letter-spacing':'1'},svg);jt.textContent='JETZT';}
    var istNow=bats.reduce(function(a,b){return a+(b.pw<0?-b.pw:0);},0)/1000;
    var fcK=N(m,s.fc,'forecast_today_kwh'),bad=N(m,s.fc,'debug_schlechter_tag',1);
    document.getElementById('chips_'+s.id).innerHTML=['Modus <b>'+modus+'</b>','Laden jetzt <b>'+fK(istNow)+' kW</b>'+(sollKw>0?' / Soll <b>'+fK(sollKw)+'</b>':''),'Limit <b>'+fK(limKw)+' kW</b> ('+fK(iMax)+' A'+(ifc?' Prognose':'')+')','PV-Prognose <b>'+fK(fcK)+' kWh</b>','Start <b>'+(st[0]||'00')+':'+(st[1]||'00')+'</b>',(bad>0?'⛅ schlechter Tag':'☀️ guter Tag')].map(function(x){return '<span class="ue-chip">'+x+'</span>';}).join('');
  }).catch(function(e){document.getElementById('ch_'+s.id).innerHTML='<div style="color:#f87171;font-size:12px;padding:20px 0">Ladeplan nicht abrufbar ('+e+')</div>';});
}
function initNav(){var b=document.getElementById('burger'),n=document.getElementById('sidenav'),s=document.getElementById('navshade');if(!b||!n||!s)return;function t(){n.classList.toggle('open');s.classList.toggle('open');}b.addEventListener('click',t);s.addEventListener('click',t);}
function startClock(){var c=document.getElementById('clock');if(!c)return;function t(){var d=new Date();c.textContent=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);}t();setInterval(t,10000);}
function start(){var q=(location.search.match(/[?&]nur=([^&]+)/)||[])[1];var NUR=q?decodeURIComponent(q).split(','):null;if(NUR){document.body.classList.add('ue-embed');document.documentElement.style.background='transparent';SITES=SITES.filter(function(x){return NUR.some(function(n){return n.split('_')[1]==x.id;});});SITES.forEach(build);NUR.forEach(function(n){if(CARDS[n])document.getElementById('ue').appendChild(CARDS[n]);});SITES.forEach(function(s){if(NUR.indexOf('flow_'+s.id)>=0){flow(s);setInterval(function(){if(!document.hidden)flow(s);},5000);}if(NUR.indexOf('plan_'+s.id)>=0){plan(s);setInterval(function(){if(!document.hidden)plan(s);},60000);}});return;}initNav();startClock();SITES.forEach(build);applyLayout(loadLayout());initEdit();
  SITES.forEach(function(s){flow(s);plan(s);setInterval(function(){if(!document.hidden)flow(s);},5000);setInterval(function(){if(!document.hidden)plan(s);},60000);});}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>
<script src="ue-arrange.js?v=8"></script>

</div>
</body>
</html>
