<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes"/>
<title>E-Autos</title>
<script src="../ftui.js"></script>
<link href="../ftui.css" rel="stylesheet"/>
<link href="../themes/ftui-theme.css" rel="stylesheet"/>
<style>
:root{
  --bg:#0b0f1a; --card:#121826; --card2:#1a1f2e;
  --line:#1d2638; --txt:#e0e0e0; --dim:#8496ab;
  --cyan:#00ffff; --pv:#ffb300; --haus:#2196f3;
  --bat:#4caf50; --warm:#ff7043;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--bg);
  color:var(--txt);font-family:"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased}
body{min-height:100vh}
.sidenav{width:230px;background:#0a0e18;
  border-right:1px solid var(--line);padding:18px 0;
  position:fixed;top:0;left:0;height:100vh;z-index:20;
  transform:translateX(-100%);
  transition:transform .25s ease;
  box-shadow:0 0 30px rgba(0,0,0,.6)}
.sidenav.open{transform:translateX(0)}
.navshade{position:fixed;inset:0;background:rgba(0,0,0,.5);
  z-index:15;display:none}
.navshade.open{display:block}
.burger{background:none;border:none;color:var(--txt);
  font-size:22px;cursor:pointer;padding:4px 8px;
  line-height:1}
.sidenav .brand{color:var(--cyan);font-weight:800;
  font-size:17px;letter-spacing:1px;padding:0 20px 16px;
  border-bottom:1px solid var(--line);margin-bottom:10px}
.sidenav a{display:flex;align-items:center;gap:10px;
  padding:12px 20px;color:var(--dim);font-weight:600;
  font-size:15px;text-decoration:none;
  border-left:3px solid transparent}
.sidenav a.active{color:var(--txt);background:#0e1524;
  border-left-color:var(--cyan)}
.sidenav a:hover{color:var(--txt)}
.main{flex:1;min-width:0;padding-bottom:30px}
.headbar{display:flex;align-items:center;gap:18px;
  flex-wrap:wrap;padding:10px 20px;background:#0a0e18;
  border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:5}
.headbar .hi{display:flex;align-items:center;gap:6px;
  font-weight:700;font-size:14px}
.headbar .hi .u{color:var(--dim);font-weight:600;
  font-size:12px}
.headbar .spacer{flex:1}
.headbar .clock{font-size:18px;font-weight:800;
  color:var(--cyan)}
.wide-card{margin:24px auto;width:92%;max-width:1000px;
  background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.2);padding:20px}
.wide-card h2{margin:0 0 12px;font-size:16px;
  font-weight:700;color:var(--cyan)}
.wr-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:16px}
.wr{background:var(--card2);border-radius:10px;
  padding:14px 16px;
  box-shadow:0 0 10px rgba(255,255,255,.08)}
.wr h3{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--pv);text-transform:uppercase;
  letter-spacing:1px}
.wr.gruen h3{color:var(--bat)}
.wr.blau h3{color:var(--haus)}
.wr.warm h3{color:var(--warm)}
.kv{display:flex;align-items:baseline;gap:8px;
  padding:5px 0;border-bottom:1px solid #131c2a;
  font-size:14px}
.kv:last-child{border-bottom:none}
.kv .k{flex:1;color:var(--dim)}
.kv .v{font-weight:700;font-size:16px}
.kv .u{color:var(--dim);font-size:12px}
.stats-row{display:flex;justify-content:space-around;
  flex-wrap:wrap;gap:12px;margin-top:8px}
.stat{background:var(--card2);border-radius:8px;
  padding:10px 20px;min-width:150px;flex:1;
  box-shadow:0 0 10px rgba(255,255,255,.1);
  text-align:center}
.stat .sl{color:var(--dim);font-size:13px}
.stat .sv{font-size:20px;font-weight:800}
.stat .sv small{font-size:12px;font-weight:600;
  color:var(--dim)}
.circle-row{display:flex;justify-content:space-around;
  align-items:flex-start;flex-wrap:wrap;gap:20px;
  margin-top:26px;padding:0 12px}
.circle-card{position:relative;width:200px;height:200px;
  border-radius:50%;padding:20px;text-align:center;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:2px;
  background:radial-gradient(circle at center,
    var(--card2) 0%,var(--bg) 100%);
  box-shadow:0 0 20px rgba(0,255,255,.3)}
.circle-card.haus{margin-top:60px}
.circle-card h3{margin:0 0 4px;font-size:14px;
  font-weight:700;color:var(--cyan);
  text-transform:uppercase;letter-spacing:1px}
.circle-card .ico{font-size:38px;line-height:1}
.circle-card .val{font-size:34px;font-weight:800;
  letter-spacing:-1px}
.circle-card .val small{font-size:17px;font-weight:600;
  color:var(--dim)}
.circle-card .sub{font-size:12px;color:var(--dim)}
.circle-card.pv{border:2px solid var(--pv);
  box-shadow:0 0 20px rgba(255,179,0,.35)}
.circle-card.pv .ico{filter:drop-shadow(0 0 8px var(--pv))}
.circle-card.haus{border:2px solid var(--haus);
  box-shadow:0 0 20px rgba(33,150,243,.35)}
.circle-card.haus .ico{
  filter:drop-shadow(0 0 8px var(--haus))}
.circle-card.bat{border:2px solid #12324a}
.circle-card.bat .ico{
  filter:drop-shadow(0 0 8px var(--bat))}
.circle-card.bat .arc{position:absolute;inset:-2px;
  border-radius:50%;
  background:conic-gradient(from -90deg,
    var(--bat) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1% + 4%),
    transparent 0);
  -webkit-mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px));
  mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px))}
.wirebox{position:relative;max-width:960px;margin:0 auto}
.wires{position:absolute;inset:0;width:100%;height:300px;
  pointer-events:none;z-index:-1}
.wires path{fill:none;stroke-width:3;
  stroke-linecap:round;stroke-dasharray:10 14;
  animation:dash 1.2s linear infinite}
@keyframes dash{to{stroke-dashoffset:-24}}
@media (prefers-reduced-motion:reduce){
  .wires path{animation:none}}
.w-pv{stroke:var(--pv);
  filter:drop-shadow(0 0 4px var(--pv))}
.w-bat{stroke:var(--cyan);
  filter:drop-shadow(0 0 4px var(--cyan))}
@media (max-width:820px){
  .circle-card.haus{margin-top:0}
}
.tile-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:16px;width:94%;max-width:1100px;margin:20px auto}
.tile{background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.15);padding:16px}
.tile h2{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--cyan);text-transform:uppercase;
  letter-spacing:1px}
.tile.span2{grid-column:1/-1}
.bigval{font-size:40px;font-weight:800;
  letter-spacing:-1px;line-height:1.1}
.bigval small{font-size:18px;color:var(--dim);
  font-weight:600}
.minirow{display:flex;justify-content:space-around;
  text-align:center;margin:6px 0}
.minirow .mi .ic{font-size:26px}
.minirow .mi .mv{font-size:20px;font-weight:800}
.minirow .mi .mv small{font-size:12px;color:var(--dim)}
.minirow .mi .ml{font-size:11px;color:var(--dim)}
ftui-label{display:inline-block !important;
  width:auto !important}
.bigval,.minirow .mi .mv,.kv .v{white-space:nowrap}
</style>
</head>
<body>

<div class="navshade" id="navshade"></div>
<nav class="sidenav" id="sidenav">
  <div class="brand">SMART HOME</div>
    <a href="uebersicht.html">⚡ Übersicht</a>
    <a href="pv.html">🔆 PV-Anlage</a>
    <a href="heizung.html">♨️ Heizung live</a>
    <a href="klima.html">🔥 Heizung</a>
    <a href="ertrag.html">&#128182; Ertrag</a>
    <a href="auto.html" class="active">🚗 E-Autos</a>
    <a href="geraete.html">🛠️ Geräte</a>
    <a href="monitor.html">🛡️ Monitoring</a>
    <a href="/fhem" style="border-top:1px solid rgba(255,255,255,.1)">⚙️ FHEM</a>
</nav>

<div class="main">
  <div class="headbar">
  <style>.headbar .hi{display:flex;align-items:center;gap:5px;font-weight:700;font-size:14px;white-space:nowrap}.headbar .hi .u{color:#8496ab;font-weight:600;font-size:12px}@media(max-width:700px){.headbar .hb-opt{display:none!important}}</style>
  <button class="burger" id="burger">☰</button>
  <div class="hi" title="PV gesamt">🔆 <ftui-label [text]="di_DashWerte:PV_gesamt"></ftui-label> <span class="u">W</span></div>
  <div class="hi hb-opt" title="Hausverbrauch">🏠 <ftui-label [text]="HA_SDM630M_Nergie:Summe_Leistungsbezug_Haus_gesamt"></ftui-label> <span class="u">W</span></div>
  <div class="hi" title="Speicher SOC">🔋 <ftui-label [text]="di_DashWerte:SOC_gew"></ftui-label> <span class="u">%</span></div>
  <div class="hi" title="Netz: + Bezug / - Einspeisung">🔌 <ftui-label [text]="HA_SDM630M_Nergie:Power_Sum__W"></ftui-label> <span class="u">W</span></div>
  <div class="hi hb-opt" title="Wallbox links / rechts">🚗 <ftui-label [text]="OpenWB_Garage_links:Ladeleistung_gesamt_kW"></ftui-label> / <ftui-label [text]="OpenWB_Garage_rechts:Ladeleistung_gesamt_kW"></ftui-label> <span class="u">kW</span></div>
  <div class="spacer"></div>
  <div class="hi" title="Aussentemperatur">🌡️ <ftui-label [text]="BresserWetter:temperatur_aussen"></ftui-label> <span class="u">°C</span></div>
  <div class="clock" id="clock"></div>
</div>

<div class="wide-card">
  <h2>Wallbox links · Garage</h2>
  <div class="wr-grid">
    <div class="wr wbctl">
      <h3>Steuerung</h3>
      <div class="kv kvc"><span class="k">Modus / Phasen</span><span class="v"><ftui-label class="segsrc" [text]="openWB_Garage_links_PV_cmd:state"></ftui-label></span></div>
      <div class="seg wrap" data-src="openWB_Garage_links_PV_cmd"><button class="sbtn" data-v="pvAuto" data-cmd="set openWB_Garage_links_PV_cmd pvAuto">PV Auto</button><button class="sbtn" data-v="pvMax" data-cmd="set openWB_Garage_links_PV_cmd pvMax">PV 3P</button><button class="sbtn" data-v="pv1" data-cmd="set openWB_Garage_links_PV_cmd pv1">PV 1P</button><button class="sbtn" data-v="sofortAuto" data-cmd="set openWB_Garage_links_PV_cmd sofortAuto">Sofort Auto</button><button class="sbtn" data-v="sofortMax" data-cmd="set openWB_Garage_links_PV_cmd sofortMax">Sofort 3P</button><button class="sbtn" data-v="sofort1" data-cmd="set openWB_Garage_links_PV_cmd sofort1">Sofort 1P</button></div>
      <div class="kv kvc"><span class="k">Lademodus openWB</span><span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladepunkt_chargemode"></ftui-label></span>
        <span class="seg sm"><button class="sbtn stop" data-ask="1" data-cmd="set OpenWB_Garage_links Lademodus stop">■ Stop</button></span></div>
      <div class="kv"><span class="k">Fahrzeug-SoC / Reichweite</span><span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladepunkt_soc"></ftui-label> % · <ftui-label [text]="OpenWB_Garage_links:Ladepunkt_range"></ftui-label> km</span></div>
    </div>
    <div class="wr gruen">
      <h3>Ladung</h3>
      <div class="kv"><span class="k">Ladeleistung</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladeleistung_gesamt_kW"></ftui-label></span><span class="u">kW</span></div>
      <div class="kv"><span class="k">Ladestatus</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladepunkt_charge_state"></ftui-label></span></div>
      <div class="kv"><span class="k">Lademodus</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladepunkt_chargemode"></ftui-label></span></div>
      <div class="kv"><span class="k">Soll-Ladestrom</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladepunkt_Soll_Ladestrom"></ftui-label></span><span class="u">A</span></div>
      <div class="kv"><span class="k">Ist-Ladestrom L1</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladestrom_L1"></ftui-label></span><span class="u">A</span></div>
      <div class="kv"><span class="k">Phasen in Nutzung</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladepunkt_Anzahl_Phasen"></ftui-label></span></div>
    </div>
    <div class="wr gruen">
      <h3>Fahrzeug &amp; Phasen</h3>
      <div class="kv"><span class="k">Fahrzeug</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladepunkt_vehicle_name"></ftui-label></span></div>
      <div class="kv"><span class="k">Angesteckt</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladepunkt_plug_state"></ftui-label></span></div>
      <div class="kv"><span class="k">L1</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladeleistung_L1_kW"></ftui-label></span><span class="u">kW</span></div>
      <div class="kv"><span class="k">L2</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladeleistung_L2_kW"></ftui-label></span><span class="u">kW</span></div>
      <div class="kv"><span class="k">L3</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladeleistung_L3_kW"></ftui-label></span><span class="u">kW</span></div>
    </div>
    <div class="wr gruen">
      <h3>Energie</h3>
      <div class="kv"><span class="k">Geladen heute</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladepunkt_daily_imported_kWh"></ftui-label></span><span class="u">kWh</span></div>
      <div class="kv"><span class="k">Geladen gesamt</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_links:Ladepunkt_imported_total_kWh"></ftui-label></span><span class="u">kWh</span></div>
    </div>
  </div>
</div>

<div class="wide-card">
  <h2>Wallbox rechts · Garage</h2>
  <div class="wr-grid">
    <div class="wr wbctl">
      <h3>Steuerung</h3>
      <div class="kv kvc"><span class="k">Modus / Phasen</span><span class="v"><ftui-label class="segsrc" [text]="openWB_Garage_rechts_PV_cmd:state"></ftui-label></span></div>
      <div class="seg wrap" data-src="openWB_Garage_rechts_PV_cmd"><button class="sbtn" data-v="pvAuto" data-cmd="set openWB_Garage_rechts_PV_cmd pvAuto">PV Auto</button><button class="sbtn" data-v="pvMax" data-cmd="set openWB_Garage_rechts_PV_cmd pvMax">PV 3P</button><button class="sbtn" data-v="pv1" data-cmd="set openWB_Garage_rechts_PV_cmd pv1">PV 1P</button><button class="sbtn" data-v="sofortAuto" data-cmd="set openWB_Garage_rechts_PV_cmd sofortAuto">Sofort Auto</button><button class="sbtn" data-v="sofortMax" data-cmd="set openWB_Garage_rechts_PV_cmd sofortMax">Sofort 3P</button><button class="sbtn" data-v="sofort1" data-cmd="set openWB_Garage_rechts_PV_cmd sofort1">Sofort 1P</button></div>
      <div class="kv kvc"><span class="k">Lademodus openWB</span><span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladepunkt_chargemode"></ftui-label></span>
        <span class="seg sm"><button class="sbtn stop" data-ask="1" data-cmd="set OpenWB_Garage_rechts Lademodus stop">■ Stop</button></span></div>
      <div class="kv"><span class="k">Fahrzeug-SoC / Reichweite</span><span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladepunkt_soc"></ftui-label> % · <ftui-label [text]="OpenWB_Garage_rechts:Ladepunkt_range"></ftui-label> km</span></div>
    </div>
    <div class="wr gruen">
      <h3>Ladung</h3>
      <div class="kv"><span class="k">Ladeleistung</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladeleistung_gesamt_kW"></ftui-label></span><span class="u">kW</span></div>
      <div class="kv"><span class="k">Ladestatus</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladepunkt_charge_state"></ftui-label></span></div>
      <div class="kv"><span class="k">Lademodus</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladepunkt_chargemode"></ftui-label></span></div>
      <div class="kv"><span class="k">Soll-Ladestrom</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladepunkt_Soll_Ladestrom"></ftui-label></span><span class="u">A</span></div>
      <div class="kv"><span class="k">Ist-Ladestrom L1</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladestrom_L1"></ftui-label></span><span class="u">A</span></div>
      <div class="kv"><span class="k">Phasen in Nutzung</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladepunkt_Anzahl_Phasen"></ftui-label></span></div>
    </div>
    <div class="wr gruen">
      <h3>Fahrzeug &amp; Phasen</h3>
      <div class="kv"><span class="k">Fahrzeug</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladepunkt_vehicle_name"></ftui-label></span></div>
      <div class="kv"><span class="k">Angesteckt</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladepunkt_plug_state"></ftui-label></span></div>
      <div class="kv"><span class="k">L1</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladeleistung_L1_kW"></ftui-label></span><span class="u">kW</span></div>
      <div class="kv"><span class="k">L2</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladeleistung_L2_kW"></ftui-label></span><span class="u">kW</span></div>
      <div class="kv"><span class="k">L3</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladeleistung_L3_kW"></ftui-label></span><span class="u">kW</span></div>
    </div>
    <div class="wr gruen">
      <h3>Energie</h3>
      <div class="kv"><span class="k">Geladen heute</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladepunkt_daily_imported_kWh"></ftui-label></span><span class="u">kWh</span></div>
      <div class="kv"><span class="k">Geladen gesamt</span>
        <span class="v"><ftui-label [text]="OpenWB_Garage_rechts:Ladepunkt_imported_total_kWh"></ftui-label></span><span class="u">kWh</span></div>
    </div>
  </div>
</div>


</div>

<script>

function startClock(){
  var c=document.getElementById('clock');
  function t(){var d=new Date();
    c.textContent=('0'+d.getHours()).slice(-2)+':'+
      ('0'+d.getMinutes()).slice(-2);}
  t();setInterval(t,10000);
}
function initNav(){
  var b=document.getElementById('burger');
  var n=document.getElementById('sidenav');
  var s=document.getElementById('navshade');
  function t(){n.classList.toggle('open');
    s.classList.toggle('open');}
  b.addEventListener('click', t);
  s.addEventListener('click', t);
}
window.addEventListener('load', function(){
  initNav();
  startClock();
  setTimeout(function(){
    document.dispatchEvent(
      new Event('ftuiVisibilityChanged'));
  }, 2000);
});


</script>

<style>
.wr.wbctl{grid-column:1/-1}
.seg{display:flex;justify-content:flex-end;margin:0 0 6px}
.seg.wrap{flex-wrap:wrap;justify-content:flex-start;gap:6px;margin:6px 0 10px}
.seg .sbtn{background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.14);color:#e0e0e0;font:600 13px "Segoe UI",sans-serif;padding:7px 12px;border-radius:13px;cursor:pointer;min-width:44px}
.seg .sbtn:hover{border-color:rgba(34,211,238,.6)}
.seg .sbtn:active{transform:scale(.94)}
.seg .sbtn.akt{background:linear-gradient(180deg,rgba(34,211,238,.45),rgba(34,211,238,.15));border-color:#22d3ee;color:#fff;box-shadow:0 0 10px rgba(34,211,238,.35)}
.seg .sbtn.stop{border-color:rgba(255,93,115,.5)}
.seg .sbtn.ok{background:rgba(74,222,128,.35)} .seg .sbtn.err{background:rgba(255,93,115,.4)}
.seg.sm{margin:0 0 0 8px;display:inline-flex}
@media(max-width:700px){.seg.wrap .sbtn{flex:1 1 30%;padding:9px 4px}}
</style>
<script>
(function(){
function mark(){[].forEach.call(document.querySelectorAll('.seg[data-src]'),function(g){
  var card=g.closest('.wbctl'),l=card&&card.querySelector('.segsrc'),v=l?(l.textContent||'').trim():'';
  [].forEach.call(g.querySelectorAll('.sbtn'),function(b){b.classList.toggle('akt',b.getAttribute('data-v')==v);});});}
document.addEventListener('click',async function(e){
  var b=e.target.closest('.wbctl .sbtn');if(!b)return;
  var c=b.getAttribute('data-cmd');if(b.hasAttribute('data-ask')&&!confirm(c+' ausführen?'))return;
  try{var r=await fetch('/fhem?XHR=1',{cache:'no-store'});var t=r.headers.get('X-FHEM-csrfToken')||'';
    var x=await fetch('/fhem?cmd='+encodeURIComponent(c)+'&XHR=1&fwcsrf='+encodeURIComponent(t),{cache:'no-store'});
    var m=(await x.text()).trim();b.classList.add(x.ok&&!m?'ok':'err');if(m)console.warn(c,m);}
  catch(err){b.classList.add('err');}
  setTimeout(function(){b.classList.remove('ok','err');mark();},1200);});
window.addEventListener('load',function(){mark();
  [].forEach.call(document.querySelectorAll('.wbctl .segsrc'),function(l){new MutationObserver(mark).observe(l,{childList:true,subtree:true,characterData:true});});
  setInterval(mark,5000);});
})();
</script>
<script src="ue-arrange.js?v=10"></script>
</body>
</html>
