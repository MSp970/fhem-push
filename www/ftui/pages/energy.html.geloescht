  <div class="tile span2">
    <h2>Tagesdiagramm</h2>
    <ftui-chart type="line" unit="day" height="240"
      y-min="0" y-label="W">
      <ftui-chart-data
        log="FileLog_Elektrische_Wirkleistungen_Haus_PV_WP"
        spec="4:HA_SDM630M_PV_Erzeugung.Power_Sum__W1"
        label="PV" fill point-radius="0" tension="0.3"
        border-color="#ffb300"
        background-color="rgba(255,179,0,0.25)">
      </ftui-chart-data>
      <ftui-chart-data
        log="FileLog_Elektrische_Wirkleistungen_Haus_PV_WP"
        spec="4:HA_SDM630M_Allgemein.Power_Sum__W1"
        label="Haus" fill point-radius="0" tension="0.3"
        border-color="#2196f3"
        background-color="rgba(33,150,243,0.25)">
      </ftui-chart-data>
    </ftui-chart>
  </div>

</div>

</div>

<script>

function startClock(){
  var c=document.getElementById('clock');
  function t(){var d=new Date();
    c.textContent=('0'+d.getHours()).slice(-2)+':'+
      ('0'+d.getMinutes()).slice(-2);}
  t();setInterval(t,10000);
}
function initNav(){
  var b=document.getElementById('burger');
  var n=document.getElementById('sidenav');
  var s=document.getElementById('navshade');
  function t(){n.classList.toggle('open');
    s.classList.toggle('open');}
  b.addEventListener('click', t);
  s.addEventListener('click', t);
}
window.addEventListener('load', function(){
  initNav();
  startClock();
  setTimeout(function(){
    document.dispatchEvent(
      new Event('ftuiVisibilityChanged'));
  }, 2000);
});


function mapWx(t){
  t=(t||'').toLowerCase();
  if(t.indexOf('gewitter')>=0) return '⛈️';
  if(t.indexOf('schnee')>=0||t.indexOf('graupel')>=0)
    return '🌨️';
  if(t.indexOf('regen')>=0||t.indexOf('schauer')>=0||
     t.indexOf('niesel')>=0||t.indexOf('sprüh')>=0)
    return '🌧️';
  if(t.indexOf('nebel')>=0||t.indexOf('dunst')>=0)
    return '🌫️';
  if(t.indexOf('bedeckt')>=0||t.indexOf('tr\u00fcb')>=0)
    return '☁️';
  if(t.indexOf('wolk')>=0||t.indexOf('bew\u00f6lk')>=0)
    return '⛅';
  if(t.indexOf('heiter')>=0||t.indexOf('klar')>=0||
     t.indexOf('sonnig')>=0) return '☀️';
  return '🌡️';
}
function bindWx(src,dst){
  var l=document.getElementById(src);
  var i=document.getElementById(dst);
  function u(){
    i.textContent=mapWx(l.getAttribute('text'));}
  new MutationObserver(u).observe(l,
    {attributes:true,attributeFilter:['text']});
  setInterval(u,30000); u();
}
bindWx('wxt','wxicon');
bindWx('wxt2','wxicon2');

function bindFlash(){
  var l=document.getElementById('flwarn');
  var v=document.getElementById('flwarnv');
  var t=document.getElementById('flashtile');
  function u(){
    var s=(l.getAttribute('text')||'').trim();
    var ok=(s==='ok');
    var leer=(s==='');
    v.style.color=leer?'var(--dim)':
      (ok?'var(--bat)':'#ff4040');
    t.style.boxShadow=(!leer&&!ok)?
      '0 0 18px rgba(255,64,64,.7)':'';
  }
  new MutationObserver(u).observe(l,
    {attributes:true,attributeFilter:['text']});
  setInterval(u,30000); u();
}
bindFlash();

function bindWrLed(){
  var W=['5877','5876'];
  function v(k,r){var l=document.getElementById('wv_'+k+'_'+r);
    return l?((l.getAttribute('text')||'').trim()):'';}
  function n(k,r){var x=parseFloat(v(k,r));return isNaN(x)?null:x;}
  function led(k,c,s,col){var e=document.getElementById('led_'+k+'_'+c);
    if(!e)return;e.setAttribute('class','led'+(s?' '+s:''));
    e.style.setProperty('--lc',col||'#4caf50');}
  function u(){W.forEach(function(k){
    var wm=v(k,'Work_Mode').toLowerCase();
    var gm=v(k,'Grid_Mode').toLowerCase();
    var ak=v(k,'Akku_State').toLowerCase();
    var soc=n(k,'SOC');
    var er=v(k,'Error').toLowerCase();
    var mt=v(k,'Meter_communicate_Status').toLowerCase();
    var bm=v(k,'BMS_Status').toLowerCase();
    var pm=n(k,'MTTotalActivepower');
    if(wm===''){['sys','bup','bat','grid','en','com','flt'].forEach(function(c){led(k,c,'');});return;}
    var run=(wm.indexOf('on-grid')>=0||wm.indexOf('off-grid')>=0);
    led(k,'sys',run?'on':((wm.indexOf('check')>=0||wm.indexOf('wait')>=0)?'b1':''));
    led(k,'bup',run?'on':'');
    var bs='';
    if(ak.indexOf('discharg')>=0) bs='b1';
    else if(ak.indexOf('charg')>=0) bs='on';
    if(soc!==null&&soc<=10&&ak.indexOf('no battery')<0) bs='b2';
    led(k,'bat',bs);
    var gok=gm.indexOf('ok')>=0;
    led(k,'grid',gok?'on':(gm.indexOf('fault')>=0?'b1':''));
    var es='';
    if(gok&&pm!==null){var H=window.__es||(window.__es={});var pe=H[k]||'b1';es=pe;if(pe==='b2'){if(pm<30)es=(pm<-60)?'on':'b1';}else if(pe==='on'){if(pm>-30)es=(pm>60)?'b2':'b1';}else{if(pm>60)es='b2';else if(pm<-60)es='on';}H[k]=es;}
    led(k,'en',es);
    var mok=mt.indexOf('ok')>=0, bok=bm.indexOf('ok')>=0;
    led(k,'com',(mok&&bok)?'on':(mok?'b1':(bok?'b2':'')));
    led(k,'flt',(er!==''&&er.indexOf('no error')<0)?'on':'','#ff4040');
    var inf=document.getElementById('inf_'+k);
    if(inf) inf.textContent=(v(k,'EMSPowerModeText')||'–')+' · '+
      (soc!==null?soc+' %':'–')+' · '+(v(k,'Power_Battery')||'–')+' W';
    var sb=document.getElementById('socbar_'+k);
    if(sb&&soc!==null) sb.setAttribute('width',Math.max(0,Math.min(118,1.18*soc)));
  });}
  W.forEach(function(k){
    document.querySelectorAll('[id^="wv_'+k+'_"]').forEach(function(l){
      new MutationObserver(u).observe(l,
        {attributes:true,attributeFilter:['text']});});});
  setInterval(u,15000); u();
}
bindWrLed();


</script>

<script src="ue-arrange.js?v=10"></script>
</body>
</html>
