      <ftui-label id="wv_5876_Akku_State" [text]="GoodWe_Haus_Ost_Mitte_5876:Akku_State"></ftui-label>
      <ftui-label id="wv_5876_SOC" [text]="GoodWe_Haus_Ost_Mitte_5876:SOC"></ftui-label>
      <ftui-label id="wv_5876_Error" [text]="GoodWe_Haus_Ost_Mitte_5876:Error"></ftui-label>
      <ftui-label id="wv_5876_Meter_communicate_Status" [text]="GoodWe_Haus_Ost_Mitte_5876:Meter_communicate_Status"></ftui-label>
      <ftui-label id="wv_5876_BMS_Status" [text]="GoodWe_Haus_Ost_Mitte_5876:BMS_Status"></ftui-label>
