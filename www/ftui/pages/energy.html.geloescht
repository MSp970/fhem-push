<rect x="6" y="40" width="12" height="10" rx="2" class="fin"/><rect x="202" y="40" width="12" height="10" rx="2" class="fin"/><rect x="6" y="62" width="12" height="10" rx="2" class="fin"/><rect x="202" y="62" width="12" height="10" rx="2" class="fin"/><rect x="6" y="84" width="12" height="10" rx="2" class="fin"/><rect x="202" y="84" width="12" height="10" rx="2" class="fin"/><rect x="6" y="106" width="12" height="10" rx="2" class="fin"/><rect x="202" y="106" width="12" height="10" rx="2" class="fin"/><rect x="6" y="128" width="12" height="10" rx="2" class="fin"/><rect x="202" y="128" width="12" height="10" rx="2" class="fin"/><rect x="6" y="150" width="12" height="10" rx="2" class="fin"/><rect x="202" y="150" width="12" height="10" rx="2" class="fin"/><rect x="6" y="172" width="12" height="10" rx="2" class="fin"/><rect x="202" y="172" width="12" height="10" rx="2" class="fin"/><rect x="6" y="194" width="12" height="10" rx="2" class="fin"/><rect x="202" y="194" width="12" height="10" rx="2" class="fin"/><rect x="6" y="216" width="12" height="10" rx="2" class="fin"/><rect x="202" y="216" width="12" height="10" rx="2" class="fin"/><rect x="6" y="238" width="12" height="10" rx="2" class="fin"/><rect x="202" y="238" width="12" height="10" rx="2" class="fin"/>
