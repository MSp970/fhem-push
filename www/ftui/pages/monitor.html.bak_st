<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes"/>
<title>Monitoring</title>
<script src="../ftui.js"></script>
<link href="../ftui.css" rel="stylesheet"/>
<link href="../themes/ftui-theme.css" rel="stylesheet"/>
<style>
:root{
  --bg:#0b0f1a; --card:#121826; --card2:#1a1f2e;
  --line:#1d2638; --txt:#e0e0e0; --dim:#8496ab;
  --cyan:#00ffff; --pv:#ffb300; --haus:#2196f3;
  --bat:#4caf50; --warm:#ff7043;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--bg);
  color:var(--txt);font-family:"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased}
body{min-height:100vh}
.sidenav{width:230px;background:#0a0e18;
  border-right:1px solid var(--line);padding:18px 0;
  position:fixed;top:0;left:0;height:100vh;z-index:20;
  transform:translateX(-100%);
  transition:transform .25s ease;
  box-shadow:0 0 30px rgba(0,0,0,.6)}
.sidenav.open{transform:translateX(0)}
.navshade{position:fixed;inset:0;background:rgba(0,0,0,.5);
  z-index:15;display:none}
.navshade.open{display:block}
.burger{background:none;border:none;color:var(--txt);
  font-size:22px;cursor:pointer;padding:4px 8px;
  line-height:1}
.sidenav .brand{color:var(--cyan);font-weight:800;
  font-size:17px;letter-spacing:1px;padding:0 20px 16px;
  border-bottom:1px solid var(--line);margin-bottom:10px}
.sidenav a{display:flex;align-items:center;gap:10px;
  padding:12px 20px;color:var(--dim);font-weight:600;
  font-size:15px;text-decoration:none;
  border-left:3px solid transparent}
.sidenav a.active{color:var(--txt);background:#0e1524;
  border-left-color:var(--cyan)}
.sidenav a:hover{color:var(--txt)}
.main{flex:1;min-width:0;padding-bottom:30px}
.headbar{display:flex;align-items:center;gap:18px;
  flex-wrap:wrap;padding:10px 20px;background:#0a0e18;
  border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:5}
.headbar .hi{display:flex;align-items:center;gap:6px;
  font-weight:700;font-size:14px}
.headbar .hi .u{color:var(--dim);font-weight:600;
  font-size:12px}
.headbar .spacer{flex:1}
.headbar .clock{font-size:18px;font-weight:800;
  color:var(--cyan)}
.wide-card{margin:24px auto;width:92%;max-width:1000px;
  background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.2);padding:20px}
.wide-card h2{margin:0 0 12px;font-size:16px;
  font-weight:700;color:var(--cyan)}
.wr-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:16px}
.wr{background:var(--card2);border-radius:10px;
  padding:14px 16px;
  box-shadow:0 0 10px rgba(255,255,255,.08)}
.wr h3{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--pv);text-transform:uppercase;
  letter-spacing:1px}
.wr.gruen h3{color:var(--bat)}
.wr.blau h3{color:var(--haus)}
.wr.warm h3{color:var(--warm)}
.kv{display:flex;align-items:baseline;gap:8px;
  padding:5px 0;border-bottom:1px solid #131c2a;
  font-size:14px}
.kv:last-child{border-bottom:none}
.kv .k{flex:1;color:var(--dim)}
.kv .v{font-weight:700;font-size:16px}
.kv .u{color:var(--dim);font-size:12px}
.stats-row{display:flex;justify-content:space-around;
  flex-wrap:wrap;gap:12px;margin-top:8px}
.stat{background:var(--card2);border-radius:8px;
  padding:10px 20px;min-width:150px;flex:1;
  box-shadow:0 0 10px rgba(255,255,255,.1);
  text-align:center}
.stat .sl{color:var(--dim);font-size:13px}
.stat .sv{font-size:20px;font-weight:800}
.stat .sv small{font-size:12px;font-weight:600;
  color:var(--dim)}
.circle-row{display:flex;justify-content:space-around;
  align-items:flex-start;flex-wrap:wrap;gap:20px;
  margin-top:26px;padding:0 12px}
.circle-card{position:relative;width:200px;height:200px;
  border-radius:50%;padding:20px;text-align:center;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:2px;
  background:radial-gradient(circle at center,
    var(--card2) 0%,var(--bg) 100%);
  box-shadow:0 0 20px rgba(0,255,255,.3)}
.circle-card.haus{margin-top:60px}
.circle-card h3{margin:0 0 4px;font-size:14px;
  font-weight:700;color:var(--cyan);
  text-transform:uppercase;letter-spacing:1px}
.circle-card .ico{font-size:38px;line-height:1}
.circle-card .val{font-size:34px;font-weight:800;
  letter-spacing:-1px}
.circle-card .val small{font-size:17px;font-weight:600;
  color:var(--dim)}
.circle-card .sub{font-size:12px;color:var(--dim)}
.circle-card.pv{border:2px solid var(--pv);
  box-shadow:0 0 20px rgba(255,179,0,.35)}
.circle-card.pv .ico{filter:drop-shadow(0 0 8px var(--pv))}
.circle-card.haus{border:2px solid var(--haus);
  box-shadow:0 0 20px rgba(33,150,243,.35)}
.circle-card.haus .ico{
  filter:drop-shadow(0 0 8px var(--haus))}
.circle-card.bat{border:2px solid #12324a}
.circle-card.bat .ico{
  filter:drop-shadow(0 0 8px var(--bat))}
.circle-card.bat .arc{position:absolute;inset:-2px;
  border-radius:50%;
  background:conic-gradient(from -90deg,
    var(--bat) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1% + 4%),
    transparent 0);
  -webkit-mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px));
  mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px))}
.wirebox{position:relative;max-width:960px;margin:0 auto}
.wires{position:absolute;inset:0;width:100%;height:300px;
  pointer-events:none;z-index:-1}
.wires path{fill:none;stroke-width:3;
  stroke-linecap:round;stroke-dasharray:10 14;
  animation:dash 1.2s linear infinite}
@keyframes dash{to{stroke-dashoffset:-24}}
@media (prefers-reduced-motion:reduce){
  .wires path{animation:none}}
.w-pv{stroke:var(--pv);
  filter:drop-shadow(0 0 4px var(--pv))}
.w-bat{stroke:var(--cyan);
  filter:drop-shadow(0 0 4px var(--cyan))}
@media (max-width:820px){
  .circle-card.haus{margin-top:0}
}
.tile-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:16px;width:94%;max-width:1100px;margin:20px auto}
.tile{background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.15);padding:16px}
.tile h2{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--cyan);text-transform:uppercase;
  letter-spacing:1px}
.tile.span2{grid-column:1/-1}
.bigval{font-size:40px;font-weight:800;
  letter-spacing:-1px;line-height:1.1}
.bigval{display:flex;justify-content:center;align-items:baseline;column-gap:9px}
.bigval ftui-label{display:inline-flex}
.bigval small{font-size:18px;color:var(--dim);
  font-weight:600}
.minirow{display:flex;justify-content:space-around;
  text-align:center;margin:6px 0}
.minirow .mi .ic{font-size:26px}
.minirow .mi .mv{font-size:20px;font-weight:800}
.minirow .mi .mv small{font-size:12px;color:var(--dim)}
.minirow .mi .ml{font-size:11px;color:var(--dim)}
.kv .v{white-space:nowrap}
.kv .v ftui-label{display:inline}
.wrled-row{display:flex;justify-content:space-around;flex-wrap:wrap;gap:12px}
.wrled{flex:1;min-width:180px;max-width:260px}
.wrsvg{width:100%;height:auto;display:block}
.wrsvg .fin{fill:#222a3b;stroke:#303b52}
.wrsvg .panel{fill:#0b0f1a;stroke:#27324a}
.wrsvg .wrt{fill:#00ffff;font-weight:800;font-size:15px;letter-spacing:1px}
.wrsvg .wrs{fill:#8496ab;font-size:9px;letter-spacing:.5px}
.wrsvg .wri{fill:#e0e0e0;font-size:10px;font-weight:600}
.wrsvg .ledt{fill:#8496ab;font-size:10px;font-weight:700;letter-spacing:1px}
.wrsvg .led{fill:#262e3f;stroke:#39455f;stroke-width:1}
.wrsvg .led.on,.wrsvg .led.b1,.wrsvg .led.b2{fill:var(--lc,#4caf50);filter:drop-shadow(0 0 5px var(--lc,#4caf50))}
.wrsvg .led.b1{animation:ledbl 1.6s steps(1) infinite}
.wrsvg .led.b2{animation:ledbl .5s steps(1) infinite}
@keyframes ledbl{50%{fill:#262e3f;filter:none}}
@media (prefers-reduced-motion:reduce){.wrsvg .led.b1,.wrsvg .led.b2{animation:none;opacity:.6}}
.wrled-leg{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-top:8px;font-size:11px;color:var(--dim)}
.wrled-leg span{display:flex;align-items:center;gap:5px}
.wrled-leg .lg{display:inline-block;width:9px;height:9px;border-radius:50%;background:#262e3f;border:1px solid #39455f}
.wrled-leg .lg.on,.wrled-leg .lg.b1,.wrled-leg .lg.b2{background:#4caf50;box-shadow:0 0 5px #4caf50}
.wrled-leg .lg.b1{animation:lgbl 1.6s steps(1) infinite}
.wrled-leg .lg.b2{animation:lgbl .5s steps(1) infinite}
@keyframes lgbl{50%{background:#262e3f;box-shadow:none}}
</style>
</head>
<body>

<div class="navshade" id="navshade"></div>
<nav class="sidenav" id="sidenav">
  <div class="brand">SMART HOME</div>
    <a href="uebersicht.html">⚡ Übersicht</a>
    <a href="pv.html">🔆 PV-Anlage</a>
    <a href="heizung.html">♨️ Heizung live</a>
    <a href="klima.html">🔥 Heizung</a>
    <a href="ertrag.html">&#128182; Ertrag</a>
    <a href="auto.html">🚗 E-Autos</a>
  <a href="tobi.html">👤 Tobi</a>
    <a href="geraete.html">🛠️ Geräte</a>
    <a href="monitor.html" class="active">🛡️ Monitoring</a>
    <a href="/fhem" style="border-top:1px solid rgba(255,255,255,.1)">⚙️ FHEM</a>
</nav>

<div class="main">
  <div class="headbar">
  <style>.headbar .hi{display:flex;align-items:center;gap:5px;font-weight:700;font-size:14px;white-space:nowrap}.headbar .hi .u{color:#8496ab;font-weight:600;font-size:12px}@media(max-width:700px){.headbar .hb-opt{display:none!important}}</style>
  <button class="burger" id="burger">☰</button>
  <div class="hi" title="PV gesamt">🔆 <ftui-label [text]="di_DashWerte:PV_gesamt"></ftui-label> <span class="u">W</span></div>
  <div class="hi hb-opt" title="Hausverbrauch">🏠 <ftui-label [text]="HA_SDM630M_Nergie:Summe_Leistungsbezug_Haus_gesamt"></ftui-label> <span class="u">W</span></div>
  <div class="hi" title="Speicher SOC">🔋 <ftui-label [text]="di_DashWerte:SOC_gew"></ftui-label> <span class="u">%</span></div>
  <div class="hi" title="Netz: + Bezug / - Einspeisung">🔌 <ftui-label [text]="HA_SDM630M_Nergie:Power_Sum__W"></ftui-label> <span class="u">W</span></div>
  <div class="hi hb-opt" title="Wallbox links / rechts">🚗 <ftui-label [text]="OpenWB_Garage_links:Ladeleistung_gesamt_kW"></ftui-label> / <ftui-label [text]="OpenWB_Garage_rechts:Ladeleistung_gesamt_kW"></ftui-label> <span class="u">kW</span></div>
  <div class="spacer"></div>
  <div class="hi" title="Aussentemperatur">🌡️ <ftui-label [text]="BresserWetter:temperatur_aussen"></ftui-label> <span class="u">°C</span></div>
  <div class="clock" id="clock"></div>
</div>

<style>
.mo-wrap{width:94%;max-width:1400px;margin:14px auto 24px}
.mo-top{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.mo-tab{background:#161e2e;border:1px solid #1f2a3e;color:#9fb0c5;font-size:13px;padding:6px 14px;border-radius:99px;cursor:pointer;font-family:inherit}
.mo-tab.on{color:#0b0f1a;background:#22d3ee;border-color:#22d3ee;font-weight:700}
.mo-upd{margin-left:auto;font-size:11px;color:#6b7c93}
.mo-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:14px}
.mo-kpi{background:linear-gradient(160deg,#141b2b,#0f1522);border:1px solid #1d2638;border-radius:16px;padding:14px 16px}
.mo-kpi .l{font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:#6b7c93}
.mo-kpi .v{font-size:28px;font-weight:800;margin-top:4px;font-variant-numeric:tabular-nums}
.mo-kpi .s{font-size:11px;color:#8496ab;margin-top:2px}
.mo-card{background:linear-gradient(160deg,#141b2b,#0f1522);border:1px solid #1d2638;border-radius:18px;padding:14px 16px;margin-bottom:14px}
.mo-card h2{margin:0 0 10px;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:var(--cyan,#0ff)}
.mo-chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.mo-chip{font-size:11px;color:#9fb0c5;background:#161e2e;border:1px solid #1f2a3e;padding:4px 10px;border-radius:99px;cursor:pointer;user-select:none}
.mo-chip.on{color:#22d3ee;border-color:rgba(34,211,238,.5);background:rgba(34,211,238,.08)}
.mo-day{font-size:11px;color:#6b7c93;letter-spacing:1px;text-transform:uppercase;margin:12px 0 4px;padding-bottom:4px;border-bottom:1px solid #1b2437}
.mo-row{display:grid;grid-template-columns:72px 18px 110px 1fr auto;gap:10px;align-items:center;padding:7px 6px;border-radius:10px;cursor:pointer;font-size:13px}
.mo-row:hover{background:rgba(255,255,255,.03)}
.mo-row .t{font-variant-numeric:tabular-nums;color:#b7c3d3;font-size:12px}
.mo-row .d{width:10px;height:10px;border-radius:50%}
.mo-row .k{font-size:11px;color:#8496ab;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mo-row .x{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#e8eef6}
.mo-row .x small{color:#8496ab;margin-left:6px}
.mo-row .b{font-size:11px;padding:2px 8px;border-radius:99px;white-space:nowrap}
.b-open{background:rgba(248,113,113,.14);color:#f87171}.b-ok{background:rgba(74,222,128,.1);color:#4ade80}.b-n{background:#1a2336;color:#9fb0c5}
.mo-det{display:none;margin:0 6px 8px 100px;padding:8px 12px;background:#0d1320;border:1px solid #1b2437;border-radius:10px;font-size:12px;color:#b7c3d3}
.mo-det.on{display:block}
.mo-det div{padding:2px 0;font-variant-numeric:tabular-nums}
.mo-det i{font-style:normal;color:#6b7c93;margin-right:8px}
.mo-empty{color:#6b7c93;font-size:13px;padding:10px 4px}
.mo-more{margin:10px auto 0;display:block}
.mo-lz svg{width:100%;height:auto;display:block}
@media(max-width:700px){.mo-row{grid-template-columns:58px 12px 1fr auto}.mo-row .k{display:none}.mo-det{margin-left:6px}}
.mo-embed .headbar,.mo-embed .sidenav,.mo-embed .navshade{display:none!important}.mo-embed .mo-wrap{width:100%;margin:0}
</style>
<div class="mo-wrap">
  <div class="mo-top" id="mo_tabs"></div>
  <div class="mo-kpis" id="mo_kpis"></div>
  <div class="mo-card"><h2>Offene Meldungen</h2><div id="mo_open"></div></div>
  <div class="mo-card mo-lz"><h2>Laufzeiten letzte 7 Tage</h2><div id="mo_lz"></div></div>
  <div class="mo-card"><h2>Ereignisse letzte 7 Tage</h2><div class="mo-chips" id="mo_f"></div><div id="mo_list"></div></div>
</div>
<script>
(function(){
var SITES=[{id:'g',name:'Große Anlage',base:'http://192.168.176.205:8084'},{id:'k',name:'S9',base:'http://192.168.178.21:8084'}];
var cur=(/^192\.168\.178\./.test(location.hostname))?'k':'g',DATA={},F={sev:'alle',kat:'alle'},LIM=150;
var SEV={E:['#f87171','Fehler'],W:['#fbbf24','Warnung'],I:['#60a5fa','Info']};
function nice(s){return String(s==null?'':s).replace(/Waermepumpe/g,'Wärmepumpe').replace(/\bfuer\b/g,'für').replace(/ueber/g,'über').replace(/naechtl/g,'nächtl').replace(/stuendl/g,'stündl');}
function esc(s){s=nice(s);return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function hms(t){var d=new Date(t*1000);return ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'+('0'+d.getSeconds()).slice(-2);}
function day(t){var d=new Date(t*1000),n=new Date(),y=new Date(n-86400000);var k=d.toDateString();if(k==n.toDateString())return 'Heute';if(k==y.toDateString())return 'Gestern';return ['So','Mo','Di','Mi','Do','Fr','Sa'][d.getDay()]+' '+d.getDate()+'.'+(d.getMonth()+1)+'.';}
function dur(s){s=Math.round(s);if(s>=3600)return Math.floor(s/3600)+'h'+('0'+Math.floor(s%3600/60)).slice(-2);return Math.round(s/60)+' min';}
function req(s,cmd){
  var go=function(){return fetch(s.base+'/fhem?cmd='+encodeURIComponent(cmd)+'&XHR=1&fwcsrf='+encodeURIComponent(s.tok||''),{cache:'no-store'}).then(function(r){if(!r.ok)throw r.status;return r.text();});};
  var tk=function(){return fetch(s.base+'/fhem?XHR=1',{cache:'no-store'}).then(function(r){s.tok=r.headers.get('X-FHEM-csrfToken')||'';});};
  return (s.tok===undefined?tk().then(go):go()).catch(function(){return tk().then(go);});
}
function load(){
  var s=SITES.filter(function(x){return x.id==cur;})[0];
  return Promise.all([req(s,'{Mon_JSON(7)}'),req(s,'jsonlist2 Monitor')]).then(function(r){
    var j;try{j=JSON.parse(r[0]);}catch(e){throw 'Monitor-Modul fehlt ('+r[0].slice(0,80)+')';}
    var m={};try{m=JSON.parse(r[1]).Results[0].Readings;}catch(e){}
    DATA[cur]={j:j,m:m,t:Date.now()};render();
  }).catch(function(e){document.getElementById('mo_list').innerHTML='<div class="mo-empty" style="color:#f87171">Nicht abrufbar: '+esc(e)+'</div>';});
}
function tabs(){
  document.getElementById('mo_tabs').innerHTML=SITES.map(function(s){return '<button class="mo-tab'+(s.id==cur?' on':'')+'" data-s="'+s.id+'">'+s.name+'</button>';}).join('')+'<span class="mo-upd" id="mo_upd"></span>';
}
function render(){
  var D=DATA[cur];if(!D)return;var ev=D.j.ev||[],now=D.j.now;
  var open=ev.filter(function(e){return e.offen;}),ne=open.filter(function(e){return e.sev=='E';}).length,nw=open.filter(function(e){return e.sev=='W';}).length;
  var komm=open.filter(function(e){return e.key=='KOMM';})[0],kq=komm?Object.keys(komm.akt||{}).length:0;
  var wp=parseFloat((D.m.lz_heute_WP||{}).Value||0);
  var t24=ev.filter(function(e){return e.tl>now-86400;}).length;
  function kpi(l,v,s,c){return '<div class="mo-kpi"><div class="l">'+l+'</div><div class="v" style="color:'+c+'">'+v+'</div><div class="s">'+s+'</div></div>';}
  document.getElementById('mo_kpis').innerHTML=
    kpi('Status',ne?'Fehler':(nw?'Warnung':'OK'),(D.m.letzte_meldung||{}).Value||'keine Meldung',ne?'#f87171':(nw?'#fbbf24':'#4ade80'))+
    kpi('Offene Fehler',ne,'Warnungen: '+nw,ne?'#f87171':'#e8eef6')+
    kpi('Kommunikation',kq?kq+' gestört':'OK',kq?Object.keys(komm.akt).slice(0,3).join(', '):'alle Schnittstellen liefern',kq?'#f87171':'#4ade80')+
    kpi('WP Laufzeit heute',dur(wp),'Ereignisse 24 h: '+t24,'#e8eef6');
  // offene Meldungen
  document.getElementById('mo_open').innerHTML=open.length?open.sort(function(a,b){return b.tl-a.tl;}).map(row).join(''):'<div class="mo-empty">Keine offenen Meldungen ✓</div>';
  // Laufzeiten
  lz(ev,now);
  // Filter
  var kats={};ev.forEach(function(e){kats[e.kat]=1;});
  var fs=[['sev','alle','Alle'],['sev','E','Fehler'],['sev','W','Warnungen'],['sev','I','Info']].concat(Object.keys(kats).sort().map(function(k){return ['kat',k,k];}));
  document.getElementById('mo_f').innerHTML=fs.map(function(f){var on=(f[0]=='sev'?F.sev==f[1]:F.kat==f[1]);return '<span class="mo-chip'+(on?' on':'')+'" data-f="'+f[0]+'" data-v="'+esc(f[1])+'">'+esc(f[2])+'</span>';}).join('')+(F.kat!='alle'?'<span class="mo-chip" data-f="kat" data-v="alle">✕ Kategorie</span>':'');
  var L=ev.filter(function(e){return (F.sev=='alle'||e.sev==F.sev)&&(F.kat=='alle'||e.kat==F.kat);}).sort(function(a,b){return b.tl-a.tl;});
  var html='',ld='';L.slice(0,LIM).forEach(function(e){var d=day(e.tl);if(d!=ld){html+='<div class="mo-day">'+d+'</div>';ld=d;}html+=row(e);});
  if(L.length>LIM)html+='<button class="mo-tab mo-more" id="mo_more">Ältere anzeigen ('+(L.length-LIM)+')</button>';
  document.getElementById('mo_list').innerHTML=html||'<div class="mo-empty">Keine Ereignisse</div>';
  var u=document.getElementById('mo_upd');if(u)u.textContent='aktualisiert '+hms(Date.now()/1000);
}
function row(e){
  var c=SEV[e.sev]||SEV.I,src=e.akt?Object.keys(e.akt):[],sub='';
  if(e.offen&&src.length)sub=src.length>1?src.length+' Quellen: '+src.slice(0,3).join(', ')+(src.length>3?' …':''):src[0]+(e.q&&e.q[src[0]]?' – '+e.q[src[0]]:'');
  else if(e.text)sub=e.text;
  var badge=e.offen?'<span class="b b-open">offen seit '+hms(e.t0)+'</span>':(e.te?'<span class="b b-ok">behoben '+hms(e.te)+'</span>':(e.n>1?'<span class="b b-n">'+e.n+'×</span>':''));
  var det=(e.h||[]).slice(-40).reverse().map(function(h){return '<div><i>'+hms(h[0])+'</i>'+(h[1]=='+'?'⚠ ':h[1]=='-'?'✓ ':'')+esc(h[2]?h[2]+': ':'')+esc(h[3])+'</div>';}).join('');
  det='<div><i>Beginn</i>'+day(e.t0)+' '+hms(e.t0)+(e.te?' · <i>Ende</i>'+hms(e.te):'')+(e.dur?' · <i>Dauer</i>'+dur(e.dur):'')+(e.kwh?' · <i>Energie</i>'+e.kwh+' kWh':'')+'</div>'+det;
  return '<div class="mo-row" data-id="'+e.id+'"><span class="t">'+hms(e.tl)+'</span><span class="d" style="background:'+c[0]+';box-shadow:0 0 6px '+c[0]+'"></span><span class="k">'+esc(e.kat)+'</span><span class="x">'+esc(e.titel)+(e.n>1&&!e.offen?'':'')+'<small>'+esc(sub)+'</small></span>'+badge+'</div><div class="mo-det" id="det_'+e.id+'">'+det+'</div>';
}
function lz(ev,now){
  var days=[],i;for(i=6;i>=0;i--){var d=new Date((now-i*86400)*1000);d.setHours(0,0,0,0);days.push({t:d.getTime()/1000,k:d.toDateString(),l:['So','Mo','Di','Mi','Do','Fr','Sa'][d.getDay()]+' '+d.getDate()+'.',s:{}});}
  var ser={};ev.forEach(function(e){if(!e.lz||!e.dur)return;var k=new Date(e.t0*1000).toDateString();days.forEach(function(d){if(d.k==k){d.s[e.lz]=(d.s[e.lz]||0)+e.dur;ser[e.lz]=1;}});});
  var keys=Object.keys(ser).sort();if(!keys.length){document.getElementById('mo_lz').innerHTML='<div class="mo-empty">Noch keine Laufzeiten erfasst – werden ab jetzt je Lauf aufgezeichnet.</div>';return;}
  var COL=['#f472b6','#a78bfa','#c084fc','#60a5fa'],W=900,H=200,L=40,B=26,T=10,pw=W-L-10,ph=H-B-T,max=1;
  days.forEach(function(d){keys.forEach(function(k){max=Math.max(max,d.s[k]||0);});});max=Math.ceil(max/3600)*3600||3600;
  var bw=pw/7,g=Math.min(28,(bw-12)/keys.length),s='<svg viewBox="0 0 '+W+' '+H+'">';
  for(i=0;i<=4;i++){var y=T+ph-ph*i/4;s+='<line x1="'+L+'" x2="'+(W-10)+'" y1="'+y+'" y2="'+y+'" stroke="#1b2437"/><text x="'+(L-6)+'" y="'+(y+3)+'" fill="#5b6b82" font-size="10" text-anchor="end">'+dur(max*i/4)+'</text>';}
  days.forEach(function(d,di){var x0=L+di*bw+(bw-g*keys.length)/2;keys.forEach(function(k,ki){var v=d.s[k]||0,h=ph*v/max;s+='<rect x="'+(x0+ki*g)+'" y="'+(T+ph-h)+'" width="'+(g-3)+'" height="'+h+'" rx="3" fill="'+COL[ki%4]+'"><title>'+k+': '+dur(v)+'</title></rect>';});
    s+='<text x="'+(L+di*bw+bw/2)+'" y="'+(H-8)+'" fill="#5b6b82" font-size="10" text-anchor="middle">'+d.l+'</text>';});
  s+='</svg><div class="mo-chips" style="margin:6px 0 0">'+keys.map(function(k,ki){return '<span class="mo-chip" style="cursor:default"><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:'+COL[ki%4]+';margin-right:5px"></span>'+(k=='WP'?'Wärmepumpe':k.replace(/^WB:OpenWB_?/,'Wallbox ').replace('Garage_',''))+'</span>';}).join('')+'</div>';
  document.getElementById('mo_lz').innerHTML=s;
}
document.addEventListener('click',function(ev){
  var t=ev.target.closest?ev.target.closest('.mo-tab,.mo-chip,.mo-row'):null;if(!t)return;
  if(t.id=='mo_more'){LIM+=300;render();return;}
  if(t.dataset.s){cur=t.dataset.s;tabs();document.getElementById('mo_list').innerHTML='<div class="mo-empty">lade …</div>';if(DATA[cur])render();load();return;}
  if(t.dataset.f){F[t.dataset.f]=t.dataset.v;render();return;}
  if(t.dataset.id){var d=document.getElementById('det_'+t.dataset.id);if(d)d.classList.toggle('on');}
});
function initNav(){var b=document.getElementById('burger'),n=document.getElementById('sidenav'),s=document.getElementById('navshade');if(!b||!n||!s)return;function t(){n.classList.toggle('open');s.classList.toggle('open');}b.addEventListener('click',t);s.addEventListener('click',t);}
function startClock(){var c=document.getElementById('clock');if(!c)return;function t(){var d=new Date();c.textContent=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);}t();setInterval(t,10000);}
function start(){if(/[?&]embed=1/.test(location.search))document.body.classList.add('mo-embed');else{initNav();startClock();}
  tabs();load();setInterval(function(){if(!document.hidden)load();},30000);}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>
<script src="ue-arrange.js?v=10"></script>

</div>
</body>
</html>
