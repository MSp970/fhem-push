<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes"/>
<title>Steuerung</title>
<script src="../ftui.js"></script>
<link href="../ftui.css" rel="stylesheet"/>
<link href="../themes/ftui-theme.css" rel="stylesheet"/>
<style>
:root{
  --bg:#0b0f1a; --card:#121826; --card2:#1a1f2e;
  --line:#1d2638; --txt:#e0e0e0; --dim:#8496ab;
  --cyan:#00ffff; --pv:#ffb300; --haus:#2196f3;
  --bat:#4caf50; --warm:#ff7043;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--bg);
  color:var(--txt);font-family:"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased}
body{min-height:100vh}
.sidenav{width:230px;background:#0a0e18;
  border-right:1px solid var(--line);padding:18px 0;
  position:fixed;top:0;left:0;height:100vh;z-index:20;
  transform:translateX(-100%);
  transition:transform .25s ease;
  box-shadow:0 0 30px rgba(0,0,0,.6)}
.sidenav.open{transform:translateX(0)}
.navshade{position:fixed;inset:0;background:rgba(0,0,0,.5);
  z-index:15;display:none}
.navshade.open{display:block}
.burger{background:none;border:none;color:var(--txt);
  font-size:22px;cursor:pointer;padding:4px 8px;
  line-height:1}
.sidenav .brand{color:var(--cyan);font-weight:800;
  font-size:17px;letter-spacing:1px;padding:0 20px 16px;
  border-bottom:1px solid var(--line);margin-bottom:10px}
.sidenav a{display:flex;align-items:center;gap:10px;
  padding:12px 20px;color:var(--dim);font-weight:600;
  font-size:15px;text-decoration:none;
  border-left:3px solid transparent}
.sidenav a.active{color:var(--txt);background:#0e1524;
  border-left-color:var(--cyan)}
.sidenav a:hover{color:var(--txt)}
.main{flex:1;min-width:0;padding-bottom:30px}
.headbar{display:flex;align-items:center;gap:18px;
  flex-wrap:wrap;padding:10px 20px;background:#0a0e18;
  border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:5}
.headbar .hi{display:flex;align-items:center;gap:6px;
  font-weight:700;font-size:14px}
.headbar .hi .u{color:var(--dim);font-weight:600;
  font-size:12px}
.headbar .spacer{flex:1}
.headbar .clock{font-size:18px;font-weight:800;
  color:var(--cyan)}
.wide-card{margin:24px auto;width:92%;max-width:1000px;
  background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.2);padding:20px}
.wide-card h2{margin:0 0 12px;font-size:16px;
  font-weight:700;color:var(--cyan)}
.wr-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:16px}
.wr{background:var(--card2);border-radius:10px;
  padding:14px 16px;
  box-shadow:0 0 10px rgba(255,255,255,.08)}
.wr h3{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--pv);text-transform:uppercase;
  letter-spacing:1px}
.wr.gruen h3{color:var(--bat)}
.wr.blau h3{color:var(--haus)}
.wr.warm h3{color:var(--warm)}
.kv{display:flex;align-items:baseline;gap:8px;
  padding:5px 0;border-bottom:1px solid #131c2a;
  font-size:14px}
.kv:last-child{border-bottom:none}
.kv .k{flex:1;color:var(--dim)}
.kv .v{font-weight:700;font-size:16px}
.kv .u{color:var(--dim);font-size:12px}
.stats-row{display:flex;justify-content:space-around;
  flex-wrap:wrap;gap:12px;margin-top:8px}
.stat{background:var(--card2);border-radius:8px;
  padding:10px 20px;min-width:150px;flex:1;
  box-shadow:0 0 10px rgba(255,255,255,.1);
  text-align:center}
.stat .sl{color:var(--dim);font-size:13px}
.stat .sv{font-size:20px;font-weight:800}
.stat .sv small{font-size:12px;font-weight:600;
  color:var(--dim)}
.circle-row{display:flex;justify-content:space-around;
  align-items:flex-start;flex-wrap:wrap;gap:20px;
  margin-top:26px;padding:0 12px}
.circle-card{position:relative;width:200px;height:200px;
  border-radius:50%;padding:20px;text-align:center;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:2px;
  background:radial-gradient(circle at center,
    var(--card2) 0%,var(--bg) 100%);
  box-shadow:0 0 20px rgba(0,255,255,.3)}
.circle-card.haus{margin-top:60px}
.circle-card h3{margin:0 0 4px;font-size:14px;
  font-weight:700;color:var(--cyan);
  text-transform:uppercase;letter-spacing:1px}
.circle-card .ico{font-size:38px;line-height:1}
.circle-card .val{font-size:34px;font-weight:800;
  letter-spacing:-1px}
.circle-card .val small{font-size:17px;font-weight:600;
  color:var(--dim)}
.circle-card .sub{font-size:12px;color:var(--dim)}
.circle-card.pv{border:2px solid var(--pv);
  box-shadow:0 0 20px rgba(255,179,0,.35)}
.circle-card.pv .ico{filter:drop-shadow(0 0 8px var(--pv))}
.circle-card.haus{border:2px solid var(--haus);
  box-shadow:0 0 20px rgba(33,150,243,.35)}
.circle-card.haus .ico{
  filter:drop-shadow(0 0 8px var(--haus))}
.circle-card.bat{border:2px solid #12324a}
.circle-card.bat .ico{
  filter:drop-shadow(0 0 8px var(--bat))}
.circle-card.bat .arc{position:absolute;inset:-2px;
  border-radius:50%;
  background:conic-gradient(from -90deg,
    var(--bat) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1% + 4%),
    transparent 0);
  -webkit-mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px));
  mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px))}
.wirebox{position:relative;max-width:960px;margin:0 auto}
.wires{position:absolute;inset:0;width:100%;height:300px;
  pointer-events:none;z-index:-1}
.wires path{fill:none;stroke-width:3;
  stroke-linecap:round;stroke-dasharray:10 14;
  animation:dash 1.2s linear infinite}
@keyframes dash{to{stroke-dashoffset:-24}}
@media (prefers-reduced-motion:reduce){
  .wires path{animation:none}}
.w-pv{stroke:var(--pv);
  filter:drop-shadow(0 0 4px var(--pv))}
.w-bat{stroke:var(--cyan);
  filter:drop-shadow(0 0 4px var(--cyan))}
@media (max-width:820px){
  .circle-card.haus{margin-top:0}
}
.tile-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:16px;width:94%;max-width:1100px;margin:20px auto}
.tile{background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.15);padding:16px}
.tile h2{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--cyan);text-transform:uppercase;
  letter-spacing:1px}
.tile.span2{grid-column:1/-1}
.bigval{font-size:40px;font-weight:800;
  letter-spacing:-1px;line-height:1.1}
.bigval{display:flex;justify-content:center;align-items:baseline;column-gap:9px}
.bigval ftui-label{display:inline-flex}
.bigval small{font-size:18px;color:var(--dim);
  font-weight:600}
.minirow{display:flex;justify-content:space-around;
  text-align:center;margin:6px 0}
.minirow .mi .ic{font-size:26px}
.minirow .mi .mv{font-size:20px;font-weight:800}
.minirow .mi .mv small{font-size:12px;color:var(--dim)}
.minirow .mi .ml{font-size:11px;color:var(--dim)}
.kv .v{white-space:nowrap}
.kv .v ftui-label{display:inline}
.wrled-row{display:flex;justify-content:space-around;flex-wrap:wrap;gap:12px}
.wrled{flex:1;min-width:180px;max-width:260px}
.wrsvg{width:100%;height:auto;display:block}
.wrsvg .fin{fill:#222a3b;stroke:#303b52}
.wrsvg .panel{fill:#0b0f1a;stroke:#27324a}
.wrsvg .wrt{fill:#00ffff;font-weight:800;font-size:15px;letter-spacing:1px}
.wrsvg .wrs{fill:#8496ab;font-size:9px;letter-spacing:.5px}
.wrsvg .wri{fill:#e0e0e0;font-size:10px;font-weight:600}
.wrsvg .ledt{fill:#8496ab;font-size:10px;font-weight:700;letter-spacing:1px}
.wrsvg .led{fill:#262e3f;stroke:#39455f;stroke-width:1}
.wrsvg .led.on,.wrsvg .led.b1,.wrsvg .led.b2{fill:var(--lc,#4caf50);filter:drop-shadow(0 0 5px var(--lc,#4caf50))}
.wrsvg .led.b1{animation:ledbl 1.6s steps(1) infinite}
.wrsvg .led.b2{animation:ledbl .5s steps(1) infinite}
@keyframes ledbl{50%{fill:#262e3f;filter:none}}
@media (prefers-reduced-motion:reduce){.wrsvg .led.b1,.wrsvg .led.b2{animation:none;opacity:.6}}
.wrled-leg{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-top:8px;font-size:11px;color:var(--dim)}
.wrled-leg span{display:flex;align-items:center;gap:5px}
.wrled-leg .lg{display:inline-block;width:9px;height:9px;border-radius:50%;background:#262e3f;border:1px solid #39455f}
.wrled-leg .lg.on,.wrled-leg .lg.b1,.wrled-leg .lg.b2{background:#4caf50;box-shadow:0 0 5px #4caf50}
.wrled-leg .lg.b1{animation:lgbl 1.6s steps(1) infinite}
.wrled-leg .lg.b2{animation:lgbl .5s steps(1) infinite}
@keyframes lgbl{50%{background:#262e3f;box-shadow:none}}
</style>
</head>
<body>

<div class="navshade" id="navshade"></div>
<nav class="sidenav" id="sidenav">
  <div class="brand">SMART HOME</div>
    <a href="uebersicht.html">⚡ Übersicht</a>
    <a href="pv.html">🔆 PV-Anlage</a>
    <a href="heizung.html">♨️ Heizung live</a>
    <a href="klima.html">🔥 Heizung</a>
    <a href="ertrag.html">&#128182; Ertrag</a>
    <a href="auto.html">🚗 E-Autos</a>
  <a href="tobi.html">👤 Tobi</a>
    <a href="geraete.html">🛠️ Geräte</a>
    <a href="monitor.html">🛡️ Monitoring</a>
    <a href="steuerung.html" class="active">🎛️ Steuerung</a>
    <a href="/fhem" style="border-top:1px solid rgba(255,255,255,.1)">⚙️ FHEM</a>
</nav>

<div class="main">
  <div class="headbar">

  <button class="burger" id="burger">☰</button>
  <div class="hi">🚗 <ftui-label
    [text]="OpenWB_Garage_links:Ladeleistung_gesamt_kW"></ftui-label>
    / <ftui-label
    [text]="OpenWB_Garage_rechts:Ladeleistung_gesamt_kW"></ftui-label>
    <span class="u">kW</span></div>
  <div class="hi">🔆 <ftui-label
    [text]="di_DashWerte:PV_gesamt"></ftui-label>
    <span class="u">W</span></div>
  <div class="hi">🔋 <ftui-label
    [text]="di_DashWerte:SOC_gew"></ftui-label>
    <span class="u">%</span></div>
  <div class="spacer"></div>
  <div class="hi">🌡️ <ftui-label
    [text]="BresserWetter:temperatur_aussen"></ftui-label>
    <span class="u">°C</span></div>
  <div class="clock" id="clock"></div>

  </div>

<style>
.st-wrap{width:94%;max-width:1200px;margin:14px auto 24px}
.st-top{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.st-tab{background:#161e2e;border:1px solid #1f2a3e;color:#9fb0c5;font-size:13px;padding:6px 14px;border-radius:99px;cursor:pointer;font-family:inherit}
.st-tab.on{color:#0b0f1a;background:#22d3ee;border-color:#22d3ee;font-weight:700}
.st-upd{margin-left:auto;font-size:11px;color:#6b7c93}
.st-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:14px}
.st-card{background:linear-gradient(160deg,#141b2b,#0f1522);border:1px solid #1d2638;border-radius:18px;padding:14px 16px}
.st-card h2{margin:0 0 12px;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:#22d3ee}
.st-item{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.05)}
.st-item:last-child{border-bottom:0}
.st-item .nm{flex:1;min-width:0}.st-item .nm b{display:block;font-size:14px}.st-item .nm span{font-size:12px;color:#8496ab}
.st-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;box-shadow:0 0 10px currentColor}
.st-btn{background:#1b2437;border:1px solid #2a3650;color:#e8eef6;font-size:13px;padding:8px 14px;border-radius:12px;cursor:pointer;font-family:inherit;white-space:nowrap}
.st-btn:hover{border-color:#22d3ee}.st-btn.pri{background:#0e7490;border-color:#22d3ee}.st-btn.warn{background:#7f1d1d;border-color:#f87171}
.st-btn:disabled{opacity:.45;cursor:wait}
.st-sw{position:relative;width:52px;height:30px;border-radius:30px;background:#273145;border:1px solid #334155;cursor:pointer;flex-shrink:0;transition:background .2s}
.st-sw i{position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#94a3b8;transition:left .2s,background .2s}
.st-sw.on{background:#854d0e;border-color:#facc15}.st-sw.on i{left:25px;background:#facc15}
.st-btns{display:flex;gap:6px;flex-wrap:wrap}
.st-big{font-size:26px;font-weight:800;font-variant-numeric:tabular-nums}
.st-msg{font-size:12px;color:#8496ab;margin-top:8px;min-height:16px}
.st-warn{color:#f87171;font-weight:700}
.st-empty{color:#6b7c93;font-size:12.5px;padding:8px 2px}
.st-embed .headbar,.st-embed .sidenav,.st-embed .navshade{display:none!important}.st-embed .st-wrap{width:100%;margin:0}.st-embed .st-top{display:none}
</style>
<div class="st-wrap">
  <div class="st-top" id="st_tabs"></div>
  <div class="st-grid" id="st_grid"></div>
  <div class="st-msg" id="st_msg"></div>
</div>
<script>
(function(){
var SITES=[
 {id:'g',name:'Große Anlage',base:'http://192.168.176.205:8084',
  gates:[{n:'Garagentor',st:'Garagentor_gross',cmd:'set Garagentor_gross_trigger betaetigen'}],
  doors:[['Garagentür','Garagentuer_gross']],
  lights:[['Garagenlicht vorne','Garagenlicht_Vorne_gross'],['Garagenlicht hinten','Garagenlicht_Hinten_gross']],
  out:[],
  zis:{pump:'myShelly_Huette_Zisterne',st:'Zisternenpumpe',leer:'Zisterne_leer_erkannt'}},
 {id:'k',name:'S9',base:'http://192.168.178.21:8084',
  gates:[{n:'Garagentor vorne',st:'Garagentor_vorne',cmd:'set Garagentor_vorn_trigger betaetigen',safe:'set Garagentor_schliessen_safe betaetigen'},{n:'Garagentor hinten',st:'Garagentor_hinten'}],
  doors:[['Garagentür','Garagentuer']],
  lights:[['Garagenlicht vorne','Garagenlicht_Vorne'],['Garagenlicht hinten','Garagenlicht_Hinten']],
  out:[['Haustür','Aussenlampe_Haustuer'],['Terrasse Ost','Aussenlampe_Terasse_Ost'],['Terrasse Süd','Aussenlampe_Terasse_Sued'],['Terrasse West','Aussenlampe_Terasse_West'],['Hecke Einfahrt','Heckenbeleuchtung_Garageneinfahrt']],
  zis:{level:'Wasserstand_Zisterne'}}
];
var NUR=(location.search.match(/[?&]nur=(\w+)/)||[])[1]||'';
var cur=(location.search.match(/[?&]anlage=(g|k)/)||[])[1]||((/^192\.168\.178\./.test(location.hostname))?'k':'g'),M={};
function site(){return SITES.filter(function(x){return x.id==cur;})[0];}
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function req(s,cmd){
  var go=function(){return fetch(s.base+'/fhem?cmd='+encodeURIComponent(cmd)+'&XHR=1&fwcsrf='+encodeURIComponent(s.tok||''),{cache:'no-store'}).then(function(r){if(!r.ok)throw r.status;return r.text();});};
  var tk=function(){return fetch(s.base+'/fhem?XHR=1',{cache:'no-store'}).then(function(r){s.tok=r.headers.get('X-FHEM-csrfToken')||'';});};
  return (s.tok===undefined?tk().then(go):go()).catch(function(){return tk().then(go);});}
function V(d,r){try{return M[d][r||'state'].Value;}catch(e){return null;}}
function TM(d,r){try{var t=M[d][r||'state'].Time;return t?t.substr(11,8):'';}catch(e){return '';}}
function devs(s){var d={};s.gates.forEach(function(g){d[g.st]=1;});s.doors.concat(s.lights,s.out).forEach(function(x){d[x[1]]=1;});
  if(s.zis.pump){d[s.zis.pump]=1;d[s.zis.st]=1;d[s.zis.leer]=1;}if(s.zis.level)d[s.zis.level]=1;
  if(s.id=='g')d.Garagentor_gross_trigger=1;else d.Garagentor_vorn_trigger=1;return Object.keys(d);}
function gcol(v){v=String(v||'');if(/geschlossen/.test(v)&&!/wird/.test(v))return '#34d399';if(/wird/.test(v))return '#60a5fa';if(/geoeffnet|offen|auf/.test(v))return '#fb923c';if(v)return '#f87171';return '#475569';}
function isOn(v){return /^(on|ein|an|1|true)$/i.test(String(v||'').trim());}
function tabs(){document.getElementById('st_tabs').innerHTML=SITES.map(function(s){return '<button class="st-tab'+(s.id==cur?' on':'')+'" data-s="'+s.id+'">'+s.name+'</button>';}).join('')+'<span class="st-upd" id="st_upd"></span>';}
function live(){var s=site();return req(s,'jsonlist2 '+devs(s).join(',')).then(function(t){var j=JSON.parse(t);M={};j.Results.forEach(function(x){M[x.Name]=x.Readings||{};});render(s);})
  .catch(function(e){document.getElementById('st_grid').innerHTML='<div class="st-empty" style="color:#f87171">'+esc(s.name)+' nicht erreichbar: '+esc(e)+'</div>';});}
function item(col,name,sub,right){return '<div class="st-item"><span class="st-dot" style="color:'+col+';background:'+col+'"></span><div class="nm"><b>'+name+'</b><span>'+sub+'</span></div>'+right+'</div>';}
function sw(dev,on){return '<div class="st-sw'+(on?' on':'')+'" data-dev="'+dev+'" data-on="'+(on?1:0)+'" title="schalten"><i></i></div>';}
function render(s){var h='';
  if(!NUR||NUR=='garage'){
    var g='<div class="st-card"><h2>Garage</h2>';
    s.gates.forEach(function(x,i){var v=V(x.st);if(v==null)return;var bt='';
      if(x.cmd)bt='<div class="st-btns"><button class="st-btn pri" data-gate="'+i+'">Tor betätigen</button>'+(x.safe&&!/geschlossen/.test(v)?'<button class="st-btn" data-safe="'+i+'">sicher schließen</button>':'')+'</div>';
      g+=item(gcol(v),esc(x.n),esc(String(v).replace(/_/g,' '))+(TM(x.st)?' · seit '+TM(x.st):''),bt);});
    s.doors.forEach(function(x){var v=V(x[1]);if(v==null)return;g+=item(gcol(v),esc(x[0]),esc(v)+(TM(x[1])?' · seit '+TM(x[1]):''),'');});
    s.lights.forEach(function(x){var v=V(x[1]);if(v==null)return;var o=isOn(v);g+=item(o?'#facc15':'#475569',esc(x[0]),o?'an':'aus',sw(x[1],o));});
    h+=g+'</div>';}
  if((!NUR||NUR=='zisterne')&&(s.zis.pump||s.zis.level)){var z='<div class="st-card"><h2>Zisterne</h2>';
    if(s.zis.pump){var rel=V(s.zis.pump,'relay_0'),pw=parseFloat(V(s.zis.pump,'power_0')),on=isOn(rel),leer=isOn(V(s.zis.leer));
      z+='<div class="st-item"><span class="st-dot" style="color:'+(on?'#22d3ee':'#475569')+';background:'+(on?'#22d3ee':'#475569')+'"></span><div class="nm"><b>Zisternenpumpe</b><span>'+(on?'läuft':'aus')+(TM(s.zis.pump,'relay_0')?' · seit '+TM(s.zis.pump,'relay_0'):'')+'</span></div><div class="st-big" style="color:'+(on?'#22d3ee':'#8496ab')+'">'+(isNaN(pw)?'–':Math.round(pw))+'<small style="font-size:13px;color:#8496ab"> W</small></div></div>';
      if(leer)z+='<div class="st-msg st-warn">⚠ Zisterne leer erkannt – Pumpe wurde abgeschaltet</div>';
      z+='<div class="st-btns" style="margin-top:10px">'+[15,30,60].map(function(m){return '<button class="st-btn'+(on?'':' pri')+'" data-pump="'+m+'">Ein '+m+' min</button>';}).join('')+'<button class="st-btn warn" data-pump="0">Aus</button></div>';
      z+='<div class="st-msg">Einschalten nur mit Zeitbegrenzung · Trockenlaufschutz „Erkennung_Zisterne_leer“ bleibt aktiv</div>';}
    if(s.zis.level){var lv=V(s.zis.level);if(lv!=null)z+=item('#22d3ee','Wasserstand',esc(lv)+(TM(s.zis.level)?' · '+TM(s.zis.level):''),'');}
    h+=z+'</div>';}
  if((!NUR||NUR=='aussen')&&s.out.length){var o='<div class="st-card"><h2>Außenbeleuchtung</h2>';
    s.out.forEach(function(x){var v=V(x[1]);if(v==null)return;var n=isOn(v)||parseFloat(v)>0;o+=item(n?'#facc15':'#475569',esc(x[0]),esc(v),sw(x[1],n));});h+=o+'</div>';}
  document.getElementById('st_grid').innerHTML=h||'<div class="st-empty">Keine Geräte gefunden.</div>';
  var u=document.getElementById('st_upd');if(u){var d=new Date();u.textContent='aktualisiert '+('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'+('0'+d.getSeconds()).slice(-2);}}
function msg(t){var m=document.getElementById('st_msg');if(m)m.textContent=t;}
function run(cmd,btn){var s=site();if(btn)btn.disabled=true;msg('sende: '+cmd.replace(/^set /,''));
  return req(s,cmd).then(function(r){msg((r&&r.trim()?'Antwort: '+r.trim():'ausgeführt')+' · '+new Date().toLocaleTimeString('de-DE'));setTimeout(live,1200);setTimeout(live,4000);})
   .catch(function(e){msg('Fehler: '+e);}).then(function(){if(btn)btn.disabled=false;});}
document.addEventListener('click',function(ev){var t=ev.target.closest?ev.target.closest('.st-tab,.st-btn,.st-sw'):null;if(!t)return;var s=site();
  if(t.dataset.s){cur=t.dataset.s;M={};tabs();live();return;}
  if(t.dataset.gate!=null){var g=s.gates[+t.dataset.gate],v=V(g.st)||'';if(!confirm(g.n+' ist „'+String(v).replace(/_/g,' ')+'“.\n\nTor wirklich betätigen ('+(/geschlossen/.test(v)?'öffnen':'Impuls')+')?'))return;run(g.cmd,t);return;}
  if(t.dataset.safe!=null){var g2=s.gates[+t.dataset.safe];if(!confirm(g2.n+' sicher schließen?'))return;run(g2.safe,t);return;}
  if(t.dataset.pump!=null){var m=+t.dataset.pump;if(m>0){if(!confirm('Zisternenpumpe für '+m+' Minuten einschalten?'))return;run('set '+s.zis.pump+' on-for-timer '+(m*60)+' 0',t);}else run('set '+s.zis.pump+' off 0',t);return;}
  if(t.dataset.dev){run('set '+t.dataset.dev+' '+(t.dataset.on=='1'?'off':'on'),null);t.classList.toggle('on');return;}});
function initNav(){var b=document.getElementById('burger'),n=document.getElementById('sidenav'),s=document.getElementById('navshade');if(!b||!n||!s)return;function t(){n.classList.toggle('open');s.classList.toggle('open');}b.addEventListener('click',t);s.addEventListener('click',t);}
function startClock(){var c=document.getElementById('clock');if(!c)return;function t(){var d=new Date();c.textContent=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);}t();setInterval(t,10000);}
function start(){if(/[?&]embed=1/.test(location.search))document.body.classList.add('st-embed');else{initNav();startClock();}
  tabs();live();setInterval(function(){if(!document.hidden)live();},5000);}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>
<script src="ue-arrange.js?v=12"></script>
</div>
</body>
</html>
