var cur=(/^192\.168\.178\./.test(location.hostname))?'k':'g',RANGE={t:24,p:24},M={},S=null,LAST={},HID={};try{HID=JSON.parse(localStorage.getItem('hz_hide_v1')||'{}')||{};}catch(e){HID={};}
function hk(g,s){return cur+'|'+g+'|'+s.l[2];}
function site(){return SITES.filter(function(x){return x.id==cur;})[0];}
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}).replace(/Waermepumpe/g,'Wärmepumpe');}
function hms(ts){var m=String(ts||'').match(/(\d\d:\d\d:\d\d)/);return m?m[1]:'';}
function dur(s){s=Math.round(s);if(s>=3600)return Math.floor(s/3600)+'h'+('0'+Math.floor(s%3600/60)).slice(-2);return Math.round(s/60)+' min';}
function req(s,cmd){
  var go=function(){return fetch(s.base+'/fhem?cmd='+encodeURIComponent(cmd)+'&XHR=1&fwcsrf='+encodeURIComponent(s.tok||''),{cache:'no-store'}).then(function(r){if(!r.ok)throw r.status;return r.text();});};
  var tk=function(){return fetch(s.base+'/fhem?XHR=1',{cache:'no-store'}).then(function(r){s.tok=r.headers.get('X-FHEM-csrfToken')||'';});};
  return (s.tok===undefined?tk().then(go):go()).catch(function(){return tk().then(go);});
}
function devsOf(s){var d={};function a(x){if(x)d[x.split(':')[0]]=1;}
  s.kpis.forEach(function(k){a(k.v);a(k.v2);(k.s||[]).forEach(function(z){a(z[1]);});});
  s.flags.forEach(function(f){a(f[1]);});s.reasons.forEach(function(r){a(r[1]);});
  (s.rooms.tado||[]).forEach(function(x){d[x]=1;});(s.rooms.a9||[]).forEach(function(x){d[x[1]]=1;});
  (s.rooms.knx||[]).forEach(function(x){d[x[1]]=1;});if(s.rooms.knx)d['Heizventilstellungen']=1;
  return Object.keys(d);}
function G(ref){if(!ref)return null;var p=ref.split(':');try{return M[p[0]][p[1]];}catch(e){return null;}}
function N(ref){var g=G(ref);if(!g)return NaN;return parseFloat(String(g.Value).replace(',','.'));}
function fmt(v,u){if(isNaN(v))return '–';if(u=='dur')return dur(v);if(u=='n')return String(Math.round(v));if(u=='W'&&Math.abs(v)>=1000)return (v/1000).toFixed(1).replace('.',',')+'<small>kW</small>';var d=(u=='W'||u=='%'||u=='')?(Math.abs(v)>=100?0:1):1;if(u==''&&Math.abs(v)>=10)d=0;return v.toFixed(d).replace('.',',')+(u?'<small>'+u+'</small>':'');}
function on(ref){var g=G(ref);if(!g)return null;var v=String(g.Value).trim();return /^(1|on|an|ein|true|yes|aktiv)/i.test(v)||parseFloat(v)>0;}
function tabs(){document.getElementById('hz_tabs').innerHTML=SITES.map(function(s){return '<button class="hz-tab'+(s.id==cur?' on':'')+'" data-s="'+s.id+'">'+s.name+'</button>';}).join('')+'<span class="hz-upd" id="hz_upd"></span>';
  [].forEach.call(document.querySelectorAll('.hz-card h2 .r'),function(r){var g=r.dataset.g;r.innerHTML=[12,24,72].map(function(h){return '<button class="hz-rb'+(RANGE[g]==h?' on':'')+'" data-g="'+g+'" data-h="'+h+'">'+(h<48?h+' h':h/24+' T')+'</button>';}).join('');});}
function live(){var s=site();S=s;
  return req(s,'jsonlist2 '+devsOf(s).join(',')).then(function(t){var j=JSON.parse(t);M={};j.Results.forEach(function(x){M[x.Name]=x.Readings||{};});renderLive();})
   .catch(function(e){document.getElementById('hz_kpis').innerHTML='<div class="hz-empty" style="color:#f87171">Nicht abrufbar: '+esc(e)+'</div>';});}
function renderLive(){var s=S;
  document.getElementById('hz_kpis').innerHTML=s.kpis.map(function(k){var v=N(k.v),h='<div class="hz-kpi"><div class="l">'+k.l+'</div><div class="v'+(k.v2?' sm':'')+'">'+fmt(v,k.u)+(k.v2?' <small>/</small> '+fmt(N(k.v2),k.u):'')+'</div>';
    h+='<div class="s">'+(k.s||[]).map(function(z){return z[0]+' '+fmt(N(z[1]),z[2]).replace(/<\/?small>/g,'');}).join(' · ')+'</div>';
    if(k.bar){var b=N(k.bar[0]),p=Math.max(0,Math.min(100,(b-k.bar[1])/(k.bar[2]-k.bar[1])*100));if(!isNaN(b))h+='<div class="bar" style="width:'+p+'%;background:'+k.bar[3]+'"></div>';}
    return h+'</div>';}).join('');
  document.getElementById('hz_flags').innerHTML=s.flags.map(function(f){var o=on(f[1]);if(o===null)return '';return '<span class="hz-flag'+(o?(f[2]?' warn':' on'):'')+'">'+f[0]+'</span>';}).join('');
  var rs=s.reasons.map(function(r){var g=G(r[1]);if(!g||String(g.Value)==='')return '';return '<div><span class="t">'+hms(g.Time)+'</span><span class="k">'+r[0]+'</span><span class="x">'+esc(g.Value)+'</span></div>';}).join('');
  document.getElementById('hz_rs').innerHTML=rs||'<div class="hz-empty">Keine Gründe verfügbar</div>';
  var rh='';
  (s.rooms.tado||[]).forEach(function(d){var t=N(d+':sensorDataPoints_insideTemperature_value');if(isNaN(t))return;var so=N(d+':setting_temperature_value'),hu=N(d+':sensorDataPoints_humidity_percentage'),hp=N(d+':heatingPower_percentage');
    rh+=room(d.replace('Tado_EG_','').replace('GaesteWC','Gäste-WC').replace('Kueche','Küche').replace('Buero','Büro'),t,so,hu,hp);});
  (s.rooms.a9||[]).forEach(function(x){var t=N(x[1]+':Temperatur_'+x[2]);if(isNaN(t))return;rh+=room(x[0],t,N(x[1]+':DesiredTemp_'+x[2]),N(x[1]+':Luftfeuchtigkeit_'+x[2]),N(x[1]+':Heizleistung_'+x[2]));});
  (s.rooms.knx||[]).forEach(function(x){var t=N(x[1]+':'+x[2]);var vv=N('Heizventilstellungen:'+x[3]+'-get');if(isNaN(t)&&isNaN(vv))return;rh+=room(x[0],t,NaN,NaN,vv,'Ventil');});
  document.getElementById('hz_rooms').innerHTML=rh||'<div class="hz-empty">Keine Raumdaten</div>';
  var u=document.getElementById('hz_upd');if(u){var d=new Date();u.textContent='aktualisiert '+('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'+('0'+d.getSeconds()).slice(-2);}
}
function room(n,t,so,hu,hp,hl){var c=isNaN(t)?'#e8eef6':(t<19?'#60a5fa':(t>24?'#f87171':'#e8eef6'));
  return '<div class="hz-room"><div class="n">'+esc(n)+'</div><div class="v" style="color:'+c+'">'+(isNaN(t)?'–':t.toFixed(1).replace('.',','))+'<small>°C</small></div><div class="m"><span>'+(isNaN(so)?'':'Soll '+so.toFixed(1).replace('.',',')+'°')+'</span><span>'+(isNaN(hu)?'':Math.round(hu)+' %rF')+'</span></div>'+
   (isNaN(hp)?'':'<div class="m" style="margin-top:4px"><span>'+(hl||'Heizleistung')+'</span><span>'+Math.round(hp)+' %</span></div><div class="vb"><i style="width:'+Math.max(0,Math.min(100,hp))+'%"></i></div>')+'</div>';}
function ts(d){return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2)+'_'+('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':00';}
function hist(g){var s=site(),cfg=g=='t'?s.temp:s.pow,h=RANGE[g],to=new Date(Date.now()+60000),fr=new Date(Date.now()-h*3600000);
  var byLog={};cfg.log.forEach(function(l,i){(byLog[l[0]]=byLog[l[0]]||[]).push([l,i]);});
  var series=cfg.log.map(function(l){return {l:l,pts:[]};});
  return Promise.all(Object.keys(byLog).map(function(lg){var specs=byLog[lg].map(function(x){return '4:'+x[0][1]+'\\x3a::';});
    return req(s,'get '+lg+' - - '+ts(fr)+' '+ts(to)+' '+specs.join(' ')).then(function(t){var parts=[],curp=[];t.split('\n').forEach(function(line){if(line.charAt(0)=='#'){parts.push(curp);curp=[];return;}var m=line.match(/^(\d{4})-(\d\d)-(\d\d)_(\d\d):(\d\d):(\d\d)\s+(-?[\d.]+)/);if(m)curp.push([new Date(+m[1],m[2]-1,+m[3],+m[4],+m[5],+m[6]).getTime(),parseFloat(m[7])]);});
      byLog[lg].forEach(function(x,k){var sc=x[0][4]||1;series[x[1]].pts=(parts[k]||[]).map(function(p){return [p[0],p[1]*sc];});});}).catch(function(){});
  })).then(function(){draw(g,series,fr.getTime(),Date.now(),cfg.u);});}
function draw(g,ser,t0,t1,u){LAST[g]=[ser,t0,t1,u];var W=640,H=240,L=40,Rr=10,T=10,B=24,pw=W-L-Rr,ph=H-T-B,mn=Infinity,mx=-Infinity;
  ser.forEach(function(s){if(HID[hk(g,s)])return;s.pts.forEach(function(p){if(p[1]<mn)mn=p[1];if(p[1]>mx)mx=p[1];});});
  document.getElementById(g=='t'?'hz_lt':'hz_lp').innerHTML=ser.map(function(s,i){return '<span data-lg="'+g+'" data-li="'+i+'" title="ein-/ausblenden"'+(HID[hk(g,s)]?' class="off"':'')+'><i style="background:'+s.l[3]+'"></i>'+s.l[2]+(s.pts.length?'':' (keine Daten)')+'</span>';}).join('');
  var el=document.getElementById(g=='t'?'hz_ct':'hz_cp');if(mn==Infinity){el.innerHTML='<div class="hz-empty">'+(ser.some(function(s){return s.pts.length&&HID[hk(g,s)];})?'Alle Graphen ausgeblendet':'Keine Verlaufsdaten im Zeitraum')+'</div>';return;}
  if(u=='W'){mn=0;}else{mn=Math.floor(mn/5)*5;}mx=Math.ceil(mx*1.05/5)*5;if(mx<=mn)mx=mn+5;
  function X(t){return L+(t-t0)/(t1-t0)*pw;}function Y(v){return T+ph-(v-mn)/(mx-mn)*ph;}
  var s='<svg viewBox="0 0 '+W+' '+H+'"><defs>'+ser.map(function(z,i){return '<linearGradient id="hg'+g+i+'" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="'+z.l[3]+'" stop-opacity=".28"/><stop offset="1" stop-color="'+z.l[3]+'" stop-opacity="0"/></linearGradient>';}).join('')+'</defs>';
  for(var i=0;i<=4;i++){var v=mn+(mx-mn)*i/4,y=Y(v);s+='<line x1="'+L+'" x2="'+(W-Rr)+'" y1="'+y+'" y2="'+y+'" stroke="#1b2437"/><text x="'+(L-6)+'" y="'+(y+3)+'" fill="#5b6b82" font-size="10" text-anchor="end">'+(u=='W'&&v>=1000?(v/1000).toFixed(1)+'k':Math.round(v))+'</text>';}
  var span=t1-t0,step=span>48*3600000?12:(span>13*3600000?3:1);var d0=new Date(t0);d0.setMinutes(0,0,0);
  for(var t=d0.getTime();t<=t1;t+=3600000){var dd=new Date(t);if(dd.getHours()%step)continue;var x=X(t);if(x<L)continue;s+='<line x1="'+x+'" x2="'+x+'" y1="'+T+'" y2="'+(T+ph)+'" stroke="#161e2e"/><text x="'+x+'" y="'+(H-6)+'" fill="#5b6b82" font-size="10" text-anchor="middle">'+(dd.getHours()==0&&step>=3?dd.getDate()+'.':dd.getHours()+'h')+'</text>';}
  ser.forEach(function(z,i){if(!z.pts.length||HID[hk(g,z)])return;var pts=z.pts.filter(function(p){return p[0]>=t0;});if(!pts.length)return;
    var st=(u=='W');var d='M'+X(pts[0][0])+' '+Y(pts[0][1]);for(var k=1;k<pts.length;k++){if(st)d+=' L'+X(pts[k][0])+' '+Y(pts[k-1][1]);d+=' L'+X(pts[k][0])+' '+Y(pts[k][1]);}
    d+=' L'+X(Date.now())+' '+Y(pts[pts.length-1][1]);
    if(i<2||u=='W')s+='<path d="'+d+' L'+X(Date.now())+' '+Y(mn)+' L'+X(pts[0][0])+' '+Y(mn)+' Z" fill="url(#hg'+g+i+')"/>';
    s+='<path d="'+d+'" fill="none" stroke="'+z.l[3]+'" stroke-width="'+(i<2?2:1.6)+'" stroke-linejoin="round"'+(z.l[2]=='Außen'||z.l[2]=='Soll HK'?' stroke-dasharray="4 3"':'')+'/>';
    var lp=pts[pts.length-1];s+='<circle cx="'+X(Date.now())+'" cy="'+Y(lp[1])+'" r="3" fill="'+z.l[3]+'"/>';});
  el.innerHTML=s+'</svg>';}
function events(){var s=site();return req(s,'{Mon_JSON(2)}').then(function(t){var j=JSON.parse(t),ev=(j.ev||[]).filter(function(e){var src=Object.keys(e.akt||e.q||{}).join(' ');return e.kat=='Heizung'||s.evre.test(e.titel+' '+src+' '+e.key);}).sort(function(a,b){return b.tl-a.tl;}).slice(0,40);
  var C={E:'#f87171',W:'#fbbf24',I:'#60a5fa'};
  document.getElementById('hz_ev').innerHTML=ev.length?ev.map(function(e){var d=new Date(e.tl*1000);var h=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'+('0'+d.getSeconds()).slice(-2);return '<div><span class="t" style="color:#6b7c93;font-variant-numeric:tabular-nums">'+h+'</span><span class="d" style="background:'+(C[e.sev]||C.I)+'"></span><span>'+esc(e.titel)+(e.text?' <small style="color:#8496ab">'+esc(e.text)+'</small>':'')+(e.n>1?' <small style="color:#6b7c93">('+e.n+'×)</small>':'')+'</span></div>';}).join(''):'<div class="hz-empty">Keine Heizungs-Ereignisse</div>';}).catch(function(){document.getElementById('hz_ev').innerHTML='<div class="hz-empty">Monitoring nicht verfügbar</div>';});}
function vdG(k){var m=+k.substr(4,2);return (m==12||m<=2)?6:((m>=6&&m<=8)?2:4);}
function vd(){var s=site();return req(s,'{Mon_VD_JSON()}').then(function(t){var j;try{j=JSON.parse(t);}catch(e){throw 'Monitor-Modul ohne Verdichterstatistik';}
  var D=j.d||{},now=new Date(),days=[],i,k,W=1000,H=170,L=28,Bm=22,T=10,ph=H-T-Bm;
  for(i=29;i>=0;i--){var d=new Date(now.getTime()-i*86400000);k=d.getFullYear()+('0'+(d.getMonth()+1)).slice(-2)+('0'+d.getDate()).slice(-2);var x=D[k]||{};days.push({k:k,d:d,n:x.n||0,kurz:x.kurz||0,lz:x.lz||0,g:vdG(k)});}
  var mx=Math.max(8,Math.max.apply(null,days.map(function(x){return Math.max(x.n,x.g+4);}))),bw=(W-L-6)/30;
  function Y(v){return T+ph-v/mx*ph;}
  var sv='<svg viewBox="0 0 '+W+' '+H+'">';
  for(i=0;i<=mx;i+=(mx>12?4:2)){sv+='<line x1="'+L+'" x2="'+(W-4)+'" y1="'+Y(i)+'" y2="'+Y(i)+'" stroke="#1b2437"/><text x="'+(L-5)+'" y="'+(Y(i)+3)+'" fill="#5b6b82" font-size="10" text-anchor="end">'+i+'</text>';}
  days.forEach(function(x,n){var X=L+n*bw,c=x.n>x.g+3?'#f87171':(x.n>x.g?'#fbbf24':'#34d399'),h=Y(0)-Y(x.n);
    sv+='<rect x="'+(X+bw*.18)+'" y="'+Y(x.n)+'" width="'+(bw*.64)+'" height="'+Math.max(h,x.n?1:0)+'" rx="2" fill="'+c+'"><title>'+x.d.getDate()+'.'+(x.d.getMonth()+1)+'.: '+x.n+' Starts, Laufzeit '+dur(x.lz)+(x.kurz?', '+x.kurz+' Kurzläufe':'')+' (Warnung ab '+(x.g+1)+')</title></rect>';
    sv+='<line x1="'+X+'" x2="'+(X+bw)+'" y1="'+Y(x.g)+'" y2="'+Y(x.g)+'" stroke="#fbbf24" stroke-dasharray="3 2" stroke-width="1"/>';
    if(x.kurz)sv+='<circle cx="'+(X+bw/2)+'" cy="'+(Y(x.n)-5)+'" r="2.6" fill="#f87171"/>';
    if((x.d.getDay()==1&&n<27)||n==29)sv+='<text x="'+(X+bw/2)+'" y="'+(H-6)+'" fill="#5b6b82" font-size="10" text-anchor="middle">'+x.d.getDate()+'.'+(x.d.getMonth()+1)+'.</text>';});
  sv+='</svg>';
  var mon={},mk=[];for(i=11;i>=0;i--){var dm=new Date(now.getFullYear(),now.getMonth()-i,1);var key=dm.getFullYear()+('0'+(dm.getMonth()+1)).slice(-2);mon[key]={n:0,t:0,lz:0,d:dm};mk.push(key);}
  Object.keys(D).forEach(function(k){var m=mon[k.substr(0,6)];if(m){m.n+=D[k].n||0;m.lz+=D[k].lz||0;m.t++;}});
  var mm=Math.max(10,Math.max.apply(null,mk.map(function(k){return mon[k].n;}))),MW=(W-L-6)/12,MN=['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
  var T2=18,ph2=H-T2-Bm;function Y2(v){return T2+ph2-v/mm*ph2;}
  var sm='<svg viewBox="0 0 '+W+' '+H+'">';
  [0,.5,1].forEach(function(f){var v=Math.round(mm*f);sm+='<line x1="'+L+'" x2="'+(W-4)+'" y1="'+Y2(v)+'" y2="'+Y2(v)+'" stroke="#1b2437"/><text x="'+(L-5)+'" y="'+(Y2(v)+3)+'" fill="#5b6b82" font-size="10" text-anchor="end">'+v+'</text>';});
  mk.forEach(function(k,n){var m=mon[k],X=L+n*MW;sm+='<rect x="'+(X+MW*.2)+'" y="'+Y2(m.n)+'" width="'+(MW*.6)+'" height="'+(Y2(0)-Y2(m.n))+'" rx="3" fill="#60a5fa" opacity="'+(n==11?1:.75)+'"><title>'+MN[m.d.getMonth()]+' '+m.d.getFullYear()+': '+m.n+' Starts an '+m.t+' erfassten Tagen, Ø '+(m.t?(m.n/m.t).toFixed(1).replace('.',','):'–')+'/Tag</title></rect>';
    if(m.n)sm+='<text x="'+(X+MW/2)+'" y="'+(Y2(m.n)-4)+'" fill="#8496ab" font-size="10" text-anchor="middle">'+m.n+'</text>';
    sm+='<text x="'+(X+MW/2)+'" y="'+(H-6)+'" fill="#5b6b82" font-size="10" text-anchor="middle">'+MN[m.d.getMonth()]+'</text>';});
  sm+='</svg>';
  var td=days[29],gs=days[28],cm=mon[mk[11]],erf=Object.keys(D).length;
  document.getElementById('hz_vd').innerHTML='<div class="hz-vdk"><div><b style="color:'+(td.n>td.g+3?'#f87171':(td.n>td.g?'#fbbf24':'#e8eef6'))+'">'+td.n+'</b><span>heute · Grenze '+td.g+'</span></div><div><b>'+gs.n+'</b><span>gestern</span></div><div><b>'+cm.n+'</b><span>'+MN[cm.d.getMonth()]+' · Ø '+(cm.t?(cm.n/cm.t).toFixed(1).replace('.',','):'–')+'/Tag</span></div><div><b style="color:'+(td.kurz?'#f87171':'#e8eef6')+'">'+td.kurz+'</b><span>Kurzläufe &lt;20 min heute</span></div><div><b>'+(j.an?'an':'aus')+'</b><span>Verdichter'+(j.an&&j.t0?' seit '+dur(Date.now()/1000-j.t0):'')+'</span></div></div>'+
   '<div class="hz-vdh">Tägliche Starts (30 Tage) <small>– – Warnschwelle je Saison · ● Kurzlauf</small></div>'+sv+'<div class="hz-vdh">Starts pro Monat</div>'+sm+(erf<3?'<div class="hz-empty">Statistik läuft seit '+erf+' Tag(en) – ältere Tage werden ab jetzt gefüllt.</div>':'');
 }).catch(function(e){document.getElementById('hz_vd').innerHTML='<div class="hz-empty">Verdichterstatistik nicht verfügbar'+(typeof e=='string'?' ('+esc(e)+')':'')+'</div>';});}
function all(){live();hist('t');hist('p');events();vd();}
document.addEventListener('click',function(ev){var lg=ev.target.closest?ev.target.closest('.hz-leg span[data-lg]'):null;if(lg){var g=lg.dataset.lg,Lx=LAST[g];if(!Lx)return;var k=hk(g,Lx[0][+lg.dataset.li]);if(HID[k])delete HID[k];else HID[k]=1;try{localStorage.setItem('hz_hide_v1',JSON.stringify(HID));}catch(e){}draw(g,Lx[0],Lx[1],Lx[2],Lx[3]);return;}
  var t=ev.target.closest?ev.target.closest('.hz-tab,.hz-rb'):null;if(!t)return;
  if(t.dataset.s){cur=t.dataset.s;M={};tabs();all();}else if(t.dataset.g){RANGE[t.dataset.g]=+t.dataset.h;tabs();hist(t.dataset.g);}});
function initNav(){var b=document.getElementById('burger'),n=document.getElementById('sidenav'),s=document.getElementById('navshade');if(!b||!n||!s)return;function t(){n.classList.toggle('open');s.classList.toggle('open');}b.addEventListener('click',t);s.addEventListener('click',t);}
function startClock(){var c=document.getElementById('clock');if(!c)return;function t(){var d=new Date();c.textContent=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);}t();setInterval(t,10000);}
function start(){if(/[?&]embed=1/.test(location.search))document.body.classList.add('hz-embed');else{initNav();startClock();}
  tabs();all();setInterval(function(){if(!document.hidden)live();},15000);setInterval(function(){if(!document.hidden){hist('t');hist('p');events();vd();}},300000);}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>
<script src="ue-arrange.js?v=10"></script>

</div>
</body>
</html>
