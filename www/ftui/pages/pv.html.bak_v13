<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes"/>
<title>PV-Anlagen</title>
<script src="../ftui.js"></script>
<link href="../ftui.css" rel="stylesheet"/>
<link href="../themes/ftui-theme.css" rel="stylesheet"/>
<style>
:root{
  --bg:#0b0f1a; --card:#121826; --card2:#1a1f2e;
  --line:#1d2638; --txt:#e0e0e0; --dim:#8496ab;
  --cyan:#00ffff; --pv:#ffb300; --haus:#2196f3;
  --bat:#4caf50; --warm:#ff7043;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--bg);
  color:var(--txt);font-family:"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased}
body{min-height:100vh}
.sidenav{width:230px;background:#0a0e18;
  border-right:1px solid var(--line);padding:18px 0;
  position:fixed;top:0;left:0;height:100vh;z-index:20;
  transform:translateX(-100%);
  transition:transform .25s ease;
  box-shadow:0 0 30px rgba(0,0,0,.6)}
.sidenav.open{transform:translateX(0)}
.navshade{position:fixed;inset:0;background:rgba(0,0,0,.5);
  z-index:15;display:none}
.navshade.open{display:block}
.burger{background:none;border:none;color:var(--txt);
  font-size:22px;cursor:pointer;padding:4px 8px;
  line-height:1}
.sidenav .brand{color:var(--cyan);font-weight:800;
  font-size:17px;letter-spacing:1px;padding:0 20px 16px;
  border-bottom:1px solid var(--line);margin-bottom:10px}
.sidenav a{display:flex;align-items:center;gap:10px;
  padding:12px 20px;color:var(--dim);font-weight:600;
  font-size:15px;text-decoration:none;
  border-left:3px solid transparent}
.sidenav a.active{color:var(--txt);background:#0e1524;
  border-left-color:var(--cyan)}
.sidenav a:hover{color:var(--txt)}
.main{flex:1;min-width:0;padding-bottom:30px}
.headbar{display:flex;align-items:center;gap:18px;
  flex-wrap:wrap;padding:10px 20px;background:#0a0e18;
  border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:5}
.headbar .hi{display:flex;align-items:center;gap:6px;
  font-weight:700;font-size:14px}
.headbar .hi .u{color:var(--dim);font-weight:600;
  font-size:12px}
.headbar .spacer{flex:1}
.headbar .clock{font-size:18px;font-weight:800;
  color:var(--cyan)}
.wide-card{margin:24px auto;width:92%;max-width:1000px;
  background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.2);padding:20px}
.wide-card h2{margin:0 0 12px;font-size:16px;
  font-weight:700;color:var(--cyan)}
.wr-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:16px}
.wr{background:var(--card2);border-radius:10px;
  padding:14px 16px;
  box-shadow:0 0 10px rgba(255,255,255,.08)}
.wr h3{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--pv);text-transform:uppercase;
  letter-spacing:1px}
.wr.gruen h3{color:var(--bat)}
.wr.blau h3{color:var(--haus)}
.wr.warm h3{color:var(--warm)}
.kv{display:flex;align-items:baseline;gap:8px;
  padding:5px 0;border-bottom:1px solid #131c2a;
  font-size:14px}
.kv:last-child{border-bottom:none}
.kv .k{flex:1;color:var(--dim)}
.kv .v{font-weight:700;font-size:16px}
.kv .u{color:var(--dim);font-size:12px}
.stats-row{display:flex;justify-content:space-around;
  flex-wrap:wrap;gap:12px;margin-top:8px}
.stat{background:var(--card2);border-radius:8px;
  padding:10px 20px;min-width:150px;flex:1;
  box-shadow:0 0 10px rgba(255,255,255,.1);
  text-align:center}
.stat .sl{color:var(--dim);font-size:13px}
.stat .sv{font-size:20px;font-weight:800}
.stat .sv small{font-size:12px;font-weight:600;
  color:var(--dim)}
.circle-row{display:flex;justify-content:space-around;
  align-items:flex-start;flex-wrap:wrap;gap:20px;
  margin-top:26px;padding:0 12px}
.circle-card{position:relative;width:200px;height:200px;
  border-radius:50%;padding:20px;text-align:center;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:2px;
  background:radial-gradient(circle at center,
    var(--card2) 0%,var(--bg) 100%);
  box-shadow:0 0 20px rgba(0,255,255,.3)}
.circle-card.haus{margin-top:60px}
.circle-card h3{margin:0 0 4px;font-size:14px;
  font-weight:700;color:var(--cyan);
  text-transform:uppercase;letter-spacing:1px}
.circle-card .ico{font-size:38px;line-height:1}
.circle-card .val{font-size:34px;font-weight:800;
  letter-spacing:-1px}
.circle-card .val small{font-size:17px;font-weight:600;
  color:var(--dim)}
.circle-card .sub{font-size:12px;color:var(--dim)}
.circle-card.pv{border:2px solid var(--pv);
  box-shadow:0 0 20px rgba(255,179,0,.35)}
.circle-card.pv .ico{filter:drop-shadow(0 0 8px var(--pv))}
.circle-card.haus{border:2px solid var(--haus);
  box-shadow:0 0 20px rgba(33,150,243,.35)}
.circle-card.haus .ico{
  filter:drop-shadow(0 0 8px var(--haus))}
.circle-card.bat{border:2px solid #12324a}
.circle-card.bat .ico{
  filter:drop-shadow(0 0 8px var(--bat))}
.circle-card.bat .arc{position:absolute;inset:-2px;
  border-radius:50%;
  background:conic-gradient(from -90deg,
    var(--bat) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1% + 4%),
    transparent 0);
  -webkit-mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px));
  mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px))}
.wirebox{position:relative;max-width:960px;margin:0 auto}
.wires{position:absolute;inset:0;width:100%;height:300px;
  pointer-events:none;z-index:-1}
.wires path{fill:none;stroke-width:3;
  stroke-linecap:round;stroke-dasharray:10 14;
  animation:dash 1.2s linear infinite}
@keyframes dash{to{stroke-dashoffset:-24}}
@media (prefers-reduced-motion:reduce){
  .wires path{animation:none}}
.w-pv{stroke:var(--pv);
  filter:drop-shadow(0 0 4px var(--pv))}
.w-bat{stroke:var(--cyan);
  filter:drop-shadow(0 0 4px var(--cyan))}
@media (max-width:820px){
  .circle-card.haus{margin-top:0}
}
.tile-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:16px;width:94%;max-width:1100px;margin:20px auto}
.tile{background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.15);padding:16px}
.tile h2{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--cyan);text-transform:uppercase;
  letter-spacing:1px}
.tile.span2{grid-column:1/-1}
.bigval{font-size:40px;font-weight:800;
  letter-spacing:-1px;line-height:1.1}
.bigval{display:flex;justify-content:center;align-items:baseline;column-gap:9px}
.bigval ftui-label{display:inline-flex}
.bigval small{font-size:18px;color:var(--dim);
  font-weight:600}
.minirow{display:flex;justify-content:space-around;
  text-align:center;margin:6px 0}
.minirow .mi .ic{font-size:26px}
.minirow .mi .mv{font-size:20px;font-weight:800}
.minirow .mi .mv small{font-size:12px;color:var(--dim)}
.minirow .mi .ml{font-size:11px;color:var(--dim)}
.kv .v{white-space:nowrap}
.kv .v ftui-label{display:inline}
.wrled-row{display:flex;justify-content:space-around;flex-wrap:wrap;gap:12px}
.wrled{flex:1;min-width:180px;max-width:260px}
.wrsvg{width:100%;height:auto;display:block}
.wrsvg .fin{fill:#222a3b;stroke:#303b52}
.wrsvg .panel{fill:#0b0f1a;stroke:#27324a}
.wrsvg .wrt{fill:#00ffff;font-weight:800;font-size:15px;letter-spacing:1px}
.wrsvg .wrs{fill:#8496ab;font-size:9px;letter-spacing:.5px}
.wrsvg .wri{fill:#e0e0e0;font-size:10px;font-weight:600}
.wrsvg .ledt{fill:#8496ab;font-size:10px;font-weight:700;letter-spacing:1px}
.wrsvg .led{fill:#262e3f;stroke:#39455f;stroke-width:1}
.wrsvg .led.on,.wrsvg .led.b1,.wrsvg .led.b2{fill:var(--lc,#4caf50);filter:drop-shadow(0 0 5px var(--lc,#4caf50))}
.wrsvg .led.b1{animation:ledbl 1.6s steps(1) infinite}
.wrsvg .led.b2{animation:ledbl .5s steps(1) infinite}
@keyframes ledbl{50%{fill:#262e3f;filter:none}}
@media (prefers-reduced-motion:reduce){.wrsvg .led.b1,.wrsvg .led.b2{animation:none;opacity:.6}}
.wrled-leg{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-top:8px;font-size:11px;color:var(--dim)}
.wrled-leg span{display:flex;align-items:center;gap:5px}
.wrled-leg .lg{display:inline-block;width:9px;height:9px;border-radius:50%;background:#262e3f;border:1px solid #39455f}
.wrled-leg .lg.on,.wrled-leg .lg.b1,.wrled-leg .lg.b2{background:#4caf50;box-shadow:0 0 5px #4caf50}
.wrled-leg .lg.b1{animation:lgbl 1.6s steps(1) infinite}
.wrled-leg .lg.b2{animation:lgbl .5s steps(1) infinite}
@keyframes lgbl{50%{background:#262e3f;box-shadow:none}}
</style>
</head>
<body>

<div class="navshade" id="navshade"></div>
<nav class="sidenav" id="sidenav">
  <div class="brand">SMART HOME</div>
    <a href="uebersicht.html">⚡ Übersicht</a>
    <a href="pv.html" class="active">🔆 PV-Anlage</a>
    <a href="heizung.html">♨️ Heizung live</a>
    <a href="klima.html">🔥 Heizung</a>
    <a href="ertrag.html">&#128182; Ertrag</a>
    <a href="eauto.html">🚗 E-Autos</a>
  <a href="tobi.html">👤 Tobi</a>
    <a href="geraete.html">🛠️ Geräte</a>
    <a href="monitor.html">🛡️ Monitoring</a>
    <a href="steuerung.html">🎛️ Steuerung</a>
    <a href="/fhem" style="border-top:1px solid rgba(255,255,255,.1)">⚙️ FHEM</a>
</nav>

<div class="main">
  <div class="headbar">

  <button class="burger" id="burger">☰</button>
  <div class="hi">🚗 <ftui-label
    [text]="OpenWB_Garage_links:Ladeleistung_gesamt_kW"></ftui-label>
    / <ftui-label
    [text]="OpenWB_Garage_rechts:Ladeleistung_gesamt_kW"></ftui-label>
    <span class="u">kW</span></div>
  <div class="hi">🔆 <ftui-label
    [text]="di_DashWerte:PV_gesamt"></ftui-label>
    <span class="u">W</span></div>
  <div class="hi">🔋 <ftui-label
    [text]="di_DashWerte:SOC_gew"></ftui-label>
    <span class="u">%</span></div>
  <div class="spacer"></div>
  <div class="hi">🌡️ <ftui-label
    [text]="BresserWetter:temperatur_aussen"></ftui-label>
    <span class="u">°C</span></div>
  <div class="clock" id="clock"></div>

  </div>

<style>
.pv-wrap{width:94%;max-width:1400px;margin:14px auto 24px}
.pv-top{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.pv-tab{background:#161e2e;border:1px solid #1f2a3e;color:#9fb0c5;font-size:13px;padding:6px 14px;border-radius:99px;cursor:pointer;font-family:inherit}
.pv-tab.on{color:#0b0f1a;background:#facc15;border-color:#facc15;font-weight:700}
.pv-upd{margin-left:auto;font-size:11px;color:#6b7c93}
.pv-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:14px}
.pv-kpi{background:linear-gradient(160deg,#141b2b,#0f1522);border:1px solid #1d2638;border-radius:16px;padding:13px 15px;position:relative;overflow:hidden}
.pv-kpi .l{font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:#6b7c93}
.pv-kpi .v{font-size:27px;font-weight:800;margin-top:4px;font-variant-numeric:tabular-nums}
.pv-kpi .v small{font-size:13px;color:#8496ab;font-weight:600;margin-left:2px}
.pv-kpi .s{font-size:11px;color:#8496ab;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pv-kpi .bar{position:absolute;left:0;bottom:0;height:3px;border-radius:0 3px 0 0}
.pv-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:14px;margin-bottom:14px}
.pv-grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,560px),1fr));gap:14px;margin-bottom:14px}
.pv-card{background:linear-gradient(160deg,#141b2b,#0f1522);border:1px solid #1d2638;border-radius:18px;padding:14px 16px;margin-bottom:14px}
.pv-grid .pv-card,.pv-grid2 .pv-card{margin-bottom:0}
.pv-card h2{margin:0 0 10px;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:#facc15;display:flex;align-items:center;gap:10px}
.pv-card h2 small{font-size:11px;color:#6b7c93;letter-spacing:0;text-transform:none;font-weight:500}
.pv-card h2 .r{margin-left:auto;display:flex;gap:4px}
.pv-rb{background:#161e2e;border:1px solid #1f2a3e;color:#9fb0c5;font-size:11px;padding:3px 9px;border-radius:99px;cursor:pointer;font-family:inherit;letter-spacing:0;text-transform:none}
.pv-rb.on{color:#facc15;border-color:rgba(250,204,21,.5)}
.pv-src .hero{display:flex;align-items:baseline;gap:6px;margin:2px 0 8px}
.pv-src .hero b{font-size:34px;font-weight:800;font-variant-numeric:tabular-nums}
.pv-src .hero span{color:#8496ab;font-size:14px}
.pv-src .pb{height:5px;border-radius:5px;background:#1b2437;overflow:hidden;margin-bottom:8px}.pv-src .pb i{display:block;height:100%;border-radius:5px}
.pv-rows div{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:13px}
.pv-rows .k{color:#8496ab}.pv-rows .v{font-weight:700;font-variant-numeric:tabular-nums}
.pv-rows .v small{color:#8496ab;font-weight:600;margin-left:3px}
.pv-leg{display:flex;gap:10px;flex-wrap:wrap;font-size:11px;color:#8496ab;margin:0 0 4px}
.pv-leg span{cursor:pointer;user-select:none;padding:2px 6px;border-radius:8px}.pv-leg span:hover{background:#151d2d}.pv-leg span.off{opacity:.38;text-decoration:line-through}
.pv-leg i{display:inline-block;width:14px;height:3px;border-radius:2px;vertical-align:middle;margin-right:5px}
.pv-ch svg{width:100%;height:auto;display:block}
.pv-am{margin-bottom:12px}.pv-am .hd{display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px}.pv-am .hd span{color:#8496ab}
.pv-am .bar{position:relative;height:9px;border-radius:9px;background:#1b2437}.pv-am .bar i{display:block;height:100%;border-radius:9px;background:linear-gradient(90deg,#f59e0b,#facc15)}
.pv-am .bar u{position:absolute;top:-3px;bottom:-3px;width:2px;background:#e8eef6;border-radius:1px}
.pv-am .ft{display:flex;gap:12px;flex-wrap:wrap;font-size:11px;color:#6b7c93;margin-top:5px}
.pv-pos{color:#34d399}.pv-neg{color:#f87171}
.pv-empty{color:#6b7c93;font-size:12.5px;padding:8px 2px}
.pv-embed .headbar,.pv-embed .sidenav,.pv-embed .navshade{display:none!important}.pv-embed .pv-wrap{width:100%;margin:0}
</style>
<div class="pv-wrap">
  <div class="pv-top" id="pv_tabs"></div>
  <div class="pv-kpis" id="pv_kpis"></div>
  <div class="pv-grid" id="pv_src"></div>
  <div class="pv-card"><h2>Tagesverlauf Erzeugung <small>je Quelle</small><span class="r" data-g="e"></span></h2><div class="pv-leg" id="pv_le"></div><div class="pv-ch" id="pv_ce"></div></div>
  <div class="pv-grid2">
    <div class="pv-card"><h2>Netz · Verbrauch · Akku<span class="r" data-g="n"></span></h2><div class="pv-leg" id="pv_ln"></div><div class="pv-ch" id="pv_cn"></div></div>
    <div class="pv-card"><h2>Akku-Ladestand<span class="r" data-g="s"></span></h2><div class="pv-leg" id="pv_ls"></div><div class="pv-ch" id="pv_cs"></div></div>
  </div>
  <div class="pv-grid2">
    <div class="pv-card"><h2>Ertrag</h2><div class="pv-rows" id="pv_ertrag"></div></div>
    <div class="pv-card"><h2 id="pv_jbh">Jahresbilanz</h2><div id="pv_jb"></div></div>
  </div>
</div>
<script>
(function(){
function R(d,r){return d+':'+r;}
var LOG='FileLog_PVChart',CH='du_PVChart';
var SITES=[
 {id:'g',name:'Große Anlage',base:'http://192.168.176.205:8084',
  src:[
   {n:'GW 5877',sub:'West · Garage',p:R('GoodWe_Garage_Haus_West_5877','PV_Total_Power'),max:13000,c:'#fde047',log:'PV_5877',
    rows:[['String 1',R('GoodWe_Garage_Haus_West_5877','PV_1_Power'),'W'],['String 2',R('GoodWe_Garage_Haus_West_5877','PV_2_Power'),'W'],['Heute',R('GoodWe_Garage_Haus_West_5877','Erz_PV_DC_Energie_kWh_day'),'kWh'],['Akku',R('GoodWe_Garage_Haus_West_5877','Power_Battery'),'W'],['SOC',R('GoodWe_Garage_Haus_West_5877','SOC'),'%'],['Modus',R('GoodWe_Garage_Haus_West_5877','EMSPowerModeText'),'t']]},
   {n:'GW 5876',sub:'Ost · Mitte',p:R('GoodWe_Haus_Ost_Mitte_5876','PV_Total_Power'),max:10000,c:'#fb923c',log:'PV_5876',
    rows:[['String 1',R('GoodWe_Haus_Ost_Mitte_5876','PV_1_Power'),'W'],['String 2',R('GoodWe_Haus_Ost_Mitte_5876','PV_2_Power'),'W'],['Heute',R('GoodWe_Haus_Ost_Mitte_5876','Erz_PV_DC_Energie_kWh_day'),'kWh'],['Akku',R('GoodWe_Haus_Ost_Mitte_5876','Power_Battery'),'W'],['SOC',R('GoodWe_Haus_Ost_Mitte_5876','SOC'),'%'],['Modus',R('GoodWe_Haus_Ost_Mitte_5876','EMSPowerModeText'),'t']]},
   {n:'Deye',sub:'Gauben · Hütte',p:R('myShelly_Technikraum_Deye_PM_L1','Total_Power_i'),abs:1,max:8000,c:'#a3e635',log:'PV_Deye',
    rows:[['Heute',R('myShelly_Technikraum_Deye_PM_L1','Deye_kWh_day'),'kWh'],['Monat',R('myShelly_Technikraum_Deye_PM_L1','Deye_kWh_month'),'kWh'],['Jahr',R('myShelly_Technikraum_Deye_PM_L1','Deye_kWh_year'),'kWh'],['Offline',R('myShelly_Technikraum_Deye_PM_L1','Deye_offline'),'t']]}],
  kp:{einsp:R('HA_SDM630M_Nergie','Einspeiseleistung'),bezug:R('HA_SDM630M_Nergie','Bezugsleistung'),soc:R('di_DashWerte','SOC_gew'),wp:R('HA_SDM630M_Heatpump','Power_Sum__W1'),
      heute:R('myShelly_Technikraum_Deye_PM_L1','PV_Gesamt_kWh_day'),monat:R('myShelly_Technikraum_Deye_PM_L1','PV_Gesamt_kWh_month'),jahr:R('myShelly_Technikraum_Deye_PM_L1','PV_Gesamt_kWh_year'),
      zaehler:R('HA_SDM630M_PV_Erzeugung','Erz_PV_Energie_kWh_day'),eheute:R('HA_SDM630M_Nergie','statSald_Einspeiseenergie_kWhDay'),bheute:R('HA_SDM630M_Nergie','statSald_Bezugsenergie_kWhDay')}},
 {id:'k',name:'S9',base:'http://192.168.178.21:8084',
  src:[
   {n:'GoodWe',sub:'Haus',p:R('GoodWe','PV_Total_Power'),max:10000,c:'#fde047',log:'PV_GW',
    rows:[['String 1',R('GoodWe','PV_1_Power'),'W'],['String 2',R('GoodWe','PV_2_Power'),'W'],['Heute',R('GoodWe','Erz_PV_DC_Energie_kWh_day'),'kWh'],['Monat',R('GoodWe','Erz_PV_DC_Energie_kWh_month'),'kWh'],['Akku',R('GoodWe','Power_Battery'),'W'],['SOC',R('GoodWe','SOC'),'%']]},
   {n:'Deye',sub:'Hütte',p:R('smart_meter_PV_Deye','Power_Deye_gesamt_Huette'),abs:1,max:4000,c:'#fb923c',log:'PV_Deye',
    rows:[['Heute',R('smart_meter_PV_Deye','Erz_Deye_DC_Energie_kWh_day'),'kWh'],['Monat',R('smart_meter_PV_Deye','Erz_Deye_DC_Energie_kWh_month'),'kWh'],['Jahr',R('smart_meter_PV_Deye','Erz_Deye_DC_Energie_kWh_year'),'kWh']]},
   {n:'Deye',sub:'Garage',p:R('myShelly_Garage_Deye','Total_Power'),abs:1,max:2000,c:'#a3e635',log:'PV_Garage',rows:[]}],
  kp:{einsp:R('HA_SDM630M_Nergie','Einspeiseleistung'),bezug:R('HA_SDM630M_Nergie','Bezugsleistung'),soc:R('GoodWe','SOC'),wp:R('HA_SDM630M_Heatpump','Power_Sum__W'),
      heute:R('HA_SDM630M_PV_Erzeugung','Erz_PV_Energie_kWh_day'),monat:R('HA_SDM630M_PV_Erzeugung','Erz_PV_Energie_kWh_month'),jahr:R('HA_SDM630M_PV_Erzeugung','Erz_PV_Energie_kWh_year'),
      zaehler:null,eheute:R('HA_SDM630M_Nergie','statSald_Einspeiseenergie_kWhDay'),bheute:R('HA_SDM630M_Nergie','statSald_Bezugsenergie_kWhDay')}}
];
var NET=[['Einsp','Einspeisung','#10b981'],['Bezug','Netzbezug','#f43f5e'],['WP','Wärmepumpe','#8b5cf6'],['Bat','Akku (+ Entladung)','#38bdf8']];
var cur=(/^192\.168\.178\./.test(location.hostname))?'k':'g',RANGE={e:24,n:24,s:72},M={},LAST={},HID={};
try{HID=JSON.parse(localStorage.getItem('pv_hide_v1')||'{}')||{};}catch(e){HID={};}
function site(){return SITES.filter(function(x){return x.id==cur;})[0];}
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function req(s,cmd){
  var go=function(){return fetch(s.base+'/fhem?cmd='+encodeURIComponent(cmd)+'&XHR=1&fwcsrf='+encodeURIComponent(s.tok||''),{cache:'no-store'}).then(function(r){if(!r.ok)throw r.status;return r.text();});};
  var tk=function(){return fetch(s.base+'/fhem?XHR=1',{cache:'no-store'}).then(function(r){s.tok=r.headers.get('X-FHEM-csrfToken')||'';});};
  return (s.tok===undefined?tk().then(go):go()).catch(function(){return tk().then(go);});}
function G(ref){if(!ref)return null;var p=ref.split(':');try{return M[p[0]][p[1]];}catch(e){return null;}}
function T(ref){var g=G(ref);return g?String(g.Value):'';}
function N(ref){var g=G(ref);if(!g)return NaN;return parseFloat(String(g.Value).replace(',','.'));}
function nf(v,d){return isNaN(v)?'–':v.toLocaleString('de-DE',{minimumFractionDigits:d,maximumFractionDigits:d});}
function W(v){if(isNaN(v))return '–';return Math.abs(v)>=1000?nf(v/1000,2)+'<small>kW</small>':nf(v,0)+'<small>W</small>';}
function fv(v,u){if(u=='t')return esc(v);var x=parseFloat(String(v).replace(',','.'));if(isNaN(x))return '–';if(u=='W')return W(x);return nf(x,u=='kWh'?(x>=100?0:1):0)+'<small>'+u+'</small>';}
function devs(s){var d={};function a(r){if(r)d[r.split(':')[0]]=1;}s.src.forEach(function(q){a(q.p);q.rows.forEach(function(r){a(r[1]);});});Object.keys(s.kp).forEach(function(k){a(s.kp[k]);});d.di_PV_Jahresbilanz=1;d.Tarife=1;return Object.keys(d);}
function tabs(){document.getElementById('pv_tabs').innerHTML=SITES.map(function(s){return '<button class="pv-tab'+(s.id==cur?' on':'')+'" data-s="'+s.id+'">'+s.name+'</button>';}).join('')+'<span class="pv-upd" id="pv_upd"></span>';
  [].forEach.call(document.querySelectorAll('.pv-card h2 .r'),function(r){var g=r.dataset.g;r.innerHTML=[24,72,168].map(function(h){return '<button class="pv-rb'+(RANGE[g]==h?' on':'')+'" data-g="'+g+'" data-h="'+h+'">'+(h<48?h+' h':h/24+' T')+'</button>';}).join('');});}
function live(){var s=site();return req(s,'jsonlist2 '+devs(s).join(',')).then(function(t){var j=JSON.parse(t);M={};j.Results.forEach(function(x){M[x.Name]=x.Readings||{};});render(s);})
  .catch(function(e){document.getElementById('pv_kpis').innerHTML='<div class="pv-empty" style="color:#f87171">'+esc(s.name)+' nicht abrufbar: '+esc(e)+'</div>';});}
function render(s){var tot=0,k=s.kp;
  var sh=s.src.map(function(q){var v=N(q.p);if(q.abs)v=Math.abs(v);if(!isNaN(v))tot+=v;var p=isNaN(v)?0:Math.max(0,Math.min(100,v/q.max*100));
    return '<div class="pv-card pv-src" style="border-top:3px solid '+q.c+'"><h2 style="color:'+q.c+'">'+esc(q.n)+' <small>'+esc(q.sub)+'</small></h2><div class="hero"><b style="color:'+q.c+'">'+(isNaN(v)?'–':nf(v,0))+'</b><span>W</span></div><div class="pb"><i style="width:'+p+'%;background:'+q.c+'"></i></div><div class="pv-rows">'+
      q.rows.map(function(r){var g=G(r[1]);if(!g)return '';return '<div><span class="k">'+r[0]+'</span><span class="v">'+fv(g.Value,r[2])+'</span></div>';}).join('')+'</div></div>';}).join('');
  document.getElementById('pv_src').innerHTML=sh;
  var e=N(k.einsp),b=N(k.bezug),soc=N(k.soc),wp=N(k.wp);
  var KP=[['PV jetzt',W(tot),'Quellen: '+s.src.length,'#facc15',tot/Math.max(1,s.src.reduce(function(a,q){return a+q.max;},0))*100],
   ['Einspeisung',W(e),'heute '+nf(N(k.eheute),1)+' kWh','#10b981'],['Netzbezug',W(b),'heute '+nf(N(k.bheute),1)+' kWh','#f43f5e'],
   ['Akku',(isNaN(soc)?'–':nf(soc,0))+'<small>%</small>','Ladestand','#38bdf8',soc],['Wärmepumpe',W(wp),'aktuell','#8b5cf6'],
   ['Ertrag heute',nf(N(k.heute),1)+'<small>kWh</small>','Monat '+nf(N(k.monat),0)+' · Jahr '+nf(N(k.jahr),0)+' kWh','#fde047']];
  document.getElementById('pv_kpis').innerHTML=KP.map(function(x){return '<div class="pv-kpi"><div class="l">'+x[0]+'</div><div class="v" style="color:'+x[3]+'">'+x[1]+'</div><div class="s">'+x[2]+'</div>'+(x[4]!=null&&!isNaN(x[4])?'<div class="bar" style="width:'+Math.max(0,Math.min(100,x[4]))+'%;background:'+x[3]+'"></div>':'')+'</div>';}).join('');
  var er=[['PV-Ertrag heute',N(k.heute)],['PV-Ertrag Monat',N(k.monat)],['PV-Ertrag Jahr',N(k.jahr)]];
  if(k.zaehler)er.push(['PV-Zähler heute',N(k.zaehler)]);
  s.src.forEach(function(q){q.rows.forEach(function(r){if(r[0]=='Heute'&&G(r[1]))er.push([q.n+' '+q.sub+' heute',N(r[1])]);});});
  er.push(['Einspeisung heute',N(k.eheute)],['Netzbezug heute',N(k.bheute)]);
  var pe=N('Tarife:einsp_eur_kwh'),pb=N('Tarife:bezug_eur_kwh');
  var eu=(!isNaN(pe)&&!isNaN(N(k.eheute)))?N(k.eheute)*pe:NaN,ku=(!isNaN(pb)&&!isNaN(N(k.bheute)))?N(k.bheute)*pb:NaN;
  document.getElementById('pv_ertrag').innerHTML=er.map(function(x){return '<div><span class="k">'+x[0]+'</span><span class="v">'+nf(x[1],(x[1]>=100?0:1))+'<small>kWh</small></span></div>';}).join('')+
   '<div><span class="k">Einspeiseerlös heute</span><span class="v pv-pos">'+nf(eu,2)+' €</span></div><div><span class="k">Netzbezugskosten heute</span><span class="v pv-neg">'+nf(ku,2)+' €</span></div>';
  jb();
  var u=document.getElementById('pv_upd');if(u){var d=new Date();u.textContent='aktualisiert '+('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'+('0'+d.getSeconds()).slice(-2);}}
function jb(){var J=function(r){return N('di_PV_Jahresbilanz:'+r);},el=document.getElementById('pv_jb');
  document.getElementById('pv_jbh').innerHTML='Jahresbilanz '+new Date().getFullYear()+' <small>Erzeugung · Einspeisung · Erlöse</small>';
  if(isNaN(J('ist_kwh_erz_PV_Energie_akt_Jahr'))){el.innerHTML='<div class="pv-empty">Keine Jahresbilanz (di_PV_Jahresbilanz) auf dieser Anlage.</div>';return;}
  var sp=J('soll_prozent_bis_heute'),ab=J('einsp_abweichung_kwh'),ad=T('di_PV_Jahresbilanz:einsp_ausgleich_datum').replace(/_/g,' ')||'–';
  function bar(t,ist,pist,ft){return '<div class="pv-am"><div class="hd"><span>'+t+'</span><b>'+nf(ist,0)+' kWh</b></div><div class="bar"><i style="width:'+Math.max(0,Math.min(100,pist||0))+'%"></i><u title="Soll bis heute" style="left:'+Math.max(0,Math.min(100,sp||0))+'%"></u></div><div class="ft">'+ft.map(function(x){return '<span>'+x+'</span>';}).join('')+'</div></div>';}
  el.innerHTML=bar('Erzeugung',J('ist_kwh_erz_PV_Energie_akt_Jahr'),J('ist_prozent_jahressoll'),['Soll bis heute '+nf(J('soll_bis_heute_kwh'),0),'Hochrechnung '+nf(J('hochrechnung_jahr_kwh'),0),'Performance '+nf(J('performance_prozent'),1)+' %'])+
   bar('Einspeisung',J('einsp_ist_kwh'),J('einsp_prozent_jahressoll'),['Soll bis heute '+nf(J('einsp_soll_bis_heute_kwh'),0),'Abweichung '+(ab>0?'+':'')+nf(ab,0),'im Plan ab '+esc(ad)])+
   '<div class="pv-rows"><div><span class="k">Einspeiseerlös seit 1.1.</span><span class="v pv-pos">'+nf(J('einsp_erloes_eur_ytd'),2)+' €</span></div>'+
   '<div><span class="k">Ersparnis Eigenverbrauch ('+nf(J('eigenverbrauch_kwh_ytd'),0)+' kWh)</span><span class="v pv-pos">'+nf(J('ersparnis_eur_ytd'),2)+' €</span></div>'+
   '<div><span class="k"><b>Nutzen seit 1.1.</b></span><span class="v pv-pos">'+nf(J('nutzen_eur_ytd'),2)+' €</span></div>'+
   '<div><span class="k">Hochrechnung Nutzen Jahr</span><span class="v">'+nf(J('nutzen_eur_hochrechnung_jahr'),0)+' €</span></div></div>'+
   '<div class="pv-am"><div class="ft">berechnet '+esc(T('di_PV_Jahresbilanz:letzte_berechnung')||'–')+'</div></div>';}
function ts(d){return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2)+'_'+('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':00';}
function series(g){var s=site();if(g=='e')return s.src.map(function(q){return [q.log,q.n+' '+q.sub,q.c];}).concat([['PV','PV gesamt','#e8eef6']]);if(g=='n')return NET;return [['SOC','SOC','#38bdf8']];}
function hist(g){var s=site(),sr=series(g),h=RANGE[g],fr=new Date(Date.now()-h*3600000),to=new Date(Date.now()+60000);
  var spec=sr.map(function(x){return '4:'+CH+'.'+x[0]+'\\x3a::';}).join(' ');
  return req(s,'get '+LOG+' - - '+ts(fr)+' '+ts(to)+' '+spec).then(function(t){var parts=[],cp=[];t.split('\n').forEach(function(l){if(l.charAt(0)=='#'){parts.push(cp);cp=[];return;}var m=l.match(/^(\d{4})-(\d\d)-(\d\d)_(\d\d):(\d\d):(\d\d)\s+(-?[\d.]+)/);if(m)cp.push([new Date(+m[1],m[2]-1,+m[3],+m[4],+m[5],+m[6]).getTime(),parseFloat(m[7])]);});
    draw(g,sr.map(function(x,i){return {k:x[0],l:x[1],c:x[2],pts:parts[i]||[]};}),fr.getTime(),Date.now());}).catch(function(){draw(g,sr.map(function(x){return {k:x[0],l:x[1],c:x[2],pts:[]};}),fr.getTime(),Date.now());});}
function hk(g,z){return cur+'|'+g+'|'+z.k;}
function draw(g,ser,t0,t1){LAST[g]=[ser,t0,t1];var W0=g=='e'?1000:640,H=g=='s'?220:(g=='e'?300:260),L=46,Rr=10,T0=10,B=24,pw=W0-L-Rr,ph=H-T0-B,mn=g=='s'?0:Infinity,mx=g=='s'?100:-Infinity;
  if(g!='s')ser.forEach(function(z){if(HID[hk(g,z)])return;z.pts.forEach(function(p){if(p[0]<t0)return;if(p[1]<mn)mn=p[1];if(p[1]>mx)mx=p[1];});});
  document.getElementById('pv_l'+g).innerHTML=ser.map(function(z,i){return '<span data-lg="'+g+'" data-li="'+i+'"'+(HID[hk(g,z)]?' class="off"':'')+'><i style="background:'+z.c+'"></i>'+esc(z.l)+(z.pts.length?'':' (keine Daten)')+'</span>';}).join('');
  var el=document.getElementById('pv_c'+g);if(mn==Infinity){el.innerHTML='<div class="pv-empty">Keine Verlaufsdaten im Zeitraum – '+LOG+' füllt sich ab Einrichtung.</div>';return;}
  if(g!='s'){mn=Math.min(0,mn);var st=mx>5000?1000:(mx>1000?500:100);mx=Math.ceil(mx*1.05/st)*st;mn=Math.floor(mn/st)*st;if(mx<=mn)mx=mn+st;}
  function X(t){return L+(t-t0)/(t1-t0)*pw;}function Y(v){return T0+ph-(v-mn)/(mx-mn)*ph;}
  var s='<svg viewBox="0 0 '+W0+' '+H+'"><defs>'+ser.map(function(z,i){return '<linearGradient id="pvg'+g+i+'" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="'+z.c+'" stop-opacity=".30"/><stop offset="1" stop-color="'+z.c+'" stop-opacity="0"/></linearGradient>';}).join('')+'</defs>';
  for(var i=0;i<=4;i++){var v=mn+(mx-mn)*i/4,y=Y(v);s+='<line x1="'+L+'" x2="'+(W0-Rr)+'" y1="'+y+'" y2="'+y+'" stroke="#1b2437"/><text x="'+(L-6)+'" y="'+(y+3)+'" fill="#5b6b82" font-size="11" text-anchor="end">'+(g=='s'?Math.round(v)+'%':(Math.abs(v)>=1000?(v/1000).toFixed(1)+'k':Math.round(v)))+'</text>';}
  if(mn<0)s+='<line x1="'+L+'" x2="'+(W0-Rr)+'" y1="'+Y(0)+'" y2="'+Y(0)+'" stroke="#334155"/>';
  var span=t1-t0,step=span>100*3600000?24:(span>30*3600000?6:(span>13*3600000?3:1));var d0=new Date(t0);d0.setMinutes(0,0,0);
  for(var t=d0.getTime();t<=t1;t+=3600000){var dd=new Date(t);if(dd.getHours()%step)continue;var x=X(t);if(x<L)continue;s+='<line x1="'+x+'" x2="'+x+'" y1="'+T0+'" y2="'+(T0+ph)+'" stroke="#161e2e"/><text x="'+x+'" y="'+(H-6)+'" fill="#5b6b82" font-size="11" text-anchor="middle">'+(dd.getHours()==0&&step>=3?dd.getDate()+'.'+(dd.getMonth()+1)+'.':dd.getHours()+'h')+'</text>';}
  ser.forEach(function(z,i){if(HID[hk(g,z)])return;var pts=z.pts.filter(function(p){return p[0]>=t0;});if(!pts.length)return;
    var d='M'+X(pts[0][0]).toFixed(1)+' '+Y(pts[0][1]).toFixed(1);for(var k=1;k<pts.length;k++){if(pts[k][0]-pts[k-1][0]>20*60000)d+=' M';else d+=' L';d+=X(pts[k][0]).toFixed(1)+' '+Y(pts[k][1]).toFixed(1);}
    var tot=(z.k=='PV');
    if(!tot&&(g=='e'||g=='s'||z.k=='Einsp'))s+='<path d="'+d.replace(/ M/g,' L')+' L'+X(pts[pts.length-1][0]).toFixed(1)+' '+Y(Math.max(mn,0))+' L'+X(pts[0][0]).toFixed(1)+' '+Y(Math.max(mn,0))+' Z" fill="url(#pvg'+g+i+')"/>';
    s+='<path d="'+d+'" fill="none" stroke="'+z.c+'" stroke-width="'+(tot?1.4:2)+'" stroke-linejoin="round"'+(tot?' stroke-dasharray="5 4"':'')+'/>';
    var lp=pts[pts.length-1];s+='<circle cx="'+X(lp[0])+'" cy="'+Y(lp[1])+'" r="3" fill="'+z.c+'"/>';});
  el.innerHTML=s+'</svg>';}
function all(){live();hist('e');hist('n');hist('s');}
document.addEventListener('click',function(ev){var lg=ev.target.closest?ev.target.closest('.pv-leg span[data-lg]'):null;
  if(lg){var g=lg.dataset.lg,Lx=LAST[g];if(!Lx)return;var k=hk(g,Lx[0][+lg.dataset.li]);if(HID[k])delete HID[k];else HID[k]=1;try{localStorage.setItem('pv_hide_v1',JSON.stringify(HID));}catch(e){}draw(g,Lx[0],Lx[1],Lx[2]);return;}
  var t=ev.target.closest?ev.target.closest('.pv-tab,.pv-rb'):null;if(!t)return;
  if(t.dataset.s){cur=t.dataset.s;M={};tabs();all();}else if(t.dataset.g){RANGE[t.dataset.g]=+t.dataset.h;tabs();hist(t.dataset.g);}});
function initNav(){var b=document.getElementById('burger'),n=document.getElementById('sidenav'),s=document.getElementById('navshade');if(!b||!n||!s)return;function t(){n.classList.toggle('open');s.classList.toggle('open');}b.addEventListener('click',t);s.addEventListener('click',t);}
function startClock(){var c=document.getElementById('clock');if(!c)return;function t(){var d=new Date();c.textContent=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);}t();setInterval(t,10000);}
function start(){if(/[?&]embed=1/.test(location.search))document.body.classList.add('pv-embed');else{initNav();startClock();}
  var q=location.search.match(/[?&]anlage=(g|k)/);if(q)cur=q[1];
  tabs();all();setInterval(function(){if(!document.hidden)live();},15000);setInterval(function(){if(!document.hidden){hist('e');hist('n');hist('s');}},120000);}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>
<script src="ue-arrange.js?v=12"></script>
</div>
</body>
</html>
