<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes"/>
<title>Übersicht</title>
<script src="../ftui.js"></script>
<link href="../ftui.css" rel="stylesheet"/>
<link href="../themes/ftui-theme.css" rel="stylesheet"/>
<style>
:root{
  --bg:#0b0f1a; --card:#121826; --card2:#1a1f2e;
  --line:#1d2638; --txt:#e0e0e0; --dim:#8496ab;
  --cyan:#00ffff; --pv:#ffb300; --haus:#2196f3;
  --bat:#4caf50; --warm:#ff7043;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--bg);
  color:var(--txt);font-family:"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased}
body{min-height:100vh}
.sidenav{width:230px;background:#0a0e18;
  border-right:1px solid var(--line);padding:18px 0;
  position:fixed;top:0;left:0;height:100vh;z-index:20;
  transform:translateX(-100%);
  transition:transform .25s ease;
  box-shadow:0 0 30px rgba(0,0,0,.6)}
.sidenav.open{transform:translateX(0)}
.navshade{position:fixed;inset:0;background:rgba(0,0,0,.5);
  z-index:15;display:none}
.navshade.open{display:block}
.burger{background:none;border:none;color:var(--txt);
  font-size:22px;cursor:pointer;padding:4px 8px;
  line-height:1}
.sidenav .brand{color:var(--cyan);font-weight:800;
  font-size:17px;letter-spacing:1px;padding:0 20px 16px;
  border-bottom:1px solid var(--line);margin-bottom:10px}
.sidenav a{display:flex;align-items:center;gap:10px;
  padding:12px 20px;color:var(--dim);font-weight:600;
  font-size:15px;text-decoration:none;
  border-left:3px solid transparent}
.sidenav a.active{color:var(--txt);background:#0e1524;
  border-left-color:var(--cyan)}
.sidenav a:hover{color:var(--txt)}
.main{flex:1;min-width:0;padding-bottom:30px}
.headbar{display:flex;align-items:center;gap:18px;
  flex-wrap:wrap;padding:10px 20px;background:#0a0e18;
  border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:5}
.headbar .hi{display:flex;align-items:center;gap:6px;
  font-weight:700;font-size:14px}
.headbar .hi .u{color:var(--dim);font-weight:600;
  font-size:12px}
.headbar .spacer{flex:1}
.headbar .clock{font-size:18px;font-weight:800;
  color:var(--cyan)}
.wide-card{margin:24px auto;width:92%;max-width:1000px;
  background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.2);padding:20px}
.wide-card h2{margin:0 0 12px;font-size:16px;
  font-weight:700;color:var(--cyan)}
.wr-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:16px}
.wr{background:var(--card2);border-radius:10px;
  padding:14px 16px;
  box-shadow:0 0 10px rgba(255,255,255,.08)}
.wr h3{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--pv);text-transform:uppercase;
  letter-spacing:1px}
.wr.gruen h3{color:var(--bat)}
.wr.blau h3{color:var(--haus)}
.wr.warm h3{color:var(--warm)}
.kv{display:flex;align-items:baseline;gap:8px;
  padding:5px 0;border-bottom:1px solid #131c2a;
  font-size:14px}
.kv:last-child{border-bottom:none}
.kv .k{flex:1;color:var(--dim)}
.kv .v{font-weight:700;font-size:16px}
.kv .u{color:var(--dim);font-size:12px}
.stats-row{display:flex;justify-content:space-around;
  flex-wrap:wrap;gap:12px;margin-top:8px}
.stat{background:var(--card2);border-radius:8px;
  padding:10px 20px;min-width:150px;flex:1;
  box-shadow:0 0 10px rgba(255,255,255,.1);
  text-align:center}
.stat .sl{color:var(--dim);font-size:13px}
.stat .sv{font-size:20px;font-weight:800}
.stat .sv small{font-size:12px;font-weight:600;
  color:var(--dim)}
.circle-row{display:flex;justify-content:space-around;
  align-items:flex-start;flex-wrap:wrap;gap:20px;
  margin-top:26px;padding:0 12px}
.circle-card{position:relative;width:200px;height:200px;
  border-radius:50%;padding:20px;text-align:center;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:2px;
  background:radial-gradient(circle at center,
    var(--card2) 0%,var(--bg) 100%);
  box-shadow:0 0 20px rgba(0,255,255,.3)}
.circle-card.haus{margin-top:60px}
.circle-card h3{margin:0 0 4px;font-size:14px;
  font-weight:700;color:var(--cyan);
  text-transform:uppercase;letter-spacing:1px}
.circle-card .ico{font-size:38px;line-height:1}
.circle-card .val{font-size:34px;font-weight:800;
  letter-spacing:-1px}
.circle-card .val small{font-size:17px;font-weight:600;
  color:var(--dim)}
.circle-card .sub{font-size:12px;color:var(--dim)}
.circle-card.pv{border:2px solid var(--pv);
  box-shadow:0 0 20px rgba(255,179,0,.35)}
.circle-card.pv .ico{filter:drop-shadow(0 0 8px var(--pv))}
.circle-card.haus{border:2px solid var(--haus);
  box-shadow:0 0 20px rgba(33,150,243,.35)}
.circle-card.haus .ico{
  filter:drop-shadow(0 0 8px var(--haus))}
.circle-card.bat{border:2px solid #12324a}
.circle-card.bat .ico{
  filter:drop-shadow(0 0 8px var(--bat))}
.circle-card.bat .arc{position:absolute;inset:-2px;
  border-radius:50%;
  background:conic-gradient(from -90deg,
    var(--bat) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1% + 4%),
    transparent 0);
  -webkit-mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px));
  mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px))}
.wirebox{position:relative;max-width:960px;margin:0 auto}
.wires{position:absolute;inset:0;width:100%;height:300px;
  pointer-events:none;z-index:-1}
.wires path{fill:none;stroke-width:3;
  stroke-linecap:round;stroke-dasharray:10 14;
  animation:dash 1.2s linear infinite}
@keyframes dash{to{stroke-dashoffset:-24}}
@media (prefers-reduced-motion:reduce){
  .wires path{animation:none}}
.w-pv{stroke:var(--pv);
  filter:drop-shadow(0 0 4px var(--pv))}
.w-bat{stroke:var(--cyan);
  filter:drop-shadow(0 0 4px var(--cyan))}
@media (max-width:820px){
  .circle-card.haus{margin-top:0}
}
.tile-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:16px;width:94%;max-width:1100px;margin:20px auto}
.tile{background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.15);padding:16px}
.tile h2{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--cyan);text-transform:uppercase;
  letter-spacing:1px}
.tile.span2{grid-column:1/-1}
.bigval{font-size:40px;font-weight:800;
  letter-spacing:-1px;line-height:1.1}
.bigval small{font-size:18px;color:var(--dim);
  font-weight:600}
.minirow{display:flex;justify-content:space-around;
  text-align:center;margin:6px 0}
.minirow .mi .ic{font-size:26px}
.minirow .mi .mv{font-size:20px;font-weight:800}
.minirow .mi .mv small{font-size:12px;color:var(--dim)}
.minirow .mi .ml{font-size:11px;color:var(--dim)}
</style>
</head>
<body>

<div class="navshade" id="navshade"></div>
<nav class="sidenav" id="sidenav">
  <div class="brand">SMART HOME</div>
    <a href="energy.html" class="active">🏠 Übersicht</a>
    <a href="energie2.html">🔆 PV-Anlage</a>
    <a href="klima.html">🔥 Heizung</a>
    <a href="auto.html">🚗 E-Autos</a>
    <a href="geraete.html">🛠️ Geräte</a>
</nav>

<div class="main">
  <div class="headbar">

  <button class="burger" id="burger">☰</button>
  <div class="hi">🚗 <ftui-label
    [text]="OpenWB:Ladeleistung_gesamt_kW"></ftui-label>
    <span class="u">kW</span></div>
  <div class="hi">🔆 <ftui-label
    [text]="di_DashWerte:PV_gesamt"></ftui-label>
    <span class="u">W</span></div>
  <div class="hi">🔋 <ftui-label
    [text]="di_DashWerte:SOC_gew"></ftui-label>
    <span class="u">%</span></div>
  <div class="spacer"></div>
  <div class="hi">🌡️ <ftui-label
    [text]="BresserWetter:temperatur_aussen"></ftui-label>
    <span class="u">°C</span></div>
  <div class="clock" id="clock"></div>

  </div>

<div class="tile-grid">

  <div class="tile">
    <h2>Aktuelles Wetter</h2>
    <div style="display:flex;align-items:center;gap:14px">
      <div id="wxicon" style="font-size:56px;line-height:1;
        filter:drop-shadow(0 0 10px rgba(0,255,255,.35))">
        ☀️</div>
      <div>
        <div class="bigval"><ftui-label [text]="BresserWetter:temperatur_aussen"></ftui-label><small> °C</small></div>
        <div style="color:var(--dim);font-size:13px">
          <ftui-label id="wxt"
            [text]="DWD:Wetter_akt"></ftui-label></div>
      </div>
    </div>
      <div class="kv"><span class="k">Gefühlt</span>
        <span class="v"><ftui-label [text]="BresserWetter:gefuehlte_temperatur"></ftui-label></span><span class="u">°C</span></div>
      <div class="kv"><span class="k">Heute Max / Min</span>
        <span class="v"><ftui-label [text]="DWD:fc0_Tx"></ftui-label></span></div>
    <div class="kv"><span class="k">Morgen</span>
      <span class="v"><span id="wxicon2"
        style="font-size:20px">☀️</span>
        <ftui-label [text]="DWD:fc1_Tx"></ftui-label> / <ftui-label [text]="DWD:fc1_Tn"></ftui-label></span>
      <span class="u">°C</span>
      <ftui-label id="wxt2" [text]="DWD:fc1_12_wwd"
        style="display:none"></ftui-label></div>
      <div class="kv"><span class="k">Regenrisiko</span>
        <span class="v"><ftui-label [text]="DWD:Regenrisiko_akt"></ftui-label></span><span class="u">%</span></div>
      <div class="kv"><span class="k">Regen heute</span>
        <span class="v"><ftui-label [text]="BresserWetter:regen_tag"></ftui-label></span><span class="u">mm</span></div>
      <div class="kv"><span class="k">Wind / Böe</span>
        <span class="v"><ftui-label [text]="BresserWetter:windgeschwindigkeit_kmh"></ftui-label></span><span class="u">km/h</span></div>
  </div>

  <div class="tile">
    <h2>Energiefluss</h2>
    <div class="minirow">
      <div class="mi"><div class="ic">🔆</div>
        <div class="mv"><ftui-label [text]="di_DashWerte:PV_gesamt"></ftui-label><small> W</small></div>
        <div class="ml">PV</div></div>
      <div class="mi"><div class="ic">🏠</div>
        <div class="mv"><ftui-label [text]="HA_SDM630M_Nergie:Summe_Leistungsbezug_Haus_gesamt"></ftui-label><small> W</small></div>
        <div class="ml">Haus</div></div>
      <div class="mi"><div class="ic">⚡</div>
        <div class="mv"><ftui-label [text]="HA_SDM630M_Nergie:Einspeiseleistung"></ftui-label><small> W</small></div>
        <div class="ml">Einspeisung</div></div>
    </div>
      <div class="kv"><span class="k">Bezug aktuell</span>
        <span class="v"><ftui-label [text]="HA_SDM630M_Nergie:Bezugsleistung"></ftui-label></span><span class="u">W</span></div>
      <div class="kv"><span class="k">Erzeugung heute</span>
        <span class="v"><ftui-label [text]="HA_SDM630M_PV_Erzeugung:Erz_PV_Energie_kWh_day"></ftui-label></span><span class="u">kWh</span></div>
      <div class="kv"><span class="k">Verbrauch heute</span>
        <span class="v"><ftui-label [text]="di_DashWerte:Verbrauch_heute"></ftui-label></span><span class="u">kWh</span></div>
      <div class="kv"><span class="k">Einspeisung heute</span>
        <span class="v"><ftui-label [text]="HA_SDM630M_Nergie:statSald_Einspeiseenergie_kWhDay"></ftui-label></span><span class="u">kWh</span></div>
      <div class="kv"><span class="k">Bezug heute</span>
        <span class="v"><ftui-label [text]="HA_SDM630M_Nergie:statSald_Bezugsenergie_kWhDay"></ftui-label></span><span class="u">kWh</span></div>
  </div>

  <div class="tile">
    <h2>Batterie</h2>
    <div class="bigval"><ftui-label id="socval"
      [text]="di_DashWerte:SOC_gew"></ftui-label><small> %</small></div>
      <div class="kv"><span class="k">Ladeleistung</span>
        <span class="v"><ftui-label [text]="di_DashWerte:Bat_Leistung"></ftui-label></span><span class="u">W</span></div>
      <div class="kv"><span class="k">Akku 5877</span>
        <span class="v"><ftui-label [text]="GoodWe_Garage_Haus_West_5877:Akku_State"></ftui-label></span></div>
      <div class="kv"><span class="k">Akku 5876</span>
        <span class="v"><ftui-label [text]="GoodWe_Haus_Ost_Mitte_5876:Akku_State"></ftui-label></span></div>
      <div class="kv"><span class="k">SOC 5877 / 5876</span>
        <span class="v"><ftui-label [text]="GoodWe_Garage_Haus_West_5877:SOC"></ftui-label>
          / <ftui-label [text]="GoodWe_Haus_Ost_Mitte_5876:SOC"></ftui-label></span><span class="u">%</span></div>
  </div>

  <div class="tile" id="flashtile">
    <h2>WR-Speicher · Flash</h2>
      <div class="kv"><span class="k">Status</span>
        <span class="v" id="flwarnv"><ftui-label id="flwarn"
          [text]="di_GoodWe_Flash:flash_warn_text"></ftui-label></span></div>
      <div class="kv"><span class="k">Batt-Flash heute 5877 / 5876</span>
        <span class="v"><ftui-label
          [text]="di_GoodWe_Flash:5877_flash_Bat_heute"></ftui-label>
          / <ftui-label
          [text]="di_GoodWe_Flash:5876_flash_Bat_heute"></ftui-label></span></div>
      <div class="kv"><span class="k">EEPROM heute 5877 / 5876</span>
        <span class="v"><ftui-label
          [text]="di_GoodWe_Flash:5877_flash_EEPROM_heute"></ftui-label>
          / <ftui-label
          [text]="di_GoodWe_Flash:5876_flash_EEPROM_heute"></ftui-label></span></div>
      <div class="kv"><span class="k">Sys-Flash heute 5877 / 5876</span>
        <span class="v"><ftui-label
          [text]="di_GoodWe_Flash:5877_flash_Sys_heute"></ftui-label>
          / <ftui-label
          [text]="di_GoodWe_Flash:5876_flash_Sys_heute"></ftui-label></span></div>
      <div class="kv"><span class="k">Ladestrom-Befehle heute 5877 / 5876</span>
        <span class="v"><ftui-label
          [text]="di_GoodWe_Flash:5877_set_i_heute"></ftui-label>
          / <ftui-label
          [text]="di_GoodWe_Flash:5876_set_i_heute"></ftui-label></span></div>
  </div>

  <div class="tile">
    <h2>E-Auto · openWB</h2>
    <div class="bigval"><ftui-label [text]="OpenWB:Ladeleistung_gesamt_kW"></ftui-label><small> kW</small></div>
      <div class="kv"><span class="k">Ladestatus</span>
        <span class="v"><ftui-label [text]="OpenWB:Ladepunkt_charge_state"></ftui-label></span></div>
      <div class="kv"><span class="k">Lademodus</span>
        <span class="v"><ftui-label [text]="OpenWB:Ladepunkt_chargemode"></ftui-label></span></div>
      <div class="kv"><span class="k">Geladen heute</span>
        <span class="v"><ftui-label [text]="OpenWB:Ladepunkt_daily_imported_kWh"></ftui-label></span><span class="u">kWh</span></div>
  </div>

  <div class="tile">
    <h2>Wärmepumpe</h2>
      <div class="kv"><span class="k">Status</span>
        <span class="v"><ftui-label [text]="LambdaWP:HP_OperatingState"></ftui-label></span></div>
      <div class="kv"><span class="k">Wärmeabgabe</span>
        <span class="v"><ftui-label [text]="LambdaWP:HP_akt_Waermeabgabeleistung"></ftui-label></span><span class="u">W</span></div>
      <div class="kv"><span class="k">El. Aufnahme</span>
        <span class="v"><ftui-label [text]="HA_SDM630M_Heatpump:Power_Sum__W1"></ftui-label></span><span class="u">W</span></div>
      <div class="kv"><span class="k">Warmwasser oben</span>
        <span class="v"><ftui-label [text]="LambdaWP:BoilerHighTemp"></ftui-label></span><span class="u">°C</span></div>
      <div class="kv"><span class="k">WP heute</span>
        <span class="v"><ftui-label [text]="HA_SDM630M_Heatpump:statEnergy_import__kWhDay1"></ftui-label></span><span class="u">kWh</span></div>
  </div>

  <div class="tile">
    <h2>Markise & Garten</h2>
      <div class="kv"><span class="k">Markise</span>
        <span class="v"><ftui-label [text]="Markise_WG:state"></ftui-label></span></div>
      <div class="kv"><span class="k">Position</span>
        <span class="v"><ftui-label [text]="Markise_WG:pct"></ftui-label></span><span class="u">%</span></div>
      <div class="kv"><span class="k">Bewässerung</span>
        <span class="v"><ftui-label [text]="DOIF_Bewaesserung:Bewaesserung_Aktiv"></ftui-label></span></div>
      <div class="kv"><span class="k">Zone</span>
        <span class="v"><ftui-label [text]="DOIF_Bewaesserung:aktuelleZoneName"></ftui-label></span></div>
      <div class="kv"><span class="k">Zisternenpumpe</span>
        <span class="v"><ftui-label [text]="myShelly_Huette_Zisterne:relay_0"></ftui-label></span></div>
  </div>

  <div class="tile span2">
    <h2>Tagesdiagramm</h2>
    <ftui-chart type="line" unit="day" height="240"
      y-min="0" y-label="W">
      <ftui-chart-data
        log="FileLog_Elektrische_Wirkleistungen_Haus_PV_WP"
        spec="4:HA_SDM630M_PV_Erzeugung.Power_Sum__W1"
        label="PV" fill point-radius="0" tension="0.3"
        border-color="#ffb300"
        background-color="rgba(255,179,0,0.25)">
      </ftui-chart-data>
      <ftui-chart-data
        log="FileLog_Elektrische_Wirkleistungen_Haus_PV_WP"
        spec="4:HA_SDM630M_Allgemein.Power_Sum__W1"
        label="Haus" fill point-radius="0" tension="0.3"
        border-color="#2196f3"
        background-color="rgba(33,150,243,0.25)">
      </ftui-chart-data>
    </ftui-chart>
  </div>

</div>

</div>

<script>

function startClock(){
  var c=document.getElementById('clock');
  function t(){var d=new Date();
    c.textContent=('0'+d.getHours()).slice(-2)+':'+
      ('0'+d.getMinutes()).slice(-2);}
  t();setInterval(t,10000);
}
function initNav(){
  var b=document.getElementById('burger');
  var n=document.getElementById('sidenav');
  var s=document.getElementById('navshade');
  function t(){n.classList.toggle('open');
    s.classList.toggle('open');}
  b.addEventListener('click', t);
  s.addEventListener('click', t);
}
window.addEventListener('load', function(){
  initNav();
  startClock();
  setTimeout(function(){
    document.dispatchEvent(
      new Event('ftuiVisibilityChanged'));
  }, 2000);
});


function mapWx(t){
  t=(t||'').toLowerCase();
  if(t.indexOf('gewitter')>=0) return '⛈️';
  if(t.indexOf('schnee')>=0||t.indexOf('graupel')>=0)
    return '🌨️';
  if(t.indexOf('regen')>=0||t.indexOf('schauer')>=0||
     t.indexOf('niesel')>=0||t.indexOf('sprüh')>=0)
    return '🌧️';
  if(t.indexOf('nebel')>=0||t.indexOf('dunst')>=0)
    return '🌫️';
  if(t.indexOf('bedeckt')>=0||t.indexOf('tr\u00fcb')>=0)
    return '☁️';
  if(t.indexOf('wolk')>=0||t.indexOf('bew\u00f6lk')>=0)
    return '⛅';
  if(t.indexOf('heiter')>=0||t.indexOf('klar')>=0||
     t.indexOf('sonnig')>=0) return '☀️';
  return '🌡️';
}
function bindWx(src,dst){
  var l=document.getElementById(src);
  var i=document.getElementById(dst);
  function u(){
    i.textContent=mapWx(l.getAttribute('text'));}
  new MutationObserver(u).observe(l,
    {attributes:true,attributeFilter:['text']});
  setInterval(u,30000); u();
}
bindWx('wxt','wxicon');
bindWx('wxt2','wxicon2');

function bindFlash(){
  var l=document.getElementById('flwarn');
  var v=document.getElementById('flwarnv');
  var t=document.getElementById('flashtile');
  function u(){
    var s=(l.getAttribute('text')||'').trim();
    var ok=(s==='ok');
    var leer=(s==='');
    v.style.color=leer?'var(--dim)':
      (ok?'var(--bat)':'#ff4040');
    t.style.boxShadow=(!leer&&!ok)?
      '0 0 18px rgba(255,64,64,.7)':'';
  }
  new MutationObserver(u).observe(l,
    {attributes:true,attributeFilter:['text']});
  setInterval(u,30000); u();
}
bindFlash();

</script>

</body>
</html>
