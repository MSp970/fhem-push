      <tr><td>Wintergarten</td><td><ftui-label [text]="Tado_EG_Wintergarten:sensorDataPoints_insideTemperature_value"></ftui-label></td><td><ftui-label [text]="Tado_EG_Wintergarten:setting_temperature"></ftui-label></td><td><ftui-label [text]="Tado_EG_Wintergarten:sensorDataPoints_humidity_percentage"></ftui-label></td></tr>
      <tr><td>Büro</td><td><ftui-label [text]="Tado_EG_Buero:sensorDataPoints_insideTemperature_value"></ftui-label></td><td><ftui-label [text]="Tado_EG_Buero:setting_temperature"></ftui-label></td><td><ftui-label [text]="Tado_EG_Buero:sensorDataPoints_humidity_percentage"></ftui-label></td></tr>
      <tr><td>Schlafzimmer</td><td><ftui-label [text]="Tado_EG_Schlafzimmer:sensorDataPoints_insideTemperature_value"></ftui-label></td><td><ftui-label [text]="Tado_EG_Schlafzimmer:setting_temperature"></ftui-label></td><td><ftui-label [text]="Tado_EG_Schlafzimmer:sensorDataPoints_humidity_percentage"></ftui-label></td></tr>
      <tr><td>Bad</td><td><ftui-label [text]="Tado_EG_Bad:sensorDataPoints_insideTemperature_value"></ftui-label></td><td><ftui-label [text]="Tado_EG_Bad:setting_temperature"></ftui-label></td><td><ftui-label [text]="Tado_EG_Bad:sensorDataPoints_humidity_percentage"></ftui-label></td></tr>
      <tr><td>Gäste-WC</td><td><ftui-label [text]="Tado_EG_GaesteWC:sensorDataPoints_insideTemperature_value"></ftui-label></td><td><ftui-label [text]="Tado_EG_GaesteWC:setting_temperature"></ftui-label></td><td><ftui-label [text]="Tado_EG_GaesteWC:sensorDataPoints_humidity_percentage"></ftui-label></td></tr>
    </table>
  </div>
  <div class="card pv">
    <h3>Beschattung<small>WG · SZ</small></h3>
    <div class="kv"><span class="k">Markise WG</span><span class="v"><ftui-label [text]="Markise_WG:lage"></ftui-label><span class="u"></span></span></div>
    <div class="kv"><span class="k">Position WG</span><span class="v"><ftui-label [text]="Markise_WG:pct"></ftui-label><span class="u">%</span></span></div>
    <div class="kv"><span class="k">Markise SZ</span><span class="v"><ftui-label [text]="myShelly_SZ_Markise:state"></ftui-label><span class="u"></span></span></div>
