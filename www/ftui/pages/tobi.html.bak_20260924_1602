    <div class="kv"><span class="k">Windrichtung</span><span class="v"><ftui-label [text]="BresserWetter:windrichtung"></ftui-label><span class="u">°</span></span></div>
    <div class="kv"><span class="k">UV-Index</span><span class="v"><ftui-label [text]="BresserWetter:uv_index"></ftui-label><span class="u"></span></span></div>
    <div class="kv"><span class="k">Sonne</span><span class="v"><ftui-label [text]="BresserWetter:sonneneinstrahlung"></ftui-label><span class="u">W/m²</span></span></div>
    <div class="kv"><span class="k">Regenrate</span><span class="v"><ftui-label [text]="BresserWetter:regenrate"></ftui-label><span class="u">mm/h</span></span></div>
    <div class="kv"><span class="k">Regen heute</span><span class="v"><ftui-label [text]="BresserWetter:regen_tag"></ftui-label><span class="u">mm</span></span></div>
  </div>
  <div class="card wp">
    <h3>Raumklima<small>Tado</small></h3>
    <table class="tb"><tr><th></th><th>°C</th><th>Soll</th><th>%</th></tr>
      <tr><td>Wohnzimmer</td><td><ftui-label [text]="Tado_EG_Wohnzimmer:sensorDataPoints_insideTemperature_value"></ftui-label></td><td><ftui-label [text]="Tado_EG_Wohnzimmer:setting_temperature"></ftui-label></td><td><ftui-label [text]="Tado_EG_Wohnzimmer:sensorDataPoints_humidity_percentage"></ftui-label></td></tr>
