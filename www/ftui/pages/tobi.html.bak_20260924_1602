      <tr><td class="c-bez">Netz</td><td><ftui-label [text]="HA_SDM630M_Wohnung_EG:0Leistung_EG_Anteil_EVU"></ftui-label></td><td><ftui-label [text]="HA_SDM630M_Wohnung_EG:0Energie_EG_EVU_kWh"></ftui-label></td><td><ftui-label [text]="HA_SDM630M_Wohnung_EG:Proz_Energie_EVU"></ftui-label></td></tr>
    </table>
    <div class="kv"><span class="k">Leistung gesamt</span><span class="v"><ftui-label [text]="HA_SDM630M_Wohnung_EG:Power_Sum__W"></ftui-label><span class="u">W</span></span></div>
