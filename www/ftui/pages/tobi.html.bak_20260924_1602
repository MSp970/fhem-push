<div class="grid4" style="margin-top:12px">
  <div class="card gr">
    <h3>Wetter<small>Oberschöllenbach</small></h3>
    <div class="kv"><span class="k">Temperatur</span><span class="v"><ftui-label [text]="BresserWetter:temperatur_aussen"></ftui-label><span class="u">°C</span></span></div>
    <div class="kv"><span class="k">Gefühlt</span><span class="v"><ftui-label [text]="BresserWetter:gefuehlte_temperatur"></ftui-label><span class="u">°C</span></span></div>
    <div class="kv"><span class="k">Luftfeuchte</span><span class="v"><ftui-label [text]="BresserWetter:feuchte_aussen"></ftui-label><span class="u">%</span></span></div>
