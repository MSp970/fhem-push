      <tr><td class="c-bez">Netz</td><td><ftui-label [text]="HA_SDM630M_Heatpump:0Leistung_HP_Anteil_EVU"></ftui-label></td><td><ftui-label [text]="HA_SDM630M_Heatpump:0Energie_HP_EVU_kWh"></ftui-label></td><td><ftui-label [text]="HA_SDM630M_Heatpump:Proz_Energie_EVU"></ftui-label></td></tr>
    </table>
    <div class="kv"><span class="k">Leistung gesamt</span><span class="v"><ftui-label [text]="HA_SDM630M_Heatpump:Power_Sum__W"></ftui-label><span class="u">W</span></span></div>
    <div class="kv"><span class="k">Energie Summe</span><span class="v"><ftui-label [text]="HA_SDM630M_Heatpump:Energie_Summe"></ftui-label><span class="u">kWh</span></span></div>
    <div class="kv"><span class="k">Energie heute</span><span class="v"><ftui-label [text]="HA_SDM630M_Heatpump:Energie_Summe_heute"></ftui-label><span class="u">kWh</span></span></div>
