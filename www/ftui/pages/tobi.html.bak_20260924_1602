<script>
function startClock(){
  var c=document.getElementById('clock');
  function t(){var d=new Date();
    c.textContent=('0'+d.getHours()).slice(-2)+':'+
      ('0'+d.getMinutes()).slice(-2);}
  t();setInterval(t,10000);
}
function initNav(){
  var b=document.getElementById('burger');
  var n=document.getElementById('sidenav');
  var s=document.getElementById('navshade');
  function t(){n.classList.toggle('open');s.classList.toggle('open');}
  b.addEventListener('click',t);s.addEventListener('click',t);
}
window.addEventListener('load',function(){
  initNav();startClock();
  setTimeout(function(){
    document.dispatchEvent(new Event('ftuiVisibilityChanged'));
  },2000);
});
</script>
