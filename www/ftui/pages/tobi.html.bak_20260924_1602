<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes"/>
<title>Tobi</title>
<script src="../ftui.js"></script>
<link href="../ftui.css" rel="stylesheet"/>
<link href="../themes/ftui-theme.css" rel="stylesheet"/>
<style>
:root{
  --bg:#070b14; --card:rgba(22,29,46,.72); --card2:rgba(30,38,58,.6);
  --line:rgba(120,150,200,.14); --txt:#e6ebf2; --dim:#7f8fa6;
  --pv:#ffb300; --grid:#00e5ff; --bez:#ff5d73; --bat:#4ade80;
  --wp:#b388ff; --deye:#ff8a3d;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;color:var(--txt);
  font-family:"Segoe UI",system-ui,sans-serif;
  -webkit-font-smoothing:antialiased}
body{min-height:100vh;background:
  radial-gradient(1200px 600px at 10% -10%,rgba(255,179,0,.10),transparent 60%),
  radial-gradient(900px 500px at 100% 0%,rgba(0,229,255,.08),transparent 60%),
  var(--bg);background-attachment:fixed}
.sidenav{width:230px;background:#0a0e18;border-right:1px solid var(--line);
  padding:18px 0;position:fixed;top:0;left:0;height:100vh;z-index:20;
  transform:translateX(-100%);transition:transform .25s ease;
  box-shadow:0 0 30px rgba(0,0,0,.6)}
.sidenav.open{transform:translateX(0)}
.navshade{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:19;
  display:none}
.navshade.open{display:block}
.brand{padding:0 22px 16px;font-weight:800;letter-spacing:2px;
  color:var(--grid);font-size:17px}
.sidenav a{display:block;padding:11px 22px;color:var(--txt);
  text-decoration:none;font-size:20px}
.sidenav a:hover,.sidenav a.active{background:rgba(0,229,255,.08);
  color:var(--grid)}
.main{padding:10px 16px 14px;max-width:1500px;margin:0 auto}
.headbar{display:flex;align-items:center;gap:18px;height:44px;
  margin-bottom:10px}
.burger{background:none;border:0;color:var(--txt);font-size:29px;
  cursor:pointer;padding:0 6px}
.hi{display:flex;align-items:baseline;gap:5px;font-size:20px;
  font-weight:700;white-space:nowrap}
.hi .u{color:var(--dim);font-size:16px;font-weight:600}
.hi ftui-label{display:inline-flex}
.spacer{flex:1}
.clock{font-size:29px;font-weight:800;color:var(--grid);
  letter-spacing:1px}
.grid4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12px}
.grid2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.7fr);
  gap:12px;margin-top:12px}
.card{position:relative;background:linear-gradient(160deg,var(--card),var(--card2));
  border:1px solid var(--line);border-radius:14px;padding:12px 14px 10px;
  backdrop-filter:blur(8px);overflow:hidden;
  box-shadow:0 8px 24px rgba(0,0,0,.35)}
.card::before{content:"";position:absolute;left:0;top:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--acc,var(--grid)),transparent)}
.card h3{margin:0 0 8px;font-size:17px;font-weight:700;
  letter-spacing:.6px;text-transform:uppercase;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;color:var(--acc,var(--grid))}
.card h3 small{color:var(--dim);font-weight:600;text-transform:none;
  letter-spacing:0;font-size:16px;margin-left:6px}
.hero{display:flex;align-items:baseline;gap:8px;margin:2px 0 8px}
.hero .n{font-size:39px;font-weight:800;letter-spacing:-.5px}
.hero .u{color:var(--dim);font-size:18px;font-weight:600}
.hero ftui-label,.kv ftui-label,.st ftui-label{display:inline-flex}
.kv{display:flex;align-items:baseline;justify-content:space-between;
  font-size:17px;padding:3px 0;border-top:1px solid rgba(255,255,255,.04)}
.kv .k{color:var(--dim)}
.kv .v{font-weight:700;display:flex;align-items:baseline;gap:5px}
.kv .v .u{color:var(--dim);font-weight:600;font-size:14px;min-width:24px}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.stats.s6{grid-template-columns:repeat(6,minmax(0,1fr))}
.st{background:rgba(255,255,255,.03);border:1px solid var(--line);
  border-radius:10px;padding:7px 9px}
.st .l{font-size:14px;color:var(--dim);white-space:nowrap;overflow:hidden;
  text-overflow:ellipsis}
.st .v{font-size:25px;font-weight:800;display:flex;align-items:baseline;
  gap:5px;margin-top:2px}
.st .v small{font-size:14px;color:var(--dim);font-weight:600}
.stats.s6 .st .v{font-size:20px}
.stats.s6 .st{padding:7px 7px}
.sub{font-size:14px;color:var(--dim);margin:8px 0 5px;letter-spacing:.5px;
  text-transform:uppercase}
.pv{--acc:var(--pv)} .bat{--acc:var(--bat)} .dy{--acc:var(--deye)}
.gr{--acc:var(--grid)}
.c-pv{color:var(--pv)} .c-gr{color:var(--grid)} .c-bez{color:var(--bez)}
.chart{margin-top:12px}
.chart ftui-chart{display:block;width:100%}
@media (max-width:1100px){
  .grid4{grid-template-columns:repeat(2,minmax(0,1fr))}
  .grid2{grid-template-columns:1fr}
  .stats.s6{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media (max-width:600px){
  .grid4{grid-template-columns:1fr}
  .hi:nth-of-type(n+4){display:none}
}
.tb{width:100%;border-collapse:collapse;font-size:17px;margin-bottom:6px}
.tb th{color:var(--dim);font-weight:600;font-size:14px;text-align:right;padding:2px 4px}
.tb td{padding:4px 4px;text-align:right;font-weight:700;border-top:1px solid rgba(255,255,255,.04)}
.tb td:first-child{text-align:left;font-weight:600;color:var(--dim)}
.tb td.c-pv{color:var(--pv)} .tb td.c-bat{color:var(--bat)} .tb td.c-bez{color:var(--bez)}
.tb ftui-label{display:inline-flex}
.c-bat{color:var(--bat)} .wp{--acc:var(--wp)}
</style>
</head>
