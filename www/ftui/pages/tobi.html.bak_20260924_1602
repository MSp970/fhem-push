      <tr><td class="c-bez">Netz</td><td><ftui-label [text]="HA_SDM630M_Allgemein:0Leistung_Allg_Anteil_EVU"></ftui-label></td><td><ftui-label [text]="HA_SDM630M_Allgemein:0Energie_Allg_EVU_kWh"></ftui-label></td><td><ftui-label [text]="HA_SDM630M_Allgemein:Proz_Energie_EVU"></ftui-label></td></tr>
    </table>
    <div class="kv"><span class="k">Leistung gesamt</span><span class="v"><ftui-label [text]="HA_SDM630M_Allgemein:Power_Sum__W"></ftui-label><span class="u">W</span></span></div>
    <div class="kv"><span class="k">Energie Summe</span><span class="v"><ftui-label [text]="HA_SDM630M_Allgemein:Energie_Summe"></ftui-label><span class="u">kWh</span></span></div>
