<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes"/>
<title>E-Auto</title>
<script src="../ftui.js"></script>
<link href="../ftui.css" rel="stylesheet"/>
<link href="../themes/ftui-theme.css" rel="stylesheet"/>
<style>
:root{
  --bg:#0b0f1a; --card:#121826; --card2:#1a1f2e;
  --line:#1d2638; --txt:#e0e0e0; --dim:#8496ab;
  --cyan:#00ffff; --pv:#ffb300; --haus:#2196f3;
  --bat:#4caf50; --warm:#ff7043;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--bg);
  color:var(--txt);font-family:"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased}
body{min-height:100vh}
.sidenav{width:230px;background:#0a0e18;
  border-right:1px solid var(--line);padding:18px 0;
  position:fixed;top:0;left:0;height:100vh;z-index:20;
  transform:translateX(-100%);
  transition:transform .25s ease;
  box-shadow:0 0 30px rgba(0,0,0,.6)}
.sidenav.open{transform:translateX(0)}
.navshade{position:fixed;inset:0;background:rgba(0,0,0,.5);
  z-index:15;display:none}
.navshade.open{display:block}
.burger{background:none;border:none;color:var(--txt);
  font-size:22px;cursor:pointer;padding:4px 8px;
  line-height:1}
.sidenav .brand{color:var(--cyan);font-weight:800;
  font-size:17px;letter-spacing:1px;padding:0 20px 16px;
  border-bottom:1px solid var(--line);margin-bottom:10px}
.sidenav a{display:flex;align-items:center;gap:10px;
  padding:12px 20px;color:var(--dim);font-weight:600;
  font-size:15px;text-decoration:none;
  border-left:3px solid transparent}
.sidenav a.active{color:var(--txt);background:#0e1524;
  border-left-color:var(--cyan)}
.sidenav a:hover{color:var(--txt)}
.main{flex:1;min-width:0;padding-bottom:30px}
.headbar{display:flex;align-items:center;gap:18px;
  flex-wrap:wrap;padding:10px 20px;background:#0a0e18;
  border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:5}
.headbar .hi{display:flex;align-items:center;gap:6px;
  font-weight:700;font-size:14px}
.headbar .hi .u{color:var(--dim);font-weight:600;
  font-size:12px}
.headbar .spacer{flex:1}
.headbar .clock{font-size:18px;font-weight:800;
  color:var(--cyan)}
.wide-card{margin:24px auto;width:92%;max-width:1000px;
  background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.2);padding:20px}
.wide-card h2{margin:0 0 12px;font-size:16px;
  font-weight:700;color:var(--cyan)}
.wr-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:16px}
.wr{background:var(--card2);border-radius:10px;
  padding:14px 16px;
  box-shadow:0 0 10px rgba(255,255,255,.08)}
.wr h3{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--pv);text-transform:uppercase;
  letter-spacing:1px}
.wr.gruen h3{color:var(--bat)}
.wr.blau h3{color:var(--haus)}
.wr.warm h3{color:var(--warm)}
.kv{display:flex;align-items:baseline;gap:8px;
  padding:5px 0;border-bottom:1px solid #131c2a;
  font-size:14px}
.kv:last-child{border-bottom:none}
.kv .k{flex:1;color:var(--dim)}
.kv .v{font-weight:700;font-size:16px}
.kv .u{color:var(--dim);font-size:12px}
.stats-row{display:flex;justify-content:space-around;
  flex-wrap:wrap;gap:12px;margin-top:8px}
.stat{background:var(--card2);border-radius:8px;
  padding:10px 20px;min-width:150px;flex:1;
  box-shadow:0 0 10px rgba(255,255,255,.1);
  text-align:center}
.stat .sl{color:var(--dim);font-size:13px}
.stat .sv{font-size:20px;font-weight:800}
.stat .sv small{font-size:12px;font-weight:600;
  color:var(--dim)}
.circle-row{display:flex;justify-content:space-around;
  align-items:flex-start;flex-wrap:wrap;gap:20px;
  margin-top:26px;padding:0 12px}
.circle-card{position:relative;width:200px;height:200px;
  border-radius:50%;padding:20px;text-align:center;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:2px;
  background:radial-gradient(circle at center,
    var(--card2) 0%,var(--bg) 100%);
  box-shadow:0 0 20px rgba(0,255,255,.3)}
.circle-card.haus{margin-top:60px}
.circle-card h3{margin:0 0 4px;font-size:14px;
  font-weight:700;color:var(--cyan);
  text-transform:uppercase;letter-spacing:1px}
.circle-card .ico{font-size:38px;line-height:1}
.circle-card .val{font-size:34px;font-weight:800;
  letter-spacing:-1px}
.circle-card .val small{font-size:17px;font-weight:600;
  color:var(--dim)}
.circle-card .sub{font-size:12px;color:var(--dim)}
.circle-card.pv{border:2px solid var(--pv);
  box-shadow:0 0 20px rgba(255,179,0,.35)}
.circle-card.pv .ico{filter:drop-shadow(0 0 8px var(--pv))}
.circle-card.haus{border:2px solid var(--haus);
  box-shadow:0 0 20px rgba(33,150,243,.35)}
.circle-card.haus .ico{
  filter:drop-shadow(0 0 8px var(--haus))}
.circle-card.bat{border:2px solid #12324a}
.circle-card.bat .ico{
  filter:drop-shadow(0 0 8px var(--bat))}
.circle-card.bat .arc{position:absolute;inset:-2px;
  border-radius:50%;
  background:conic-gradient(from -90deg,
    var(--bat) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1%),
    var(--cyan) calc(var(--soc,0)*1% + 4%),
    transparent 0);
  -webkit-mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px));
  mask:radial-gradient(farthest-side,
    transparent calc(100% - 7px),
    #000 calc(100% - 6px))}
.wirebox{position:relative;max-width:960px;margin:0 auto}
.wires{position:absolute;inset:0;width:100%;height:300px;
  pointer-events:none;z-index:-1}
.wires path{fill:none;stroke-width:3;
  stroke-linecap:round;stroke-dasharray:10 14;
  animation:dash 1.2s linear infinite}
@keyframes dash{to{stroke-dashoffset:-24}}
@media (prefers-reduced-motion:reduce){
  .wires path{animation:none}}
.w-pv{stroke:var(--pv);
  filter:drop-shadow(0 0 4px var(--pv))}
.w-bat{stroke:var(--cyan);
  filter:drop-shadow(0 0 4px var(--cyan))}
@media (max-width:820px){
  .circle-card.haus{margin-top:0}
}
.tile-grid{display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:16px;width:94%;max-width:1100px;margin:20px auto}
.tile{background:var(--card);border-radius:12px;
  box-shadow:0 0 15px rgba(0,255,255,.15);padding:16px}
.tile h2{margin:0 0 10px;font-size:14px;font-weight:700;
  color:var(--cyan);text-transform:uppercase;
  letter-spacing:1px}
.tile.span2{grid-column:1/-1}
.bigval{font-size:40px;font-weight:800;
  letter-spacing:-1px;line-height:1.1}
.bigval{display:flex;justify-content:center;align-items:baseline;column-gap:9px}
.bigval ftui-label{display:inline-flex}
.bigval small{font-size:18px;color:var(--dim);
  font-weight:600}
.minirow{display:flex;justify-content:space-around;
  text-align:center;margin:6px 0}
.minirow .mi .ic{font-size:26px}
.minirow .mi .mv{font-size:20px;font-weight:800}
.minirow .mi .mv small{font-size:12px;color:var(--dim)}
.minirow .mi .ml{font-size:11px;color:var(--dim)}
.kv .v{white-space:nowrap}
.kv .v ftui-label{display:inline}
.wrled-row{display:flex;justify-content:space-around;flex-wrap:wrap;gap:12px}
.wrled{flex:1;min-width:180px;max-width:260px}
.wrsvg{width:100%;height:auto;display:block}
.wrsvg .fin{fill:#222a3b;stroke:#303b52}
.wrsvg .panel{fill:#0b0f1a;stroke:#27324a}
.wrsvg .wrt{fill:#00ffff;font-weight:800;font-size:15px;letter-spacing:1px}
.wrsvg .wrs{fill:#8496ab;font-size:9px;letter-spacing:.5px}
.wrsvg .wri{fill:#e0e0e0;font-size:10px;font-weight:600}
.wrsvg .ledt{fill:#8496ab;font-size:10px;font-weight:700;letter-spacing:1px}
.wrsvg .led{fill:#262e3f;stroke:#39455f;stroke-width:1}
.wrsvg .led.on,.wrsvg .led.b1,.wrsvg .led.b2{fill:var(--lc,#4caf50);filter:drop-shadow(0 0 5px var(--lc,#4caf50))}
.wrsvg .led.b1{animation:ledbl 1.6s steps(1) infinite}
.wrsvg .led.b2{animation:ledbl .5s steps(1) infinite}
@keyframes ledbl{50%{fill:#262e3f;filter:none}}
@media (prefers-reduced-motion:reduce){.wrsvg .led.b1,.wrsvg .led.b2{animation:none;opacity:.6}}
.wrled-leg{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-top:8px;font-size:11px;color:var(--dim)}
.wrled-leg span{display:flex;align-items:center;gap:5px}
.wrled-leg .lg{display:inline-block;width:9px;height:9px;border-radius:50%;background:#262e3f;border:1px solid #39455f}
.wrled-leg .lg.on,.wrled-leg .lg.b1,.wrled-leg .lg.b2{background:#4caf50;box-shadow:0 0 5px #4caf50}
.wrled-leg .lg.b1{animation:lgbl 1.6s steps(1) infinite}
.wrled-leg .lg.b2{animation:lgbl .5s steps(1) infinite}
@keyframes lgbl{50%{background:#262e3f;box-shadow:none}}
</style>
</head>
<body>

<div class="navshade" id="navshade"></div>
<nav class="sidenav" id="sidenav">
  <div class="brand">SMART HOME</div>
    <a href="uebersicht.html">⚡ Übersicht</a>
    <a href="pv.html">🔆 PV-Anlage</a>
    <a href="heizung.html">♨️ Heizung live</a>
    <a href="klima.html">🔥 Heizung</a>
    <a href="ertrag.html">&#128182; Ertrag</a>
    <a href="eauto.html" class="active">🚗 E-Autos</a>
  <a href="tobi.html">👤 Tobi</a>
    <a href="geraete.html">🛠️ Geräte</a>
    <a href="monitor.html">🛡️ Monitoring</a>
    <a href="steuerung.html">🎛️ Steuerung</a>
    <a href="/fhem" style="border-top:1px solid rgba(255,255,255,.1)">⚙️ FHEM</a>
</nav>

<div class="main">
  <div class="headbar">

  <button class="burger" id="burger">☰</button>
  <div class="hi">🚗 <ftui-label
    [text]="OpenWB_Garage_links:Ladeleistung_gesamt_kW"></ftui-label>
    / <ftui-label
    [text]="OpenWB_Garage_rechts:Ladeleistung_gesamt_kW"></ftui-label>
    <span class="u">kW</span></div>
  <div class="hi">🔆 <ftui-label
    [text]="di_DashWerte:PV_gesamt"></ftui-label>
    <span class="u">W</span></div>
  <div class="hi">🔋 <ftui-label
    [text]="di_DashWerte:SOC_gew"></ftui-label>
    <span class="u">%</span></div>
  <div class="spacer"></div>
  <div class="hi">🌡️ <ftui-label
    [text]="BresserWetter:temperatur_aussen"></ftui-label>
    <span class="u">°C</span></div>
  <div class="clock" id="clock"></div>

  </div>

<style>
.ea-wrap{width:94%;max-width:1400px;margin:14px auto 24px}
.ea-top{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.ea-tab{background:#161e2e;border:1px solid #1f2a3e;color:#9fb0c5;font-size:13px;padding:6px 14px;border-radius:99px;cursor:pointer;font-family:inherit}
.ea-tab.on{color:#0b0f1a;background:#a78bfa;border-color:#a78bfa;font-weight:700}
.ea-upd{margin-left:auto;font-size:11px;color:#6b7c93}
.ea-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,600px),1fr));gap:16px}
.ea-card{background:linear-gradient(160deg,#141b2b,#0f1522);border:1px solid #1d2638;border-radius:20px;padding:16px 18px}
.ea-hd{display:flex;align-items:center;gap:14px;margin-bottom:10px}
.ea-hd img{width:150px;height:auto;filter:drop-shadow(0 6px 12px rgba(0,0,0,.6))}
.ea-hd .t{flex:1;min-width:0}.ea-hd .t b{display:block;font-size:18px}.ea-hd .t span{font-size:12px;color:#8496ab}
.ea-chip{font-size:12px;font-weight:700;padding:5px 12px;border-radius:99px;white-space:nowrap}
.ea-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:center;margin:6px 0 12px}
@media(max-width:560px){.ea-row{grid-template-columns:1fr}.ea-hd img{width:110px}}
.ea-ring{position:relative;max-width:220px;margin:0 auto}.ea-ring svg{width:100%;height:auto;display:block}
.ea-ring .c{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.ea-ring .c b{font-size:30px;font-weight:800;font-variant-numeric:tabular-nums}.ea-ring .c span{font-size:12px;color:#8496ab}
.ea-leg div{display:flex;align-items:center;gap:8px;font-size:13px;padding:4px 0}.ea-leg i{width:10px;height:10px;border-radius:3px}
.ea-leg .v{margin-left:auto;font-weight:700;font-variant-numeric:tabular-nums}
.ea-sec{font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#a78bfa;margin:14px 0 6px}
.ea-seg{display:flex;flex-wrap:wrap;gap:6px}
.ea-seg button{flex:1;min-width:70px;background:#161e2e;border:1px solid #273145;color:#cbd5e1;font-size:13px;padding:9px 8px;border-radius:12px;cursor:pointer;font-family:inherit}
.ea-seg button.on{background:#5b21b6;border-color:#a78bfa;color:#fff;font-weight:700}
.ea-seg button:disabled{opacity:.5}
.ea-sl{display:flex;align-items:center;gap:12px}
.ea-sl input{flex:1;accent-color:#a78bfa;height:28px}
.ea-sl b{min-width:58px;text-align:right;font-size:18px;font-variant-numeric:tabular-nums}
.ea-kv div{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:13px}
.ea-kv .k{color:#8496ab}.ea-kv .v{font-weight:600;text-align:right}
.ea-hint{font-size:11px;color:#6b7c93;margin-top:4px}
.ea-msg{font-size:12px;color:#8496ab;margin-top:10px;min-height:16px}
.ea-empty{color:#6b7c93;font-size:12.5px;padding:8px 2px}
.ea-embed .headbar,.ea-embed .sidenav,.ea-embed .navshade{display:none!important}.ea-embed .ea-wrap{width:100%;margin:0}
</style>
<div class="ea-wrap">
  <div class="ea-top" id="ea_tabs"></div>
  <div class="ea-grid" id="ea_grid"></div>
  <div class="ea-msg" id="ea_msg"></div>
</div>
<script>
(function(){
var IMG={SQ6:'data:image/webp;base64,',MG4:'data:image/webp;base64,'};
var SITES=[
 {id:'g',name:'Große Anlage',base:'http://192.168.176.205:8084',boxes:[
  {n:'Wallbox links',car:'SQ6',dev:'OpenWB_Garage_links',ctl:'openWB_Garage_links_Control',cmd:'openWB_Garage_links_PV_cmd',doif:'di_openWB_auto_links',mix:null},
  {n:'Wallbox rechts',car:'MG4',dev:'OpenWB_Garage_rechts',ctl:'openWB_Garage_rechts_Control',cmd:'openWB_Garage_rechts_PV_cmd',doif:'di_openWB_auto_rechts',mix:'OpenWB_OG'}]},
 {id:'k',name:'S9',base:'http://192.168.178.21:8084',boxes:[
  {n:'Wallbox',car:'SQ6',dev:'OpenWB',ctl:'openWB_Control',cmd:'openWB_PV_cmd',doif:'di_openWB_auto',mix:null}]}
];
var MODES=[['instant','Sofort'],['pv','PV'],['eco','Eco'],['target','Zielladen'],['stop','Stop']];
var cur=(location.search.match(/[?&]anlage=(g|k)/)||[])[1]||((/^192\.168\.178\./.test(location.hostname))?'k':'g'),M={},BUSY=0;
function site(){return SITES.filter(function(x){return x.id==cur;})[0];}
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function req(s,cmd){
  var go=function(){return fetch(s.base+'/fhem?cmd='+encodeURIComponent(cmd)+'&XHR=1&fwcsrf='+encodeURIComponent(s.tok||''),{cache:'no-store'}).then(function(r){if(!r.ok)throw r.status;return r.text();});};
  var tk=function(){return fetch(s.base+'/fhem?XHR=1',{cache:'no-store'}).then(function(r){s.tok=r.headers.get('X-FHEM-csrfToken')||'';});};
  return (s.tok===undefined?tk().then(go):go()).catch(function(){return tk().then(go);});}
function V(d,r){try{return M[d][r].Value;}catch(e){return null;}}
function N(d,r){var v=V(d,r);if(v==null)return NaN;return parseFloat(String(v).replace(',','.'));}
function nf(v,d){return isNaN(v)?'–':v.toLocaleString('de-DE',{minimumFractionDigits:d,maximumFractionDigits:d});}
function tabs(){document.getElementById('ea_tabs').innerHTML=SITES.map(function(s){return '<button class="ea-tab'+(s.id==cur?' on':'')+'" data-s="'+s.id+'">'+s.name+'</button>';}).join('')+'<span class="ea-upd" id="ea_upd"></span>';}
function live(){if(BUSY)return;var s=site(),d=[];s.boxes.forEach(function(b){d.push(b.dev,b.ctl,b.cmd,b.doif);});d.push('Monitor');
  return req(s,'jsonlist2 '+d.join(',')).then(function(t){var j=JSON.parse(t);M={};j.Results.forEach(function(x){M[x.Name]=x.Readings||{};M[x.Name].__state={Value:x.Internals&&x.Internals.STATE};});render(s);})
   .catch(function(e){document.getElementById('ea_grid').innerHTML='<div class="ea-empty" style="color:#f87171">'+esc(s.name)+' nicht erreichbar: '+esc(e)+'</div>';});}
function arc(cx,cy,r,a0,a1){var x0=cx+r*Math.cos(a0),y0=cy+r*Math.sin(a0),x1=cx+r*Math.cos(a1),y1=cy+r*Math.sin(a1);return 'M'+x0.toFixed(2)+' '+y0.toFixed(2)+' A'+r+' '+r+' 0 '+((a1-a0)>Math.PI?1:0)+' 1 '+x1.toFixed(2)+' '+y1.toFixed(2);}
function ring(parts,center){var s='<svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="80" fill="none" stroke="#1b2437" stroke-width="18"/>',a=-Math.PI/2,tot=parts.reduce(function(x,p){return x+p[0];},0);
  if(tot>0)parts.forEach(function(p){if(p[0]<=0)return;var b=a+Math.min(p[0]/Math.max(tot,p[2]||tot),0.9999)*2*Math.PI;s+='<path d="'+arc(100,100,80,a,b)+'" fill="none" stroke="'+p[1]+'" stroke-width="18" stroke-linecap="round"/>';a=b;});
  return '<div class="ea-ring">'+s+'</svg><div class="c">'+center+'</div></div>';}
function box(b,i){var pk=N(b.dev,'Ladeleistung_gesamt_kW');if(isNaN(pk)){var cp=N(b.ctl,'power');pk=isNaN(cp)?N(b.doif,'ev_power')/1000:cp;}
  var plug=V(b.doif,'plugged')=='1',chg=String(V(b.ctl,'charging')||''),am=String(V(b.doif,'active_mode')||''),lade=pk>0.05||/charg/i.test(chg)&&!/idle/.test(chg);
  var st=lade?['lädt','#34d399','#064e3b']:(plug?['eingesteckt','#a78bfa','#2e1065']:['nicht verbunden','#94a3b8','#1e293b']);
  var ph=0;['L1','L2','L3'].forEach(function(l){if(N(b.dev,'Ladeleistung_'+l+'_kW')>0.1)ph++;});if(!ph)ph=parseInt(V(b.doif,'phase_mode'),10)||NaN;
  var maxkw=11,cc=N(b.ctl,'chargecurrent'),mx=N(b.ctl,'maxCurrent')||32,tA=N(b.doif,'targetA'),cm=String(V(b.ctl,'chargemode')||''),pc=String(V(b.cmd,'state')||V(b.cmd,'__state')||'');
  var pvm=/^sofort/.test(pc)?'sofort':(/^pv/.test(pc)?'pv':''),phm=(pc.match(/(Auto|Max|1)$/)||[])[1]||'';
  var h='<div class="ea-card"><div class="ea-hd"><img src="'+IMG[b.car]+'" alt="'+b.car+'"><div class="t"><b>'+esc(b.n)+' · '+b.car+'</b><span>'+esc(am.replace(/_/g,' ')||'–')+(V(b.doif,'plug_t_hr')?' · Stecker '+esc(String(V(b.doif,'plug_t_hr')).substr(5,11)):'')+'</span></div><span class="ea-chip" style="color:'+st[1]+';background:'+st[2]+'">'+st[0]+'</span></div>';
  var mixh='';
  if(b.mix){var e=[['PV',N(b.dev,'0Energie_'+b.mix+'_PV_kWh'),'#facc15'],['Netz',N(b.dev,'0Energie_'+b.mix+'_EVU_kWh'),'#f43f5e'],['Akku',N(b.dev,'0Energie_'+b.mix+'_Batterie_kWh'),'#38bdf8']],et=e.reduce(function(x,p){return x+(isNaN(p[1])?0:p[1]);},0);
    if(et>0)mixh='<div class="ea-leg"><div style="color:#8496ab;font-size:11px;letter-spacing:1px;text-transform:uppercase">Geladene Energie gesamt</div>'+e.map(function(p){return '<div><i style="background:'+p[2]+'"></i>'+p[0]+'<span class="v">'+nf(p[1],1)+' kWh · '+nf(p[1]/et*100,0)+' %</span></div>';}).join('')+'<div><i style="background:transparent"></i><b>Summe</b><span class="v">'+nf(et,1)+' kWh</span></div></div>';}
  var kv='<div class="ea-kv">'+[['Ziel-Strom (FHEM)',isNaN(tA)?'–':nf(tA,0)+' A'],['Phasen',isNaN(ph)?'–':ph],['PV / Netz',nf(N(b.doif,'pv'),0)+' W / '+nf(N(b.doif,'grid'),0)+' W'],['Einspeise-Ziel',nf(N(b.doif,'feed_ziel_eff')||N(b.doif,'feed_ziel'),0)+' W'],['Auto voll',V(b.doif,'car_full')=='1'?'ja':'nein']].map(function(x){return '<div><span class="k">'+x[0]+'</span><span class="v">'+x[1]+'</span></div>';}).join('')+'</div>';
  h+='<div class="ea-row">'+ring([[Math.max(0,pk),lade?'#34d399':'#475569',maxkw]],'<b>'+nf(Math.max(0,pk),1)+'</b><span>kW · '+(isNaN(ph)?'–':ph)+'-phasig</span>')+(mixh||kv)+'</div>';
  if(mixh)h+=kv;
  h+='<div class="ea-sec">Automatik (FHEM-Regelung)</div><div class="ea-seg">'+[['pv','PV-Überschuss'],['sofort','Sofort']].map(function(x){return '<button data-b="'+i+'" data-pv="'+x[0]+'"'+(pvm==x[0]?' class="on"':'')+'>'+x[1]+'</button>';}).join('')+'</div>';
  h+='<div class="ea-seg" style="margin-top:6px">'+[['Auto','Phasen automatisch'],['Max','3-phasig (max)'],['1','1-phasig']].map(function(x){return '<button data-b="'+i+'" data-ph="'+x[0]+'"'+(phm==x[0]?' class="on"':'')+'>'+x[1]+'</button>';}).join('')+'</div>';
  h+='<div class="ea-hint">aktuell: '+esc(pc||'–')+' ('+esc(b.cmd)+')</div>';
  h+='<div class="ea-sec">Lademodus openWB</div><div class="ea-seg">'+MODES.map(function(m){return '<button data-b="'+i+'" data-cm="'+m[0]+'"'+(cm==m[0]?' class="on"':'')+'>'+m[1]+'</button>';}).join('')+'</div>';
  h+='<div class="ea-sec">Ladestrom</div><div class="ea-sl"><span style="color:#8496ab;font-size:12px">6 A</span><input type="range" min="6" max="'+mx+'" step="1" value="'+(isNaN(cc)?6:cc)+'" data-b="'+i+'" data-cc="1"><span style="color:#8496ab;font-size:12px">'+mx+' A</span><b id="ea_cc'+i+'">'+(isNaN(cc)?'–':cc+' A')+'</b></div><div class="ea-hint">≈ '+nf((isNaN(cc)?6:cc)*230*3/1000,1)+' kW 3-phasig / '+nf((isNaN(cc)?6:cc)*230/1000,1)+' kW 1-phasig · wird beim Loslassen gesetzt</div>';
  return h+'</div>';}
function render(s){document.getElementById('ea_grid').innerHTML=s.boxes.map(box).join('');
  var u=document.getElementById('ea_upd');if(u){var d=new Date();u.textContent='aktualisiert '+('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'+('0'+d.getSeconds()).slice(-2);}}
function msg(t){var m=document.getElementById('ea_msg');if(m)m.textContent=t;}
function run(cmd){var s=site();msg('sende: '+cmd.replace(/^set /,''));BUSY=1;
  return req(s,cmd).then(function(r){msg((r&&r.trim()?'Antwort: '+r.trim():'ausgeführt: '+cmd.replace(/^set /,''))+' · '+new Date().toLocaleTimeString('de-DE'));}).catch(function(e){msg('Fehler: '+e);}).then(function(){BUSY=0;setTimeout(live,1000);});}
document.addEventListener('click',function(ev){var t=ev.target.closest?ev.target.closest('.ea-tab,.ea-seg button'):null;if(!t)return;var s=site();
  if(t.dataset.s){cur=t.dataset.s;M={};tabs();live();return;}var b=s.boxes[+t.dataset.b];if(!b)return;
  var pc=String(V(b.cmd,'state')||''),pvm=/^sofort/.test(pc)?'sofort':'pv',phm=(pc.match(/(Auto|Max|1)$/)||[])[1]||'Auto';
  if(t.dataset.pv){run('set '+b.cmd+' '+t.dataset.pv+phm);return;}
  if(t.dataset.ph){run('set '+b.cmd+' '+pvm+t.dataset.ph);return;}
  if(t.dataset.cm){if(t.dataset.cm=='stop'&&!confirm(b.n+': Laden stoppen?'))return;run('set '+b.ctl+' chargemode '+t.dataset.cm);return;}});
document.addEventListener('input',function(ev){var t=ev.target;if(!t.dataset||!t.dataset.cc)return;BUSY=1;var e=document.getElementById('ea_cc'+t.dataset.b);if(e)e.textContent=t.value+' A';});
document.addEventListener('change',function(ev){var t=ev.target;if(!t.dataset||!t.dataset.cc)return;var b=site().boxes[+t.dataset.b];BUSY=0;run('set '+b.ctl+' chargecurrent '+t.value);});
function initNav(){var b=document.getElementById('burger'),n=document.getElementById('sidenav'),s=document.getElementById('navshade');if(!b||!n||!s)return;function t(){n.classList.toggle('open');s.classList.toggle('open');}b.addEventListener('click',t);s.addEventListener('click',t);}
function startClock(){var c=document.getElementById('clock');if(!c)return;function t(){var d=new Date();c.textContent=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);}t();setInterval(t,10000);}
function start(){if(/[?&]embed=1/.test(location.search))document.body.classList.add('ea-embed');else{initNav();startClock();}
  tabs();live();setInterval(function(){if(!document.hidden)live();},5000);}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>
<script src="ue-arrange.js?v=12"></script>
</div>
</body>
</html>
