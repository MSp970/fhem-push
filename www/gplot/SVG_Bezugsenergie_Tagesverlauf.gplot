# Created by FHEM/98_SVG.pm, 2026-08-06 08:15:47
set terminal png transparent size <SIZE> crop
set output '<OUT>.png'
set xdata time
set timefmt "%Y-%m-%d_%H:%M:%S"
set xlabel " "
set title 'Bezugsenergie 100 Wmin entspr. 0,0016kWh, 0,1 kWh entspr. 6.000 Wmin'
set ytics 
set y2tics 
set grid
set ylabel "Bezugsenergie Wmin"
set y2label "Bezugsenergie Wmin"

#Bezugsenergie_Tagesverlauf 4:HA_SDM630M_Nergie.statSald_Bezugsenergie_WminDay\x3a::
#Bezugsenergie_Tagesverlauf 4:Bezugsenergie_Wmin_pro_h.*::

plot "<IN>" using 1:2 axes x1y1 title 'Bezugsenergie Wmin' ls l0 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'Bezug pro h' ls l2 lw 1 with needles
