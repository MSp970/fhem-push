set terminal png transparent size <SIZE> crop
set output '<OUT>.png'
set xdata time
set timefmt "%Y-%m-%d_%H:%M:%S"
set xlabel " "
set title 'WR Leistungen'
set ytics 
set y2tics 
set grid ytics y2tics
set ylabel "Watt"
set y2label "Watt"
set yrange [0:10000]
set y2range [0:25000]

#FileLog_Elektrische_Daten_WR_5877_Haus_Garage_Suedwest 4:GoodWe_Garage_Haus_West_5877.PV_2_Power\x3a::
