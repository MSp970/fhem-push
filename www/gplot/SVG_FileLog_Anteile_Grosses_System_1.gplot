# Created by FHEM/98_SVG.pm, 2026-07-27 18:53:22
set terminal png transparent size <SIZE> crop
set output '<OUT>.png'
set xdata time
set timefmt "%Y-%m-%d_%H:%M:%S"
set xlabel " "
set title 'Anteile PV/Batterie/EVU – Großes System'
set ytics 
set y2tics 
set grid
set ylabel "%"
set y2label "Temperature"
set yrange 0:100

#FileLog_Anteile_Grosses_System 4:HA_SDM630M_Nergie.0PV_Anteil_proz\x3a::
#FileLog_Anteile_Grosses_System 4:HA_SDM630M_Nergie.0Batterie_Anteil_proz\x3a::
#FileLog_Anteile_Grosses_System 4:HA_SDM630M_Nergie.0Netz_Anteil_proz\x3a::

plot "<IN>" using 1:2 axes x1y1 title 'PV Anteil %' ls l0 lw 1 with lines, "<IN>" using 1:2 axes x1y1 title 'Batterie Anteil %' ls l1 lw 1 with lines, "<IN>" using 1:2 axes x1y1 title 'EVU Anteil %' ls l2 lw 1 with lines
