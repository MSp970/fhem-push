set terminal png transparent size <SIZE> crop
set output '<OUT>.png'
set xdata time
set timefmt "%Y-%m-%d_%H:%M:%S"
set xlabel " "
set title 'DC Werte A9 PV'
set ytics 
set y2tics 
set grid
set ylabel "Ampere"
set y2label "Volt"
set yrange [0:16]
set y2range [0:1000]

#FileLog_Elektrische_Daten_WR_5877_Haus_Garage_Suedwest 4:GoodWe_Garage_Haus_West_5877.PV_1_Voltage\x3a::
#FileLog_Elektrische_Daten_WR_5877_Haus_Garage_Suedwest 4:GoodWe_Garage_Haus_West_5877.PV_1_Current\x3a::
#FileLog_Elektrische_Daten_WR_5876_Haus_Ost_Mitte :
#FileLog_Elektrische_Daten_WR_5876_Haus_Ost_Mitte :
#FileLog_Elektrische_Daten_WR_5877_Haus_Garage_Suedwest 4:GoodWe_Garage_Haus_West_5877.*::
#FileLog_Elektrische_Daten_WR_5877_Haus_Garage_Suedwest 4:GoodWe_Garage_Haus_West_5877.*::
#FileLog_Elektrische_Daten_WR_5876_Haus_Ost_Mitte :
#FileLog_Elektrische_Daten_WR_5876_Haus_Ost_Mitte :

plot "<IN>" using 1:2 axes x1y2 title 'DC Voltage Garage Sued' ls l0 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y1 title 'DC Current Garage Sued' ls l1 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'DC Voltage Haus Sued' ls l2 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y1 title 'DC Current Haus Sued' ls l3 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'DC Voltage Garage Nord' ls l4 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y1 title 'DC Current Garage Nord' ls l5 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'DC Voltage Haus Nord' ls l6 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y1 title 'DC Current Haus Nord' ls l7 lw 1 with lines
