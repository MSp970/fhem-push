# Created by FHEM/98_SVG.pm, 2026-07-28 07:40:00
set terminal png transparent size <SIZE> crop
set output '<OUT>.png'
set xdata time
set timefmt "%Y-%m-%d_%H:%M:%S"
set xlabel " "
set title 'Anteile PV/Batterie/EVU – Monats- und Jahreswerte – Großes System'
set ytics
set y2tics
set grid
set ylabel "%"
set y2label "Temperature"
set yrange 0:100

#FileLog_Anteile_Monat_Jahr_Grosses_System 4:HA_SDM630M_Nergie.PV_Anteil_proz_MonatAvg_Last\x3a::
#FileLog_Anteile_Monat_Jahr_Grosses_System 4:HA_SDM630M_Nergie.Batterie_Anteil_proz_MonatAvg_Last\x3a::
#FileLog_Anteile_Monat_Jahr_Grosses_System 4:HA_SDM630M_Nergie.Netz_Anteil_proz_MonatAvg_Last\x3a::
#FileLog_Anteile_Monat_Jahr_Grosses_System 4:HA_SDM630M_Nergie.PV_Anteil_proz_JahrAvg_Last\x3a::
#FileLog_Anteile_Monat_Jahr_Grosses_System 4:HA_SDM630M_Nergie.Batterie_Anteil_proz_JahrAvg_Last\x3a::
#FileLog_Anteile_Monat_Jahr_Grosses_System 4:HA_SDM630M_Nergie.Netz_Anteil_proz_JahrAvg_Last\x3a::

plot "<IN>" using 1:2 axes x1y1 title 'PV Anteil Monat %' ls l1 lw 1 with bars, "<IN>" using 1:2 axes x1y1 title 'Batterie Anteil Monat %' ls l2 lw 1 with bars, "<IN>" using 1:2 axes x1y1 title 'EVU Anteil Monat %' ls l0 lw 1 with bars, "<IN>" using 1:2 axes x1y1 title 'PV Anteil Jahr %' ls l1dot lw 1 with bars, "<IN>" using 1:2 axes x1y1 title 'Batterie Anteil Jahr %' ls l2dot lw 1 with bars, "<IN>" using 1:2 axes x1y1 title 'EVU Anteil Jahr %' ls l0dot lw 1 with bars
