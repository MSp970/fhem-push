set terminal png transparent size <SIZE> crop
set output '<OUT>.png'
set xdata time
set timefmt "%Y-%m-%d_%H:%M:%S"
set xlabel " "
set title '<TL>'
set ytics 
set y2tics 
set grid
set ylabel "Humidity"
set y2label "Temperature"

#FileLog_WP_control 4:Erkennung_BW_auf_Heizkreis_umschalten_WP.*::

plot "<IN>" using 1:2 axes x1y2 title 'Line 1' ls l0 lw 1 with lines
