set terminal png transparent size <SIZE> crop
set output '<OUT>.png'
set xdata time
set timefmt "%Y-%m-%d_%H:%M:%S"
set xlabel " "
set title 'Batteriespeicher'
set ytics 
set y2tics 
set grid
set ylabel "Percent"
set y2label "Power und Co"

#FileLog_Batteriespeicher 4:GoodWe_Haus_Ost_Mitte_5876.SOC\x3a::

plot "<IN>" using 1:2 axes x1y1 title '10 kWh SOC_%' ls l0 lw 1 with lines
