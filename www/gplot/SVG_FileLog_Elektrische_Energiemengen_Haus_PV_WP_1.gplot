set terminal png transparent size <SIZE> crop
set output '<OUT>.png'
set xdata time
set timefmt "%Y-%m-%d_%H:%M:%S"
set xlabel " "
set title 'Energie'
set ytics 
set y2tics 
set grid ytics y2tics
set ylabel "kWh"
set y2label "kWh"

#FileLog_Elektrische_Energiemengen_Haus_PV_WP 4:HA_SDM630M_Haus.statEnergy_import__kWhDay1\x3a::
