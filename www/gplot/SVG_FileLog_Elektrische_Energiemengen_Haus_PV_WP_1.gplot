#FileLog_Elektrische_Energiemengen_Haus_PV_WP 4:HA_SDM630M_Heatpump.statEnergy_import__kWhDay1\x3a::

plot "<IN>" using 1:2 axes x1y2 title 'Haus Bezug' ls l0 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'N-Ergie Einsp' ls l1 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'N-Ergie Bezug' ls l2 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'WP Bezug' ls l3 lw 1 with lines
