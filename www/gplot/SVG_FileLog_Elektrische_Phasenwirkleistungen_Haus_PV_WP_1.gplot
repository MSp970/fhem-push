# Created by FHEM/98_SVG.pm, 2025-03-31 08:33:59
set terminal png transparent size <SIZE> crop
set output '<OUT>.png'
set xdata time
set timefmt "%Y-%m-%d_%H:%M:%S"
set xlabel " "
set title 'Elektrische Phasenwirkleistungen'
set ytics 
set y2tics 
set grid
set ylabel "Watt"
set y2label "Watt"

#FileLog_Elektrische_Wirkleistungen_Haus_PV_WP 4:HA_SDM630M_Haus.*::
#FileLog_Elektrische_Wirkleistungen_Haus_PV_WP 4:HA_SDM630M_Haus.Power_L2__W\x3a::
#FileLog_Elektrische_Wirkleistungen_Haus_PV_WP 4:Mythz.sTimedate\x3a::
#FileLog_Elektrische_Wirkleistungen_Haus_PV_WP 4:HA_SDM630M_PV_Erzeugung.Power_L1__W\x3a::
#FileLog_Elektrische_Wirkleistungen_Haus_PV_WP 4:HA_SDM630M_PV_Erzeugung.Power_L2__W\x3a::
#FileLog_Elektrische_Wirkleistungen_Haus_PV_WP 4:HA_SDM630M_PV_Erzeugung.Power_L3__W\x3a::

plot "<IN>" using 1:2 axes x1y2 title 'Haus L1' ls l0 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'Haus L2' ls l1 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'Haus L3' ls l2 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'PV L1' ls l3 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'PV L2' ls l4 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'PV L3' ls l0 lw 1 with lines
