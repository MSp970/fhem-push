# Created by FHEM/98_SVG.pm, 2025-04-30 07:01:57
set terminal png transparent size <SIZE> crop
set output '<OUT>.png'
set xdata time
set timefmt "%Y-%m-%d_%H:%M:%S"
set xlabel " "
set title 'Saldierende Bezugs- und Einspeiseleistungen'
set ytics 
set y2tics 
set grid
set ylabel "Watt"
set y2label "Watt"

#FileLog_Elektrische_Wirkleistungen_Haus_PV_WP 4:HA_SDM630M_Nergie.Bezugsleistung\x3a::
#FileLog_Elektrische_Wirkleistungen_Haus_PV_WP 4:HA_SDM630M_Nergie.Einspeiseleistung\x3a::

plot "<IN>" using 1:2 axes x1y2 title 'Bezugsleistung' ls l0 lw 1.5 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'Einspeiseleistung' ls l1 lw 1.5 with lines
