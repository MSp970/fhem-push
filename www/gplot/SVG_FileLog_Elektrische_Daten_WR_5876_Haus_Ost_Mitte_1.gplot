set terminal png transparent size <SIZE> crop
set output '<OUT>.png'
set xdata time
set timefmt "%Y-%m-%d_%H:%M:%S"
set xlabel " "
set title '<TL>'
set ytics 
set y2tics 
set grid
set ylabel "Humidity"
set y2label "Temperature"

#FileLog_Elektrische_Daten_WR_5876_Haus_Ost_Mitte 4:GoodWe_Haus_Ost_Mitte_5876.PV_1_Voltage\x3a::
#FileLog_Elektrische_Daten_WR_5876_Haus_Ost_Mitte 4:GoodWe_Haus_Ost_Mitte_5876.PV_1_Current\x3a::

plot "<IN>" using 1:2 axes x1y1 title 'DC Voltage Süd' ls l0 lw 1 with lines,\
     "<IN>" using 1:2 axes x1y2 title 'DC Current Süd' ls l1 lw 1 with lines
